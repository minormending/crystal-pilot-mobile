#!/usr/bin/env python3
"""Ask the cartridge what a road wants, without running it.

Every gate in Gen 2 is a script reading one bit of `wEventFlags`, and the
answer to *why does this road turn me back?* is therefore in the ROM. The
forty-second pass worked one out by hand -- dump the bytes, decode enough of
the command set from the label names, decode the text with the app's own
character table, then search the whole file for the instruction that sets the
bit and ask the symbol file whose script it landed in. Four steps, an hour, and
the same four steps next time.

So it is a tool.

    tools/rom-events --set 0x2d
        which script sets this event -- the step that turns a reading into a
        fact. Coincidental byte matches are named too; the symbol file is what
        tells them from scripts.

    Routing and reachability live in `tools/route`, which runs the app's own
    `gen2/world.js` rather than a second reader. A Python copy of that
    traversal was written here first and diverged immediately -- it reported
    Cherrygrove City as "not a map this cartridge has", because the obvious way
    to derive a group's size does not work for every group and the app's
    version is deliberately permissive where it cannot tell. Four divergences
    in two passes, three of them constants: the reader that matters is the
    app's.

    tools/rom-events --layout
        whether the event block's strides are this cartridge's own, asked of
        the cartridge rather than of another file that also wrote them down

    tools/rom-events --gyms
        every gym a title declares, against the cartridge: who stands on the
        leader's tile, whether that object is one you talk to, and whether the
        badge bit is a badge

    tools/rom-events --verify
        check the object layout against all 388 maps: the type field and the
        script's own name have to agree about which objects are trainers

    tools/rom-events --find SWITCH
        every place the cartridge writes a phrase, by nearest symbol. The step
        that unlocked the forty-eighth pass, which was done by hand: encode
        the word in the cartridge's own alphabet, search the file, and ask the
        symbol table whose data the bytes landed in. It answered "which order
        does the battle party menu list its options in?" in one command --
        `MonMenuOptionStrings` begins STATS, `BattleMonMenu` begins SWITCH,
        and they are opposite.

    tools/rom-events --phrases
        every phrase the app matches against the screen, against the cartridge
        that says them. A phrase that is not in the ROM never matches and
        nothing says so -- for `boxed` that is a successful catch reported as
        a getaway, which is the outcome the branch exists to prevent.

    tools/rom-events --menus
        every box the app tells apart by shape, against the cartridge's own
        menu header -- and the boxes that *share* a signature, which is the
        hazard the app cannot see for itself

    tools/rom-events --objects AzaleaGym
        the map's warps and objects, with each object's script named -- which
        is where a gym leader stands, answered without a running game

    tools/rom-events --map Route32
        every event this map's scripts ask about, and who sets each -- which
        is how a gate is found without decoding a whole scene

    tools/rom-events --script Route32CooltrainerMContinueScene
        the bytes, with the branches and the text pointers resolved to names.
        Stops when the command table runs out, which real scenes reach fast:
        use --map for those.

    tools/rom-events --text Route32CooltrainerMText_AideIsWaiting
        what it says, in the game's own words

    tools/rom-events --gates
        every gate the titles declare, checked against the ROM: the event it
        names, and which script sets it

Needs a ROM and a symbol file in `dev/`, which are not in this repository and
never will be. Without them it says so and exits 0 -- the same way the move
table's check skips itself, because a tool that fails a clean checkout is a
tool somebody removes from CI.
"""
import bisect
import json
import os
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
DEV = ROOT / 'dev'
sys.path.insert(0, str(ROOT / 'tools'))
# Shared with `tools/check-app`, for the reason `counts.py` is shared with
# `tools/renumber`: two readers of one directory that disagreed about which
# cartridge is current would be worse than either.
import cartridge  # noqa: E402

# Enough of the script command set to read a gate, and every one of these was
# derived from the symbol file rather than looked up -- the derivation is in
# docs/CODE.md. `Route32Noop1Scene` is one byte, `91`, which gives `end`; a
# `dw` landing on a `.Text` symbol gives `writetext`; a branch onto
# `.DontHaveZephyrBadge` gives the `iffalse` before it.
#
# (byte, name, argument shape) where the shape is a string of:
#   b = one byte    w = a two-byte pointer, resolved to a label
#   e = a two-byte event id
COMMANDS = {
    0x00: ('scall', 'w'),
    0x03: ('jump', 'w'),
    0x06: ('ifequal', 'bw'),
    0x08: ('iffalse', 'w'),
    0x09: ('iftrue', 'w'),
    0x1c: ('readvar', 'b'),
    0x31: ('checkevent', 'e'),
    0x32: ('clearevent', 'e'),
    0x33: ('setevent', 'e'),
    0x34: ('checkflag', 'e'),
    0x47: ('opentext', ''),
    0x49: ('closetext', ''),
    0x4c: ('writetext', 'w'),
    0x4e: ('yesorno', ''),
    0x54: ('waitbutton', ''),
    0x6b: ('faceplayer', ''),
    0x6e: ('disappear', 'b'),
    0x6f: ('appear', 'b'),
    0x90: ('endcallback', ''),
    0x91: ('end', ''),
}
SETEVENT = 0x33

# The game's own encoding, as far as a line of dialogue uses it. The letter and
# digit ranges are the same ones `gen2/romdata.js` decodes names with; the
# control bytes are the ones that only turn up in text.
PUNCT = {0xe0: "'", 0xe3: '-', 0xe6: '?', 0xe7: '!', 0xe8: '.', 0xe9: '&',
         0xea: 'e', 0xef: '♂', 0xf1: 'x', 0xf3: '/', 0xf4: ',',
         0xf5: '♀'}
TERMINATOR, LIGATURE, SPACE = 0x50, 0x54, 0x7f
BREAKS = {0x1f, 0x4e, 0x4f, 0x51, 0x55}
STOPS = {0x57: '<done>', 0x58: '<prompt>'}


def offset(bank, addr):
    """Where a banked address lives in the file."""
    return bank * 0x4000 + (addr - 0x4000)


class Cart:
    def __init__(self, rom, sym, rom_path=None, sym_path=None):
        self.rom = rom
        # Where they came from, so a check that needs the app's own answer
        # can hand the same two files to node -- see `profile_words`.
        self.rom_path, self.sym_path = rom_path, sym_path
        self.by_name = {}
        self.at = []                       # [(file offset, name)], sorted
        for line in sym.splitlines():
            head, _, name = line.partition(' ')
            bank, _, addr = head.partition(':')
            name = name.strip()
            try:
                bank, addr = int(bank, 16), int(addr, 16)
            except ValueError:
                continue
            if addr < 0x4000:              # RAM, not a script
                self.by_name.setdefault(name, (bank, addr))
                continue
            off = offset(bank, addr)
            self.by_name.setdefault(name, (bank, addr))
            self.at.append((off, name))
        self.at.sort()
        self.offs = [o for o, _ in self.at]

    # How far past a symbol a byte can be and still be described by it. A
    # branch target inside a script is usually an unnamed local a few bytes in;
    # something two hundred bytes past the last symbol is not *in* that symbol,
    # and saying so was actively misleading -- the first survey of a real scene
    # reported a `scall` landing in `EcruteakCityLass2Text_ReleasedBeasts+13`,
    # which is a text string in the same bank and nothing to do with it.
    NEAR = 64

    def label(self, off, bound=None):
        """The nearest symbol at or before a file offset, with the distance.

        `bound` is how far past a symbol still counts as inside it; the default
        is generous for a script and honest about a pointer.
        """
        i = bisect.bisect_right(self.offs, off) - 1
        if i < 0:
            return f'${off:06x}'
        name, base = self.at[i][1], self.offs[i]
        if base == off:
            return name
        if (bound if bound is not None else self.NEAR) < off - base:
            return f'${off:06x}'
        return f'{name}+{off - base}'

    def near(self, bank, addr):
        """A label for a pointer inside a bank, for resolving a branch."""
        return self.label(offset(bank, addr))

    def text(self, bank, addr, limit=300):
        out = []
        for byte in self.rom[offset(bank, addr):offset(bank, addr) + limit]:
            if byte == TERMINATOR:
                break
            if byte in STOPS:
                out.append('\n' + STOPS[byte])
                break
            if byte == LIGATURE:
                out.append('POKé')
            elif byte == SPACE:
                out.append(' ')
            elif byte in BREAKS:
                out.append('\n')
            elif byte in PUNCT:
                out.append(PUNCT[byte])
            elif 0x80 <= byte <= 0x99:
                out.append(chr(65 + byte - 0x80))
            elif 0xa0 <= byte <= 0xb9:
                out.append(chr(97 + byte - 0xa0))
            elif 0xf6 <= byte <= 0xff:
                out.append(chr(48 + byte - 0xf6))
            else:
                out.append(f'<{byte:02x}>')
        return ''.join(out)

    def script(self, name, limit=120):
        """One script, decoded as far as the command table reaches."""
        if name not in self.by_name:
            return [f'{name}: not in the symbol file']
        bank, addr = self.by_name[name]
        out, here, unknown = [], addr, 0
        while here < addr + limit:
            byte = self.rom[offset(bank, here)]
            cmd = COMMANDS.get(byte)
            label = self.near(bank, here)
            tag = f'  {here:04x}  ' + (f'{label:44}' if label != name else ' ' * 44)
            if not cmd:
                out.append(f'{tag}{byte:02x}  ?')
                unknown += 1
                here += 1
                # Three unknowns in a row is the table running out rather than
                # one odd byte, and reading on past that is inventing things.
                if unknown >= 3:
                    out.append('        ... command table ends here')
                    break
                continue
            unknown = 0
            word, args, at = cmd[0], [], here + 1
            for shape in cmd[1]:
                if shape == 'b':
                    args.append(f'${self.rom[offset(bank, at)]:02x}')
                    at += 1
                else:
                    ptr = (self.rom[offset(bank, at)]
                           | self.rom[offset(bank, at + 1)] << 8)
                    args.append(f'${ptr:04x}' if shape == 'e'
                                else f'{self.near(bank, ptr)}')
                    at += 2
            out.append(f'{tag}{word} {" ".join(args)}'.rstrip())
            here = at
            if word in ('end', 'endcallback', 'jump'):
                break
        return out

    def setters(self, event):
        """Every place in the ROM that sets this event, named."""
        want = bytes([SETEVENT, event & 0xff, (event >> 8) & 0xff])
        hits, start = [], 0
        while True:
            found = self.rom.find(want, start)
            if found < 0:
                return hits
            hits.append((found, self.label(found)))
            start = found + 1


CHECKEVENT = 0x31

# A map's event block used to be laid out here, field by field, as its own
# reading of the cartridge. **It is gone, and this file asks the app.**
#
# The derivation was careful. Violet Gym's fourth field distinguished two
# objects from two others, matching the app's `objectTypes`; its ninth and
# tenth bytes resolved to `VioletGymFalknerScript`, `TrainerBirdKeeperRod`,
# `TrainerBirdKeeperAbe` and `VioletGymGuideScript`, four for four; and
# reading two fields as y+4 and x+4 put Falkner at (5,1) and Abe at (2,10),
# the two positions this repository had already measured out of work RAM a
# pass and a cartridge apart. Four independent agreements.
#
# It was still wrong twice. Coord events are eight bytes and it said five, so
# every map carrying one parsed into drift -- Cianwood City produced objects
# of "type 9" whose script pointers landed three bytes inside a trainer's
# `.AskNumber2` label, and the two maps the layout came from have no coord
# events, so they were the two it could not fail on. `check-app romlayout`
# was written to hold the copies to each other, and it did.
#
# And then a cartridge came along where **both** copies were right about
# themselves and one was right about the cartridge. Polished Crystal writes a
# five-byte coord event; Crystal writes eight; the check compared two files
# and saw them agree. Every gym in the hack came back with no leader on it.
#
# Two copies of a structure is the defect, and a check that they match is a
# repair for one half of it. The other half is that neither copy knows which
# cartridge it is looking at. So the strides live in the engine profile, one
# reader reads them, and this file asks that reader -- see `ask_route`.
# How far to look for a map. Bounds rather than counts: the cartridge has 26
# groups and no group has 64 maps, and asking about one that is not there
# answers nothing rather than failing -- which is the same permissiveness
# `gen2/world.js` is deliberately built with, for the reason a Python copy of
# its traversal learned the hard way.
MAP_GROUPS, MAPS_PER_GROUP = 26, 64

# What the app's object kinds are called, for printing. The numbers are
# `engine.objectTypes` and the app supplies them; these are the words.
# Anything past the three Crystal has -- Polished Crystal adds five, of which
# a *generic* trainer is the one that matters -- prints as its number, which
# is honest about a kind this file has no word for.
OBJ_KINDS = {0: 'script', 1: 'item ball', 2: 'trainer'}


def map_objects(cart, name):
    """A map's warps and objects, with their scripts named.

    Which answers the question a gym declaration asks -- *where does the
    leader stand?* -- without a running game. Better than without: the
    object's script pointer resolves to a symbol, so the leader is *named*
    rather than inferred from a position. `AzaleaGymBugsyScript` is not a
    heuristic.

    **Warps store their coordinates as-is; objects store them four higher.**
    Two conventions in one block, and checking rather than assuming is what
    caught it: New Bark's first warp reads (6,3) to map 24.5, which is exactly
    the `labDoor: [6, 3]` and `ELMS_LAB = key(24, 5)` this repository measured
    by hand a long time ago. Subtracting four there gives y = -1. The app's
    reader knows both conventions, which is now the only place either is
    written down.
    """
    warps, objects = map_warps(cart, name), route_objects().get(name)
    if objects is None and not warps:
        return [f'{name}: the app\u2019s reader has no such map']
    out = [f'{name}:']
    for i, w in enumerate(warps):
        out.append(f'  warp {i + 1}: ({w["x"]},{w["y"]}) '
                   f'to {w["to"] >> 8}.{w["to"] & 0xff}')
    for i, o in enumerate(objects or []):
        kind = OBJ_KINDS.get(o['type'], f'type {o["type"]}')
        bank, _, addr = o['script'].partition(':')
        out.append(f'  object {i + 1}: ({o["x"]},{o["y"]})'
                   f'  {kind:9}  sprite {o["sprite"]:3}  '
                   f'{cart.near(int(bank, 16), int(addr, 16))}')
    return out


def gym_objects(cart, name):
    """{script symbol: (x, y, kind)} for one map, for checking a declaration.

    The app reads the objects -- see `route_objects` -- and this names them.
    Naming is the half a running game cannot do and a symbol file can: an
    object at (5,2) is a person, and `VioletGymFalknerScript` is Falkner.
    """
    found = {}
    for o in route_objects().get(name, []):
        bank, _, addr = o['script'].partition(':')
        found[cart.near(int(bank, 16), int(addr, 16))] = (o['x'], o['y'],
                                                          o['type'])
    return found


def map_events(cart, name):
    """Every event a map's own scripts ask about, and who sets each.

    **The survey that does not need a decoder.** Deciding what a road wants
    means finding the event its blocker checks, and decoding a whole scene to
    get there is a losing game: the full command set is over a hundred
    instructions with a dozen argument shapes, and the first real scene this
    tool met used seven it did not know. Reading three bytes at a time does not
    need any of that.

    The region is exact rather than guessed. Every map in the game has both a
    `<Map>_MapScripts` and a `<Map>_MapEvents` symbol -- 388 of each -- and the
    scripts are laid out between them.

    False positives are possible, since `31 xx xx` also occurs in whatever data
    shares the region, and the cross-reference is what sorts them out: an event
    nothing sets is either a read of the game's own bookkeeping or a
    coincidence, and either way not a gate. That is the same shape of answer
    `--set` gives, and for the same reason.
    """
    first, last = f'{name}_MapScripts', f'{name}_MapEvents'
    if first not in cart.by_name or last not in cart.by_name:
        return [f'{name}: no _MapScripts/_MapEvents pair in the symbol file']
    start = offset(*cart.by_name[first])
    end = offset(*cart.by_name[last])
    if end <= start:
        return [f'{name}: its events come before its scripts, which cannot be read']
    out, seen = [f'{name}: {end - start} bytes of script'], {}
    for i in range(start, end - 2):
        if cart.rom[i] != CHECKEVENT:
            continue
        event = cart.rom[i + 1] | cart.rom[i + 2] << 8
        seen.setdefault(event, []).append(i)
    for event, wheres in sorted(seen.items()):
        setters = [n for _, n in cart.setters(event)
                   if not DATA_ISH.search(n)]
        out.append(f'  checkevent ${event:04x}  at {cart.label(wheres[0])}'
                   + (f' (+{len(wheres) - 1} more)' if len(wheres) > 1 else ''))
        for setter in setters[:4] or ['nothing sets it — bookkeeping, or a coincidence']:
            out.append(f'      set by {setter}')
    return out


def map_symbol(cart):
    """A lookup from (group, number) to the map's own name in the symbol file.

    A title declares its maps as `key(group, number)`, because that is what
    the game puts in work RAM; the symbol file knows them as `AzaleaGym_...`.
    The bridge is the attributes pointer, and following it means reading a
    map's row in `MapGroupPointers` -- nine bytes on Crystal with the
    attributes bank in front, seven on Polished Crystal with no bank at all.

    So this asks `tools/route --maps`, which runs the app's own reader with
    the profile the app would pick. It used to walk the table here, with the
    nine and the three written out; on a cartridge with seven-byte headers
    that produced a name for every map and the wrong one for all of them.
    """
    named = route_maps()
    return lambda key: named.get((key[0] << 8) | key[1])


def verify(cart):
    """Check the object layout against every map in the game.

    The rule: an object whose script symbol is named `Trainer...` is a trainer,
    and one that is not, is not. The cartridge says which in the low nibble of
    byte seven, and the names come from a different part of the file entirely
    -- so agreement across every map is two independent sources saying the same
    thing several thousand times.

    This is here because the first reading of that field was **wrong and looked
    right**: byte four is the type in Violet Gym, four objects for four, and is
    00 for all seven of Azalea Gym's, five of which are trainers. Two maps is
    not a sample.
    """
    maps = sorted(route_objects())
    # Which numbers mean *trainer*, out of the picked profile rather than out
    # of here: Crystal has one and Polished Crystal has two, the second being
    # the `OBJECTTYPE_GENERICTRAINER` most of its Gym trainers are.
    kinds = object_kinds(cart)
    # A kind is a number or a list of them -- see `kindsOf` in
    # `gen2/engine.js`, which is what the app asks. Polished Crystal's
    # `trainer` is `[2, 3]`.
    fights = set()
    for name, value in kinds.items():
        if 'rainer' not in name:
            continue
        fights.update(value if isinstance(value, list) else [value])
    fights = fights or {2}
    objects = disagree = 0
    for name in maps:
        for script, (_, _, kind) in gym_objects(cart, name).items():
            objects += 1
            # **A name rule, and it is the cartridge's naming and not a
            # standard.** Crystal calls a trainer's script `Trainer...`;
            # Polished Crystal calls most of them `GenericTrainer...`, so
            # `startswith('Trainer')` disagreed with the type field 479 times
            # in a game with 2108 objects on its maps -- which is not a
            # finding about the hack, it is this rule not knowing the word.
            named = script.startswith(('Trainer', 'GenericTrainer'))
            if named != (kind in fights):
                disagree += 1
                if disagree <= 10:
                    print(f'  {name}: {script} is type {kind}')
    print(f'{len(maps)} maps, {objects} objects, {disagree} disagreement(s) '
          f'between the type field and the script name '
          f'(a trainer is type {", ".join(str(f) for f in sorted(fights))})')
    # Reported, not failed. The name rule is a validator with real exceptions:
    # some trainers are *talked to* rather than seen, so `TrainerOfficerDirk`
    # is legitimately a script object, and the Trainer House's receptionist is
    # named `Trainer...` while being nobody to fight. Twelve of 1396 at the
    # time of writing, every one of them explicable. What the layout is held to
    # instead is `check-app romlayout`, which is binary and cannot drift.
    #
    # The count moved from 388 maps to 361 when this stopped listing
    # `<Map>_MapEvents` symbols and started asking the app which maps it can
    # read. Fewer maps, the same twelve disagreements: the symbols this no
    # longer counts are ones the map tables do not reach.
    return 0


# A map in a declaration is either a `const` by name or a `key(g, n)` written
# straight in. Crystal names all of its; a profile whose eight gyms came out
# of `--findgyms` in one paste has no reason to name sixteen maps once each,
# and `tools/route --reach` already reads both forms for the same reason.
MAP_REF = r'(\w+|key\(\d+,\s*\d+\))'
GYM = re.compile(r'\{\s*map:\s*' + MAP_REF + r',\s*inside:\s*' + MAP_REF
                 + r',\s*door:\s*\[(\d+),\s*(\d+)\],'
                 r'\s*\n?\s*leader:\s*[\'"](\w+)[\'"],\s*leaderAt:\s*\[(\d+),\s*(\d+)\],'
                 r'\s*badge:\s*(\d+)', re.S)
KEY = re.compile(r'const (\w+) = key\((\d+),\s*(\d+)\);')
INLINE_KEY = re.compile(r'key\((\d+),\s*(\d+)\)')
BADGE_FLAG_BYTES = 3


def badge_bits(cart):
    """{bit: engine flag} for the badge byte, out of the cartridge's own table.

    `EngineFlags` is three bytes an entry -- a two-byte address and a bitmask
    -- so the badges are the run of entries pointing at `wJohtoBadges`. The
    Zephyr Badge is bit 0 there, which is what this app measured on a real
    cartridge after beating Falkner, so the table and the measurement agree
    about the one case that could be checked both ways.
    """
    if 'EngineFlags' not in cart.by_name or 'wJohtoBadges' not in cart.by_name:
        return {}
    bank, addr = cart.by_name['EngineFlags']
    byte_at = cart.by_name['wJohtoBadges'][1]
    out = {}
    for i in range(0x100):
        e = offset(bank, addr) + i * BADGE_FLAG_BYTES
        if e + 2 >= len(cart.rom):
            break
        where = cart.rom[e] | cart.rom[e + 1] << 8
        mask = cart.rom[e + 2]
        if where == byte_at and mask and not (mask & (mask - 1)):
            out.setdefault(mask.bit_length() - 1, i)
    return out


# A menu header in pokecrystal: a flags byte, the box as `y1, x1, y2, x2`,
# a pointer to the menu data, and a default. The data begins with its own
# flags byte and then the item count, and the strings follow it.
#
# **The layout is derived, and it is derived against a measurement.** Read
# this way, `BattleMenuHeader` comes out as 34 items with its border at row
# 12 -- which is exactly what `gen2/engine.js` says after somebody measured it
# on a real cartridge, before any of this existed. A derivation that
# reproduces a measurement is worth more than either on its own, and it is the
# reason the *other* headers here can be trusted without a screen to look at.
MENU_HEADER_BYTES = 7
MENU_DATA_ITEMS = 1

# The boxes the app tells apart by shape, and what it calls each one. A box
# this app drives by a signature has to have that signature checked, because
# the failure is silent in both directions: a box mistaken for another is
# pressed with the wrong answer, and a box nothing matches is pressed on
# through.
APP_BOXES = [
    ('BattleMenuHeader', 'battleMenu', None),
    ('BattleMonMenu.MenuHeader', 'switchBox', 'SWITCH'),
]


def find_text(cart, phrase, limit=12):
    """Where in the ROM the cartridge writes this phrase, by nearest symbol.

    **The step that unlocked the forty-eighth pass, done by hand.** The
    question was which order the battle party menu's options come in, and the
    way to answer it was to encode "SWITCH" in the cartridge's own alphabet,
    search the file for those bytes, and ask the symbol table whose data they
    landed in. That took a throwaway script, which is the shape of thing this
    tool exists to stop being thrown away -- *what does the game call this,
    and where does it keep it* is a question every pass asks.

    Encoded rather than searched as ASCII, because Gen 2's alphabet is its
    own: A is $80, a is $a0, a space is $7f. `Cart.text` decodes; this is the
    other direction, and it is deliberately narrow -- letters, digits, spaces
    and a full stop -- because a phrase with a line break or a ligature in it
    is not a phrase you can search for as one run of bytes.
    """
    # **Case matters, and uppercasing was this tool's first bug.** Gen 2 gives
    # capitals and lower case separate blocks -- A is $80 and a is $a0 -- so
    # folding the query to upper case looks for bytes the cartridge does not
    # have there. "sent to BILL" came back "not in this ROM" while sitting in
    # it, which is exactly the confident wrong answer this file keeps warning
    # about, committed by a tool written to prevent it.
    out = bytearray()
    for ch in phrase:
        if 'A' <= ch <= 'Z':
            out.append(0x80 + ord(ch) - 65)
        elif 'a' <= ch <= 'z':
            out.append(0xa0 + ord(ch) - 97)
        elif '0' <= ch <= '9':
            out.append(0xf6 + ord(ch) - 48)
        elif ch == ' ':
            out.append(SPACE)
        elif ch == '.':
            out.append(0xe8)
        elif ch == 'é':
            out.append(0xea)
        else:
            return None, f'"{ch}" is not a byte this can search for'
    # **"POKéMON" is one byte in the ROM and seven on screen.** $54 is the
    # ligature, which the game expands to POKé when it prints -- so a phrase
    # the app matches against the *tilemap* is written in the ROM with a byte
    # that is not in it. Both forms are searched, which is the honest way to
    # answer "does the cartridge say this": it does, in the only place it
    # could.
    forms = [bytes(out)]
    poke = bytes([0x8f, 0x8e, 0x8a, 0xea])          # P O K é
    if poke in forms[0]:
        forms.append(forms[0].replace(poke, bytes([LIGATURE])))
    hits = []
    for form in forms:
        at = cart.rom.find(form)
        while at >= 0 and len(hits) < limit:
            hits.append(at)
            at = cart.rom.find(form, at + 1)
        if hits:
            break
    return hits, None


def where(cart, phrase):
    """Print every place the cartridge writes a phrase, with its label."""
    hits, why = find_text(cart, phrase)
    if hits is None:
        print(f'  {why}')
        return 1
    if not hits:
        print(f'  "{phrase}" is not in this ROM, in this alphabet')
        return 1
    print(f'"{phrase}": {len(hits)} place(s)')
    for off in hits:
        bank, addr = off // 0x4000, 0x4000 + off % 0x4000
        # A generous bound: a string is usually a long way past the symbol
        # that names the table it is in, which is exactly what the caller
        # wants to know -- "inside MonMenuOptionStrings" is the answer.
        print(f'  {bank:02x}:{addr:04x}  {cart.label(off, bound=4096)}')
    return 0


def picked_titles(cart):
    """The `titles/*.js` this cartridge would actually be driven by.

    Every check that reads a profile's declarations used to read *all* of
    them, which asks one cartridge whether another hack's gyms are where
    that hack says. Pointed at Polished Crystal, the gym check reported
    Crystal's Goldenrod and Ecruteak missing -- true, and not a fault of
    either cartridge.

    Falls back to every profile when the app cannot be asked, because a
    check that silently stops checking is worse than one that over-checks.
    """
    if not cart.rom_path:
        return sorted((ROOT / 'titles').glob('*.js'))
    script = (
        "import('%s/tools/cartridge.mjs').then(async (c) => {"
        "  const cart = c.openCartridge('%s/dev');"
        "  const { title } = c.engineOf(cart);"
        "  process.stdout.write('\\n@@' + (title ? title.id : ''));"
        "});" % (ROOT, ROOT)
    )
    env = dict(os.environ, DEV_ROM=str(cart.rom_path), DEV_SYM=str(cart.sym_path))
    try:
        got = subprocess.run(['node', '-e', script], capture_output=True,
                             text=True, timeout=60, env=env)
        line = [l for l in got.stdout.splitlines() if l.startswith('@@')]
        which = line[-1][2:].strip() if line else ''
    except Exception:
        which = ''
    one = ROOT / 'titles' / f'{which}.js'
    return [one] if which and one.exists() else \
        sorted((ROOT / 'titles').glob('*.js'))


def ask_engine(cart, *fields):
    """One or more fields of the picked engine profile, as JSON.

    The same asking `profile_words` does, generalised -- `pickTitle` decides
    which profile a ROM gets and the app is the only thing that knows.
    """
    if not cart.rom_path:
        return None
    script = (
        "import('%s/tools/cartridge.mjs').then(async (c) => {"
        "  const cart = c.openCartridge('%s/dev');"
        "  const { engine } = c.engineOf(cart);"
        "  const want = %s;"
        "  const out = {};"
        "  for (const f of want) out[f] = engine[f];"
        "  process.stdout.write('\\n@@' + JSON.stringify(out));"
        "});" % (ROOT, ROOT, json.dumps(list(fields)))
    )
    env = dict(os.environ, DEV_ROM=str(cart.rom_path), DEV_SYM=str(cart.sym_path))
    try:
        got = subprocess.run(['node', '-e', script], capture_output=True,
                             text=True, timeout=60, env=env)
        line = [l for l in got.stdout.splitlines() if l.startswith('@@')]
        found = json.loads(line[-1][2:]) if line else {}
    except Exception:
        return None
    return found[fields[0]] if len(fields) == 1 else found


def profile_words(cart):
    """The words the profile *this* cartridge would be driven by looks for.

    Asked of the app rather than guessed at: `pickTitle` decides which
    profile a ROM gets, and reading every `titles/*.js` and taking the union
    would pass a cartridge whose word is in some other hack's profile.

    A row passes if *any* of its words is in this ROM, because that is what
    `_driveToSaying` asks -- Polished Crystal's start menu says Bag where
    Crystal's says PACK, and a cartridge only ever says one of them.
    """
    if not cart.rom_path:
        return []
    script = (
        "import('%s/tools/cartridge.mjs').then(async (c) => {"
        "  const cart = c.openCartridge('%s/dev');"
        "  const { title, engine } = c.engineOf(cart);"
        "  process.stdout.write('\\n@@' + JSON.stringify({"
        "    menuWords: engine.menuWords,"
        "    boxed: title && title.phrases && title.phrases.boxed }));"
        "});" % (ROOT, ROOT)
    )
    env = dict(os.environ, DEV_ROM=str(cart.rom_path), DEV_SYM=str(cart.sym_path))
    try:
        got = subprocess.run(['node', '-e', script], capture_output=True,
                             text=True, timeout=60, env=env)
        line = [l for l in got.stdout.splitlines() if l.startswith('@@')]
        found = json.loads(line[-1][2:]) if line else {}
    except Exception:
        return []
    out = [(v, 'the engine profile', f'the {k} menu row')
           for k, v in (found.get('menuWords') or {}).items() if v]
    # And the title's word for a catch that went to the box, from the same
    # picked profile. Read out of `titles/crystal.js` by name before, which
    # asked every cartridge whether it says Crystal's sentence.
    if found.get('boxed'):
        out.append((found['boxed'], 'the title profile', 'a boxed catch'))
    return out


def stores_text_plainly(cart):
    """Whether this cartridge keeps its text as charmap bytes at all.

    **Measured structurally, not in English.** The first version of this
    looked for "was", "the " and "you" -- which is the language-bound mistake
    this repository has already made once, and the Dutch build has 37 of
    "the " against Crystal's 1260 while storing its text perfectly plainly.
    What is true in any language is that plain text leaves long runs of
    letter bytes in the ROM.

    Measured across five cartridges: Crystal 13180, pokecrystal16 13161, the
    Dutch build 14798, PokemonAmbrosia 23182 -- and Polished Crystal **174**,
    because `macros/scripts/text.asm` compresses a string whenever
    compression saves space. The bound is a hundredth of the smallest of
    those and five times the largest compressed one, which is as much
    daylight as a threshold ever gets.
    """
    if getattr(cart, '_plain', None) is None:
        found, run = 0, 0
        for b in cart.rom:
            if 0xa0 <= b <= 0xb9 or b == SPACE:
                run += 1
            else:
                if run >= 10:
                    found += 1
                run = 0
        cart._plain = found >= 1000
    return cart._plain


def app_phrases(cart):
    """Every phrase the app matches against the screen, out of the source.

    Three kinds, and all three are words the *game* says: the title's `boxed`
    phrase, which is how a catch that went to the box is told from a getaway;
    and the words `_driveToSaying` walks a menu looking for.

    Read from the source rather than listed here, for the reason every other
    number in these tools is: a list of literals maintained by hand beside the
    literals themselves is the thing that goes stale.
    """
    out = list(profile_words(cart))
    menus = (ROOT / 'gen2' / 'menus.js').read_text()
    for m in re.finditer(r"_driveToSaying\('([^']+)'", menus):
        out.append((m.group(1), 'gen2/menus.js', 'a menu row it drives to'))
    # And the ones passed as a named constant, which is how two of them are
    # written -- so the first draft of this scan reported three phrases while
    # five were being looked for. A scan that finds a subset of what it
    # describes is the failure this whole file keeps warning about.
    # Any `NAME = 'text'`, which covers both a `const` of its own and the
    # second half of `const A = 'x', B = 'y';` -- the form two of these are
    # actually written in.
    consts = {}
    for m in re.finditer(r"(\w+)\s*=\s*'([^']*)'", menus):
        consts.setdefault(m.group(1), m.group(2))
    for m in re.finditer(r"_driveToSaying\((\w+)\)", menus):
        text = consts.get(m.group(1))
        if text:
            out.append((text, 'gen2/menus.js', 'a menu row it drives to'))
    return out


def phrases(cart):
    """Every phrase the app looks for, against the cartridge that says them.

    **A phrase that is not in the ROM never matches, and nothing says so.**
    The screen is read as tiles and compared as folded text, so a typo does
    not fail -- it just never fires, and the feature resting on it quietly
    stops working. For `boxed` that means a *successful* catch reported as a
    getaway, which is the outcome the branch was written to prevent.

    Case matters here in a way it does not in the app: Gen 2 gives capitals
    and lower case separate blocks, so this searches for exactly what was
    written down. The app folds case when it compares, so a phrase that is
    right apart from its case still works -- and is still worth reporting,
    because it means nobody checked.
    """
    bad = 0
    for phrase, where_, why in app_phrases(cart):
        # A list is a row the app will accept several words for, and one of
        # them being in the ROM is the whole requirement.
        choices = phrase if isinstance(phrase, list) else [phrase]
        found, unreadable = None, None
        for one in choices:
            hits, note = find_text(cart, one)
            if hits is None:
                unreadable = note
            elif hits:
                found = (one, hits)
                break
        shown = ' / '.join(f'"{c}"' for c in choices)
        if found:
            one, hits = found
            print(f'  "{one}" — {cart.label(hits[0], bound=4096)}'
                  f'{"" if len(hits) == 1 else f" and {len(hits) - 1} more"}')
        elif unreadable and len(choices) == 1:
            print(f'  ??  {where_}  {shown}: {unreadable}')
            bad += 1
        elif not stores_text_plainly(cart):
            # **Not every cartridge keeps its dialogue as charmap bytes.**
            # Polished Crystal compresses it, so "was" is nowhere in that ROM
            # while being on half its screens. The app matches the *tilemap*,
            # decompressed by then, so the phrase may be perfectly findable
            # at run time -- and "not in this ROM" would be a confident wrong
            # answer about a phrase that works.
            print(f'  note  {where_}  {shown}: this cartridge does not '
                  f'store its text as plain bytes, so this cannot be looked '
                  f'up here — the app matches the screen, which is '
                  f'decompressed by then')
        else:
            print(f'  !!  {where_}  {shown} is not in this ROM — '
                  f'{why} will never be recognised')
            bad += 1
    return bad


def menu_header(cart, name):
    """`{items, top, first}` for a named menu header, or None."""
    if name not in cart.by_name:
        return None
    bank, addr = cart.by_name[name]
    off = offset(bank, addr)
    head = cart.rom[off:off + MENU_HEADER_BYTES]
    if len(head) < MENU_HEADER_BYTES:
        return None
    top, ptr = head[1], head[5] | head[6] << 8
    data = offset(bank, ptr)
    items = cart.rom[data + MENU_DATA_ITEMS]
    # The strings run one after another behind the count, each ended by "@",
    # and `Cart.text` already knows the cartridge's alphabet -- so the first
    # option's name is read with the same decoder every other string in this
    # tool goes through rather than a second one written here.
    first = cart.text(bank, ptr + MENU_DATA_ITEMS + 1, limit=12)
    return {'items': items, 'top': top, 'first': first}


def menus(cart):
    """Every box the app drives by shape, against the cartridge's own header.

    The one that could not be guessed is the switch box. The *field* party
    menu's options begin STATS, SWITCH; the *battle* one begins SWITCH,
    STATS -- so the press that switches a Pokemon in during a fight opens its
    stats out in the world, and assuming the order seen more often costs a
    turn to a stats screen while a trainer takes its own.
    """
    want = app_numbers()
    bad = 0
    for name, field, first in APP_BOXES:
        got = menu_header(cart, name)
        if not got:
            # **A cartridge that does not name this menu cannot be asked.**
            # The app drives a box by its *shape* -- how many rows, where the
            # top one is -- and this check holds that shape to the
            # cartridge's own header. Polished Crystal has no
            # `BattleMenuHeader`; its battle menu is built somewhere else
            # under another name. The shape is then unverified, which is
            # worth saying and is not the same as wrong.
            print(f'  note  {name} is not in this symbol file, so the shape '
                  f'the app declares for it is unchecked here')
            continue
        mine = want.get(field, {})
        # The first option's name is only printed where it is also checked.
        # `BattleMenuHeader`'s data points at a separate `.Text` table rather
        # than carrying its strings inline, so reading them at the same
        # offset gives bytes that are not text -- and printing those as
        # though they were is how a tool teaches somebody something false.
        line = (f'  {field}: {got["items"]} item(s), border row {got["top"]}'
                + (f', first "{got["first"]}"' if first else ''))
        for key in ('items', 'top'):
            if key in mine and mine[key] != got[key]:
                print(f'  !!  {field}.{key} says {mine[key]}, '
                      f'{name} has {got[key]}')
                bad += 1
        if first and got['first'] != first:
            print(f'  !!  {field} expects "{first}" first, '
                  f'{name} begins "{got["first"]}"')
            bad += 1
        print(line + ('' if bad else '  — and the app agrees'))
    return bad


def collisions(cart):
    """Named menu headers that share a signature with one the app declares.

    **The hazard the app cannot see for itself.** Every box here is told apart
    by `items` and the border row, so two boxes with the same pair are two
    boxes a snapshot cannot distinguish -- and `engine.js` already documents
    three of those, found the hard way: `learnMove` and the battle pack's
    USE/QUIT are both two items at row 7, and the pack mid-throw is two at
    row 0. Which of them is on screen can only come from *when* it was asked,
    which is a claim the callers have to keep.

    So this lists them rather than failing on them. A collision is not a bug;
    an *unknown* collision is, and the list is the difference.
    """
    want = app_numbers()
    mine = {(v.get('items'), v.get('top')): k for k, v in want.items()
            if 'items' in v and 'top' in v}
    named = [n for n in cart.by_name
             if n.endswith('MenuHeader') or n.endswith('.MenuHeader')]
    out = {}
    for name in sorted(named):
        got = menu_header(cart, name)
        if not got:
            continue
        key = (got['items'], got['top'])
        if key in mine:
            out.setdefault(mine[key], []).append(name)
    return out


def unique_left(cart, want=2):
    """Which named menu headers put their box's left edge at `want`.

    The Bug Contest's battle menu shares `battleMenu`'s two numbers exactly,
    so the app tells it apart by this third one -- and acting on a third
    number is only safe while that number is *unique*. It is: one header out
    of 73 on this cartridge. If a future build adds a second, this says so
    before the pilot starts refusing battles it could have fought.
    """
    out = []
    for name in sorted(cart.by_name):
        if not (name.endswith('MenuHeader') or name.endswith('.MenuHeader')):
            continue
        bank, addr = cart.by_name[name]
        head = cart.rom[offset(bank, addr):offset(bank, addr) + MENU_HEADER_BYTES]
        if len(head) == MENU_HEADER_BYTES and head[2] == want:
            out.append(name)
    return out


def app_others():
    """The battle menus the app says are *not* its own, out of the source."""
    src = (ROOT / 'gen2' / 'engine.js').read_text()
    m = re.search(r'otherBattles:\s*\[(.*?)\]', src, re.S)
    if not m:
        return []
    return [{'left': int(left), 'what': what}
            for left, what in re.findall(r"left:\s*(\d+),\s*what:\s*'([^']+)'",
                                         m.group(1))]


def app_numbers():
    """The box signatures `gen2/engine.js` declares, read out of the source.

    Read rather than restated, for the reason three hand-copied strides
    already taught this file: a number written down twice is a number that
    will disagree with itself, and the disagreement will be silent.
    """
    src = (ROOT / 'gen2' / 'engine.js').read_text()
    out = {}
    for field in ('battleMenu', 'switchBox', 'learnMove'):
        m = re.search(field + r':\s*\{([^}]*)\}', src)
        if not m:
            continue
        out[field] = {k: int(v) for k, v in
                      re.findall(r'(\w+):\s*(\d+)', m.group(1))}
    return out


def gyms(cart, name_of=None):
    """Every declared gym, against what the cartridge says."""
    bad = 0
    bits = badge_bits(cart)
    for path in picked_titles(cart):
        src = path.read_text()
        keys = {m.group(1): (int(m.group(2)), int(m.group(3)))
                for m in KEY.finditer(src)}

        def resolve(ref):
            """A `(group, number)` from a constant's name or a written key."""
            if ref in keys:
                return keys[ref]
            written = INLINE_KEY.fullmatch(ref)
            return (int(written.group(1)), int(written.group(2))) \
                if written else None

        for m in GYM.finditer(src):
            town, room, dx, dy, leader, lx, ly, badge = m.groups()
            print(f'{path.name}: {leader} in {room}')
            if not resolve(room) or not resolve(town):
                print('  !! its maps are neither `key(group, number)` nor a '
                      'constant that is one')
                bad += 1
                continue
            keys = dict(keys, **{room: resolve(room), town: resolve(town)})
            # The room's own name in the symbol file, found by the map it exits
            # into and the number it sits at -- the same reasoning a person
            # would do, done by the tool.
            room_name = name_of(keys[room]) if name_of else None
            if not room_name:
                print(f'  ?? no symbol found for map {keys[room][0]}.{keys[room][1]}')
                continue
            # **The door, which nothing checked.** A declaration carries the
            # tile in the *town* that leads into the room, and it was
            # hand-measured -- so the one number in a gym declaration that
            # sends the pilot walking was the one number with nothing behind
            # it. The warp table has it: a warp at that tile whose
            # destination is the room.
            town_name = name_of(keys[town]) if name_of else None
            if town_name:
                want = (int(dx), int(dy))
                into = [(w['x'], w['y']) for w in map_warps(cart, town_name)
                        if w['to'] == ((keys[room][0] << 8) | keys[room][1])]
                if want in into:
                    print(f'  door ({dx},{dy}) in {town_name} warps into '
                          f'{room_name}')
                elif into:
                    print(f'  !! ({dx},{dy}) is not a way into {room_name}; '
                          f'{town_name} warps in at '
                          f'{", ".join(f"({x},{y})" for x, y in into)}')
                    bad += 1
                else:
                    print(f'  !! {town_name} has no warp into {room_name}')
                    bad += 1
            objects = gym_objects(cart, room_name)
            at = [(sym, xy) for sym, xy in objects.items()
                  if (xy[0], xy[1]) == (int(lx), int(ly))]
            flag = f', engine flag ${bits[int(badge)]:02x}' \
                if int(badge) in bits else ''
            if not at:
                print(f'  !! nothing stands at ({lx},{ly}) in {room_name}')
                bad += 1
            # **One of the objects on that tile has to be the leader, not all
            # of them.** Two things can share a tile when only one is ever on
            # screen: Cianwood's Chuck stands at (12,11) and so does a
            # `SPRITE_BIG_HO_OH` statue that appears only while
            # `EVENT_BOULDERS_IN_CIANWOOD_GYM` is set. Held to "every object
            # here is a leader-shaped script", that gym failed for having
            # scenery in it.
            for sym, (_, _, kind) in at:
                named = leader.title() in sym or leader.capitalize() in sym
                print(f'  at ({lx},{ly}): {sym}  '
                      f'{"script" if kind == 0 else f"type {kind}"}'
                      f'  badge bit {badge}{flag}'
                      f'{"" if named else "  — not named for " + leader}')
            if at and not any(leader.title() in sym or leader.capitalize() in sym
                              for sym, (_, _, kind) in at if kind == 0):
                print(f'  !! no script object named for {leader} stands there'
                      f' — a leader is talked to, so it cannot be a trainer')
                bad += 1
            if int(badge) not in bits:
                print(f'  !! badge bit {badge} is not a badge in EngineFlags')
                bad += 1
    return bad


# The eight Johto gym leaders and the badge each one hands over, by the name
# the *trainer table* gives them -- so this list is a list of nothing but
# names, and everything else about them is read. It could be derived too, by
# taking every trainer whose class name is LEADER, and is not: the Kanto
# leaders are in the same table and this app declares no Kanto maps, so a
# list of eight is the honest scope rather than a shortcut.
#
# **Which leader gives which badge is a fact about the story. What bit that
# badge is, is a fact about the cartridge, and this used to conflate them.**
# The list was in badge order and its index *was* the bit, said out loud
# rather than computed silently -- ZEPHYR, HIVE, PLAIN, FOG, STORM, MINERAL,
# GLACIER, RISING. Polished Crystal runs ZEPHYR, HIVE, PLAIN, FOG,
# **MINERAL, STORM**, GLACIER, RISING: Chuck and Jasmine swap. Declaring
# Chuck at bit 4 there means offering a beaten gym for ever, or reading a win
# as a loss, and `check-app gyms` could not have caught it -- both numbers
# are badge bits in `EngineFlags`, which is all that check can ask.
LEADER_BADGES = (('FALKNER', 'Zephyr'), ('BUGSY', 'Hive'),
                 ('WHITNEY', 'Plain'), ('MORTY', 'Fog'),
                 ('CHUCK', 'Storm'), ('JASMINE', 'Mineral'),
                 ('PRYCE', 'Glacier'), ('CLAIR', 'Rising'))
# What a letter is, for reading a table of names out of the ROM without
# knowing its terminator. Both cartridges use the same two blocks; a run of
# them is a word and anything else ends it.
UPPER, LOWER = range(0x80, 0x9a), range(0xa0, 0xba)


def badge_names(cart):
    """{badge name, lowercased: bit} out of the cartridge's own table.

    Polished Crystal names the badge it has just given you, so `BadgeNames`
    lists all sixteen in bit order -- Zephyr, Hive, Plain, Fog, Mineral,
    Storm, Glacier, Rising, then Kanto's. That is the badge order, read
    rather than assumed.

    Decoded without knowing the terminator: a run of letter bytes is a word
    and the byte that is not a letter ends it, which works whether the
    cartridge writes `$50` after each one or `$53`. `99 a4 af a7 b8 b1 53` is
    Zephyr.

    Crystal has no such table -- it never shows a badge's name -- so this
    answers nothing there and the caller keeps the classic order, which is
    Crystal's own.
    """
    if 'BadgeNames' not in cart.by_name:
        return {}
    bank, addr = cart.by_name['BadgeNames']
    at = offset(bank, addr)
    out, word = {}, []
    letter = lambda b: chr(b - 0x80 + 65) if b in UPPER else (
        chr(b - 0xa0 + 97) if b in LOWER else None)
    # Sixteen names is well under 300 bytes; a bound rather than a count,
    # like every other scan here.
    for byte in cart.rom[at:at + 300]:
        c = letter(byte)
        if c:
            word.append(c)
        elif word:
            out.setdefault(''.join(word).lower(), len(out))
            word = []
        elif out:
            # Two non-letters running is the end of the list, not a gap in
            # the middle of it.
            break
    return out


def find_gyms(cart, name_of=None):
    """Where every gym leader stands, ready to declare.

    **The step that costs an afternoon each time a gym is added.** A title
    needs six numbers for one gym -- the town's map key, the room's map key,
    the door tile in the town, the leader's tile in the room, and the badge
    bit -- and every one of them was found by hand: dump a map's objects, look
    for a script named after the leader, then dump the town's warps and look
    for the one pointing at that room.

    All of it is in the ROM, so all of it is read here. The output is a line
    that can be pasted into a title's `gyms` list, which is the point: a
    declaration nobody had to measure is a declaration nobody got wrong.

    Reported rather than written: which gyms a title *declares* is a scope
    decision, not a fact about the cartridge -- see the eight-name list above.
    """
    # **Asked of `tools/route --maps`, which runs the app's own `World`.**
    # This wanted the whole table rather than one key at a time, and the
    # obvious way to get it -- ask `map_symbol` about every (group, number)
    # the cartridge could have -- produced **1536 maps out of 388**: a row
    # past the end of a group still resolves to some attributes pointer, and
    # some of those land on a real `_MapAttributes` symbol. Which is the fifth
    # time a second reader of this app's map tables produced a confident wrong
    # answer, so it is the app's reader that answers.
    name_of = name_of or route_maps()
    bits = badge_bits(cart)
    # Which bit each badge is, out of the cartridge if it says and out of
    # the classic order if it does not.
    order = badge_names(cart)
    where = order and 'its own BadgeNames table' or 'the classic badge order'
    print(f'badge bits from {where}')
    # Every map's objects, once. 388 maps is two seconds and the alternative
    # is 388 scans per leader.
    where = {}
    for key, name in name_of.items():
        for sym, (x, y, kind) in gym_objects(cart, name).items():
            where.setdefault(sym, []).append((key, name, x, y, kind))
    # And every warp, so the door into a room can be found from the town side.
    doors = {}
    for key, name in name_of.items():
        for w in map_warps(cart, name):
            doors.setdefault(w['to'], []).append((key, name, w['x'], w['y']))

    print(f'{len(LEADER_BADGES)} leader(s), against {len(name_of)} named maps')
    missing = 0
    for fallback, (who, badge_name) in enumerate(LEADER_BADGES):
        badge = order.get(badge_name.lower(), fallback)
        if badge != fallback:
            print(f'  ({badge_name} is bit {badge} here, not {fallback})')
        party = cart_trainer(cart, who)
        hits = [v for sym, vs in where.items()
                if who.title() in sym or who.capitalize() in sym
                for v in vs]
        # A script object named for the leader, **on a map called a Gym.**
        # Without that last clause Morty comes back twice: he has a cameo in
        # the Burned Tower, and a cameo is not a gym. Which is the tool's
        # scope rather than a fact about him -- so the others are reported
        # underneath rather than dropped in silence.
        rooms = [h for h in hits if h[4] == 0 and 'Gym' in h[1]]
        elsewhere = [h for h in hits if h[4] == 0 and 'Gym' not in h[1]]
        if not rooms:
            print(f'  ??  {who}: no script object named for them on a Gym map')
            missing += 1
            continue
        for key, name, x, y, _ in rooms:
            # A warp from a *different* map, because a room's warps back out
            # are in the same table and a map does not lead into itself. More
            # than one is reported rather than ranked -- the front door used
            # to be picked by the destination warp number, and that number
            # went when this stopped walking the block itself. Every gym in
            # both cartridges has exactly one way in, so ranking bought
            # nothing; saying how many there are catches the day it does.
            town = [d for d in doors.get(key, []) if d[0] != key]
            print(f'  {who} in {name} at ({x},{y})'
                  + (f'  — {len(party)} Pokémon, up to Lv'
                     f'{max(m["level"] for m in party)}' if party else ''))
            if not town:
                print(f'      ?? no other map warps into '
                      f'{key >> 8}.{key & 0xff}')
                missing += 1
                continue
            tkey, tname, tx, ty = town[0]
            print(f'      {{ map: key({tkey >> 8}, {tkey & 0xff}), '
                  f'inside: key({key >> 8}, {key & 0xff}), '
                  f'door: [{tx}, {ty}], leader: \'{who}\', '
                  f'leaderAt: [{x}, {y}], badge: {badge} }}')
            print(f'      // {tname} -> {name}'
                  + (f', and {len(town) - 1} other way(s) in'
                     if len(town) > 1 else ''))
        for key, name, x, y, _ in elsewhere:
            print(f'      also at ({x},{y}) in {name}, which is not a Gym')
    return missing


def ask_route(*flags):
    """Whatever `tools/route` answers, as JSON, or `{}`.

    **Every question about the map tables goes through here.** The app's
    `gen2/world.js` reads them, `tools/route` runs it, and this file asks
    rather than parsing the ROM a second time -- because it did parse it a
    second time, and the second reader was wrong five separate ways. Three
    hand-copied strides, a whole traversal that could not see Cherrygrove,
    and then Polished Crystal, whose coord event is five bytes where
    Crystal's is eight: the gym finder stepped past the triggers by three
    bytes per trigger, landed inside the next record, and reported that no
    Gym map in the game had a leader standing on it.
    """
    out = subprocess.run(['node', str(ROOT / 'tools' / 'route'), '--json',
                          *flags], capture_output=True, text=True)
    try:
        return json.loads(out.stdout or '{}')
    except ValueError:
        return {}


def route_maps():
    """{key: symbol name} for every map, out of `tools/route --maps`."""
    named = {}
    for text, name in ask_route('--maps').items():
        group, _, number = text.partition('.')
        named[(int(group) << 8) | int(number)] = name
    return named


def route_objects():
    """{map symbol: [object]} for every named map, asked once and kept.

    An object is `{map, sprite, x, y, type, script}`, and `script` is the
    `bank:addr` its pointer resolves to -- which is what makes a leader a
    *name* rather than an inference.
    """
    if not hasattr(route_objects, 'cache'):
        route_objects.cache = ask_route('--objects')
    return route_objects.cache


def route_warps():
    """{map symbol: [{x, y, to}]} for every named map, asked once and kept."""
    if not hasattr(route_warps, 'cache'):
        route_warps.cache = ask_route('--warps')
    return route_warps.cache


def route_triggers():
    """{map symbol: [{scene, x, y}]} for every named map, asked once."""
    if not hasattr(route_triggers, 'cache'):
        route_triggers.cache = ask_route('--triggers')
    return route_triggers.cache


# How far below the rest of the game a trigger-carrying map's object list may
# read before it is called a bad stride. Measured on the two cartridges this
# has: Crystal's trigger maps resolve 86.3% of their script pointers exactly
# against 96.7% elsewhere, and Polished Crystal's 70.7% against 75.7%. Ten
# points and five. Twenty is twice the worse of them and a quarter of the
# gap a wrong stride opens, which is not a gap at all -- both cartridges
# read *zero* objects on their trigger maps when the width is wrong.
LAYOUT_MARGIN = 20.0


def layout(cart):
    """Whether the event block's strides are this cartridge's own.

    **The check that replaced comparing two hand-written copies.** The strides
    lived in `gen2/world.js` and again here, and `check-app romlayout` held
    them to each other -- which caught the day one was mistyped and could
    never catch the day both were right about Crystal and wrong about the
    cartridge in front of them. Polished Crystal writes a five-byte coord
    event where Crystal writes eight, both files said eight, and they agreed.

    So this asks the cartridge instead, and the question is self-calibrating:
    **a map with trigger tiles on it is a map the object reader has to step
    over something to reach.** Get the width wrong and only those maps break.
    Compare them against the maps with no triggers at all -- same cartridge,
    same reader, same everything but the step -- and no threshold has to know
    which game it is looking at.

    "Breaks" is measured as script pointers that no longer land on a symbol.
    A pointer read out of the middle of the next record is a number, and a
    number lands where it lands: on both cartridges, a wrong stride takes the
    trigger maps from hundreds of objects to none at all.
    """
    objects, triggers = route_objects(), route_triggers()
    if not objects:
        print('the app\u2019s reader found no maps at all')
        return 1
    known = set()
    for name, (bank, addr) in cart.by_name.items():
        known.add((bank, addr))
    tally = {True: [0, 0], False: [0, 0]}
    for name, found in objects.items():
        has = bool(triggers.get(name))
        for o in found:
            bank, _, addr = o['script'].partition(':')
            at = (int(bank, 16), int(addr, 16))
            tally[has][0 if at in known else 1] += 1
    (hit, miss), (ohit, omiss) = tally[True], tally[False]
    rate = lambda a, b: 100.0 * a / (a + b) if a + b else None
    with_t, without_t = rate(hit, miss), rate(ohit, omiss)
    maps = sum(1 for n in objects if triggers.get(n))
    print(f'{len(objects)} maps, {maps} of them carrying trigger tiles')
    if without_t is None:
        print('  no objects anywhere — the block is not being read')
        return 1
    print(f'  maps with no triggers: {ohit + omiss} object(s), '
          f'{without_t:.1f}% of their scripts land on a symbol')
    if not maps:
        print('  no map on this cartridge has a trigger tile, so the coord '
              'event\u2019s width is not exercised here')
        return 0
    if with_t is None:
        print(f'  maps with triggers: no objects at all, on {maps} map(s) '
              f'that have them — the coord event\u2019s width is wrong')
        return 1
    print(f'  maps with triggers:    {hit + miss} object(s), '
          f'{with_t:.1f}% of theirs')
    if without_t - with_t > LAYOUT_MARGIN:
        print(f'  !! {without_t - with_t:.1f} points worse behind a trigger, '
              f'which is a stride and not a coincidence')
        return 1
    return 0


def object_kinds(cart):
    """`engine.objectTypes` for the profile this cartridge would be driven by.

    Which kinds mean *trainer* is a fact about the cartridge, not a constant.
    Crystal has three -- script, item ball, trainer -- and Polished Crystal
    has eight, of which two are trainers: `OBJECTTYPE_TRAINER` and
    `OBJECTTYPE_GENERICTRAINER`, the second being most of the trainers in a
    Gym. Held to Crystal's number, every Gym in that hack read as full of
    objects that disagreed with their own names.
    """
    if not hasattr(object_kinds, 'cache'):
        object_kinds.cache = {}
    key = str(getattr(cart, 'rom_path', None))
    if key not in object_kinds.cache:
        object_kinds.cache[key] = ask_engine(cart, 'objectTypes') or {}
    return object_kinds.cache[key]


def map_warps(cart, name):
    """`[{x, y, to}]` for one map: where each warp is and which map it enters.

    The app's own answer, through `tools/route --warps`. It used to be a
    second walk of the event block in this file, keyed off a `<Map>_MapEvents`
    symbol -- and Polished Crystal has none of those, because its warps live
    inside the map script header rather than behind a pointer of their own.
    Every door in the game came back missing.
    """
    return route_warps().get(name, [])


def cart_trainer(cart, who):
    """One trainer's party, through the app's reader rather than a second one."""
    out = subprocess.run(['node', str(ROOT / 'tools' / 'types'),
                           '--trainer', who],
                         capture_output=True, text=True)
    party = []
    for line in out.stdout.splitlines():
        m = re.match(r'\s+Lv\s*(\d+)\s+(\S+)', line)
        if m:
            party.append({'level': int(m.group(1)), 'name': m.group(2)})
    return party


def load():
    # Whatever cartridge is in `dev/`, paired by name -- see tools/cartridge.py
    # for why the pairing is the careful part and the globbing is not.
    rom, sym, note = cartridge.find_cartridge(DEV)
    if note:
        print(f'[cartridge] {note}')
    if not rom or not sym:
        print(f'no cartridge in {DEV.name}/ — nothing to read')
        print('(a ROM is not in this repository and never will be)')
        return None
    return Cart(rom.read_bytes(), sym.read_text(), rom, sym)


# The whole gate object, brace to brace. A non-greedy `.*?needs:` was the
# first draft and it stopped the match at the first field it wanted -- so
# `tile:` and `errand:`, which come after, were invisible and the tile check
# silently did nothing. These objects nest no braces, so `[^{}]*` is exact and
# cannot run past the end of one.
GATE = re.compile(r'\{[^{}]*?\bevent:\s*(0x[0-9a-f]+)[^{}]*\}', re.S)
GATE_FROM = re.compile(r'\bfrom:\s*(\w+)')
GATE_TO = re.compile(r'\bto:\s*(\w+)')
GATE_NEEDS = re.compile(r'\bneeds:\s*[\'"]([^\'"]*)[\'"]')
GATE_AT = re.compile(r'\bat:\s*(\w+)')


class _Blank:
    """Stands in for a field a gate does not carry, so unpacking stays flat."""

    def group(self, _):
        return '?'


_blank = _Blank()
GATE_TILE = re.compile(r'\btile:\s*\[(\d+),\s*(\d+)\]')
GATE_ERRAND = re.compile(r'\berrand:\s*[\'"](\w+)[\'"]')


# A hit *may* be a coincidence: a byte search over 2MB finds them, and
# `setevent $2d` also reads out of three bytes of `DunsparceFrames.frame3`.
#
# Two discriminators were tried and both failed honestly, which is why this is
# a comment rather than a filter. Requiring the containing symbol to look like
# a script (`Script`, `Scene`, `Callback`) rejects real ones --
# `RuinsOfAlphHoOhChamberPuzzle.PuzzleComplete` sets an event and matches none
# of those words. Requiring the *next* byte to decode as a command does not
# discriminate either: the Dunsparce byte is `34`, which is `checkflag`. With a
# twenty-command table roughly one byte in twelve looks like an instruction.
#
# So this labels rather than judges. Naming every hit and letting a person read
# the list is the honest tool; a filter that silently drops a real setter would
# be worse than the noise.
DATA_ISH = re.compile(r'Frames|Gfx|Palette|Tiles|Anim')


def gates(cart, name_of=None):
    """Every declared gate, against what the ROM says sets its event.

    Two claims now, and the second is the one worth having: *the thing that
    sets this event stands on this tile on this map.* A gate that says "talk to
    somebody in the Pokémon Center" and names a tile with nobody on it sends
    the pilot to press A at the floor -- and reports that whoever it is would
    not hand the thing over, which reads like the game refusing.
    """
    bad = 0
    for path in picked_titles(cart):
        src = path.read_text()
        keys = {k.group(1): (int(k.group(2)), int(k.group(3)))
                for k in KEY.finditer(src)}
        for m in GATE.finditer(src):
            body = m.group(0)
            event = m.group(1)
            frm = (GATE_FROM.search(body) or _blank).group(1)
            to = (GATE_TO.search(body) or _blank).group(1)
            needs = (GATE_NEEDS.search(body) or _blank).group(1)
            where = GATE_AT.search(body)
            tile = GATE_TILE.search(body)
            errand = GATE_ERRAND.search(body)
            # The declaration is read out of JavaScript source, so an escaped
            # apostrophe arrives as six characters. Decoded for the eye only.
            needs = re.sub(r'\\u([0-9a-fA-F]{4})',
                           lambda e: chr(int(e.group(1), 16)), needs)
            print(f'{path.name}: {frm} → {to}  event {event}')
            print(f'  needs: {needs}')
            hits = cart.setters(int(event, 16))
            if not hits:
                print('  !! nothing in the ROM sets it')
                bad += 1
            setters = []
            for off, name in hits:
                kind = 'probably data' if DATA_ISH.search(name) else 'set by'
                if kind == 'set by':
                    setters.append(name)
                print(f'  {kind}: {name}   (${off:06x})')
            if errand:
                print(f'  errand: {errand.group(1)}')
            # The remedy's own tile, where one is declared: somebody has to be
            # standing on it, and their script has to be the thing that sets
            # the event.
            if not (tile and where and name_of):
                continue
            room = keys.get(where.group(1))
            room_name = name_of(room) if room else None
            if not room_name:
                print(f'  ?? no symbol for the map named by `at`')
                bad += 1
                continue
            want = (int(tile.group(1)), int(tile.group(2)))
            standing = [sym for sym, xy in gym_objects(cart, room_name).items()
                        if (xy[0], xy[1]) == want]
            if not standing:
                print(f'  !! nothing stands at {want} in {room_name}')
                bad += 1
                continue
            for sym in standing:
                # The setter's symbol is a label *inside* the object's script,
                # so the object's own name is a prefix of it. That is the whole
                # check: the person on that tile is the person who sets the bit.
                theirs = any(setter.startswith(sym) for setter in setters)
                print(f'  at {want} in {room_name}: {sym}'
                      + ('  — and it is the setter' if theirs else ''))
                if not theirs:
                    print(f'  !! whoever stands there does not set ${int(event, 16):04x}')
                    bad += 1
    return bad


def main(argv):
    cart = load()
    if not cart:
        return 0
    if '--set' in argv:
        event = int(argv[argv.index('--set') + 1], 0)
        hits = cart.setters(event)
        print(f'setevent ${event:04x}: {len(hits)} match(es) in the ROM')
        for off, name in hits:
            print(f'  {name}   (${off:06x})')
        return 0
    if '--script' in argv:
        for line in cart.script(argv[argv.index('--script') + 1]):
            print(line)
        return 0
    if '--findgyms' in argv:
        return 1 if find_gyms(cart) else 0
    if '--layout' in argv:
        return layout(cart)
    if '--gyms' in argv:
        return 1 if gyms(cart, map_symbol(cart)) else 0
    if '--verify' in argv:
        return 1 if verify(cart) else 0
    if '--phrases' in argv:
        return 1 if phrases(cart) else 0
    if '--find' in argv:
        return where(cart, ' '.join(argv[argv.index('--find') + 1:]))
    if '--menus' in argv:
        bad = menus(cart)
        # The third number, and whether it is still worth trusting.
        for other in app_others():
            names = unique_left(cart, other['left'])
            if len(names) == 1:
                print(f'  left column {other["left"]} is unique to '
                      f'{names[0]} — so "{other["what"]}" is safe to act on')
            elif not names:
                # **Nothing claims it, which is not ambiguity.** The danger
                # this check exists for is a *second* header answering to the
                # same number, which would have the pilot refuse a battle it
                # could fight. None at all means this cartridge has no such
                # box under a name the symbol file gives -- Polished Crystal
                # has no Bug Contest menu header -- and the discriminator
                # simply never fires. The app loses a thing it can recognise
                # and mistakes nothing.
                print(f'  note  left column {other["left"]} is claimed by no '
                      f'header here, so "{other["what"]}" will not be '
                      f'recognised on this cartridge')
            else:
                print(f'  !!  left column {other["left"]} is claimed by '
                      f'{len(names)} header(s), so it does not identify '
                      f'"{other["what"]}"')
                for n in names:
                    print(f'      {n}')
                bad += 1
        shared = collisions(cart)
        for field, names in sorted(shared.items()):
            if len(names) > 1:
                print(f'  shared: {field} ({len(names)} boxes with its '
                      f'signature) — only the moment tells them apart')
                for n in names:
                    print(f'      {n}')
        return 1 if bad else 0
    if '--objects' in argv:
        for line in map_objects(cart, argv[argv.index('--objects') + 1]):
            print(line)
        return 0
    if '--map' in argv:
        for line in map_events(cart, argv[argv.index('--map') + 1]):
            print(line)
        return 0
    if '--text' in argv:
        name = argv[argv.index('--text') + 1]
        if name not in cart.by_name:
            print(f'{name}: not in the symbol file')
            return 1
        print(cart.text(*cart.by_name[name]))
        return 0
    if '--gates' in argv or not argv:
        return 1 if gates(cart, map_symbol(cart)) else 0
    print(__doc__)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
