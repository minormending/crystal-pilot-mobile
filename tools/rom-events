#!/usr/bin/env python3
"""Ask the cartridge what a road wants, without running it.

Every gate in Gen 2 is a script reading one bit of `wEventFlags`, and the
answer to *why does this road turn me back?* is therefore in the ROM. The
forty-second pass worked one out by hand -- dump the bytes, decode enough of
the command set from the label names, decode the text with the app's own
character table, then search the whole file for the instruction that sets the
bit and ask the symbol file whose script it landed in. Four steps, an hour, and
the same four steps next time.

So it is a tool.

    tools/rom-events --set 0x2d
        which script sets this event -- the step that turns a reading into a
        fact. Coincidental byte matches are named too; the symbol file is what
        tells them from scripts.

    Routing and reachability live in `tools/route`, which runs the app's own
    `gen2/world.js` rather than a second reader. A Python copy of that
    traversal was written here first and diverged immediately -- it reported
    Cherrygrove City as "not a map this cartridge has", because the obvious way
    to derive a group's size does not work for every group and the app's
    version is deliberately permissive where it cannot tell. Four divergences
    in two passes, three of them constants: the reader that matters is the
    app's.

    tools/rom-events --gyms
        every gym a title declares, against the cartridge: who stands on the
        leader's tile, whether that object is one you talk to, and whether the
        badge bit is a badge

    tools/rom-events --verify
        check the object layout against all 388 maps: the type field and the
        script's own name have to agree about which objects are trainers

    tools/rom-events --objects AzaleaGym
        the map's warps and objects, with each object's script named -- which
        is where a gym leader stands, answered without a running game

    tools/rom-events --map Route32
        every event this map's scripts ask about, and who sets each -- which
        is how a gate is found without decoding a whole scene

    tools/rom-events --script Route32CooltrainerMContinueScene
        the bytes, with the branches and the text pointers resolved to names.
        Stops when the command table runs out, which real scenes reach fast:
        use --map for those.

    tools/rom-events --text Route32CooltrainerMText_AideIsWaiting
        what it says, in the game's own words

    tools/rom-events --gates
        every gate the titles declare, checked against the ROM: the event it
        names, and which script sets it

Needs a ROM and a symbol file in `dev/`, which are not in this repository and
never will be. Without them it says so and exits 0 -- the same way the move
table's check skips itself, because a tool that fails a clean checkout is a
tool somebody removes from CI.
"""
import bisect
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
DEV = ROOT / 'dev'

# Enough of the script command set to read a gate, and every one of these was
# derived from the symbol file rather than looked up -- the derivation is in
# docs/CODE.md. `Route32Noop1Scene` is one byte, `91`, which gives `end`; a
# `dw` landing on a `.Text` symbol gives `writetext`; a branch onto
# `.DontHaveZephyrBadge` gives the `iffalse` before it.
#
# (byte, name, argument shape) where the shape is a string of:
#   b = one byte    w = a two-byte pointer, resolved to a label
#   e = a two-byte event id
COMMANDS = {
    0x00: ('scall', 'w'),
    0x03: ('jump', 'w'),
    0x06: ('ifequal', 'bw'),
    0x08: ('iffalse', 'w'),
    0x09: ('iftrue', 'w'),
    0x1c: ('readvar', 'b'),
    0x31: ('checkevent', 'e'),
    0x32: ('clearevent', 'e'),
    0x33: ('setevent', 'e'),
    0x34: ('checkflag', 'e'),
    0x47: ('opentext', ''),
    0x49: ('closetext', ''),
    0x4c: ('writetext', 'w'),
    0x4e: ('yesorno', ''),
    0x54: ('waitbutton', ''),
    0x6b: ('faceplayer', ''),
    0x6e: ('disappear', 'b'),
    0x6f: ('appear', 'b'),
    0x90: ('endcallback', ''),
    0x91: ('end', ''),
}
SETEVENT = 0x33

# The game's own encoding, as far as a line of dialogue uses it. The letter and
# digit ranges are the same ones `gen2/romdata.js` decodes names with; the
# control bytes are the ones that only turn up in text.
PUNCT = {0xe0: "'", 0xe3: '-', 0xe6: '?', 0xe7: '!', 0xe8: '.', 0xe9: '&',
         0xea: 'e', 0xef: '♂', 0xf1: 'x', 0xf3: '/', 0xf4: ',',
         0xf5: '♀'}
TERMINATOR, LIGATURE, SPACE = 0x50, 0x54, 0x7f
BREAKS = {0x1f, 0x4e, 0x4f, 0x51, 0x55}
STOPS = {0x57: '<done>', 0x58: '<prompt>'}


def offset(bank, addr):
    """Where a banked address lives in the file."""
    return bank * 0x4000 + (addr - 0x4000)


class Cart:
    def __init__(self, rom, sym):
        self.rom = rom
        self.by_name = {}
        self.at = []                       # [(file offset, name)], sorted
        for line in sym.splitlines():
            head, _, name = line.partition(' ')
            bank, _, addr = head.partition(':')
            name = name.strip()
            try:
                bank, addr = int(bank, 16), int(addr, 16)
            except ValueError:
                continue
            if addr < 0x4000:              # RAM, not a script
                self.by_name.setdefault(name, (bank, addr))
                continue
            off = offset(bank, addr)
            self.by_name.setdefault(name, (bank, addr))
            self.at.append((off, name))
        self.at.sort()
        self.offs = [o for o, _ in self.at]

    # How far past a symbol a byte can be and still be described by it. A
    # branch target inside a script is usually an unnamed local a few bytes in;
    # something two hundred bytes past the last symbol is not *in* that symbol,
    # and saying so was actively misleading -- the first survey of a real scene
    # reported a `scall` landing in `EcruteakCityLass2Text_ReleasedBeasts+13`,
    # which is a text string in the same bank and nothing to do with it.
    NEAR = 64

    def label(self, off, bound=None):
        """The nearest symbol at or before a file offset, with the distance.

        `bound` is how far past a symbol still counts as inside it; the default
        is generous for a script and honest about a pointer.
        """
        i = bisect.bisect_right(self.offs, off) - 1
        if i < 0:
            return f'${off:06x}'
        name, base = self.at[i][1], self.offs[i]
        if base == off:
            return name
        if (bound if bound is not None else self.NEAR) < off - base:
            return f'${off:06x}'
        return f'{name}+{off - base}'

    def near(self, bank, addr):
        """A label for a pointer inside a bank, for resolving a branch."""
        return self.label(offset(bank, addr))

    def text(self, bank, addr, limit=300):
        out = []
        for byte in self.rom[offset(bank, addr):offset(bank, addr) + limit]:
            if byte == TERMINATOR:
                break
            if byte in STOPS:
                out.append('\n' + STOPS[byte])
                break
            if byte == LIGATURE:
                out.append('POKé')
            elif byte == SPACE:
                out.append(' ')
            elif byte in BREAKS:
                out.append('\n')
            elif byte in PUNCT:
                out.append(PUNCT[byte])
            elif 0x80 <= byte <= 0x99:
                out.append(chr(65 + byte - 0x80))
            elif 0xa0 <= byte <= 0xb9:
                out.append(chr(97 + byte - 0xa0))
            elif 0xf6 <= byte <= 0xff:
                out.append(chr(48 + byte - 0xf6))
            else:
                out.append(f'<{byte:02x}>')
        return ''.join(out)

    def script(self, name, limit=120):
        """One script, decoded as far as the command table reaches."""
        if name not in self.by_name:
            return [f'{name}: not in the symbol file']
        bank, addr = self.by_name[name]
        out, here, unknown = [], addr, 0
        while here < addr + limit:
            byte = self.rom[offset(bank, here)]
            cmd = COMMANDS.get(byte)
            label = self.near(bank, here)
            tag = f'  {here:04x}  ' + (f'{label:44}' if label != name else ' ' * 44)
            if not cmd:
                out.append(f'{tag}{byte:02x}  ?')
                unknown += 1
                here += 1
                # Three unknowns in a row is the table running out rather than
                # one odd byte, and reading on past that is inventing things.
                if unknown >= 3:
                    out.append('        ... command table ends here')
                    break
                continue
            unknown = 0
            word, args, at = cmd[0], [], here + 1
            for shape in cmd[1]:
                if shape == 'b':
                    args.append(f'${self.rom[offset(bank, at)]:02x}')
                    at += 1
                else:
                    ptr = (self.rom[offset(bank, at)]
                           | self.rom[offset(bank, at + 1)] << 8)
                    args.append(f'${ptr:04x}' if shape == 'e'
                                else f'{self.near(bank, ptr)}')
                    at += 2
            out.append(f'{tag}{word} {" ".join(args)}'.rstrip())
            here = at
            if word in ('end', 'endcallback', 'jump'):
                break
        return out

    def setters(self, event):
        """Every place in the ROM that sets this event, named."""
        want = bytes([SETEVENT, event & 0xff, (event >> 8) & 0xff])
        hits, start = [], 0
        while True:
            found = self.rom.find(want, start)
            if found < 0:
                return hits
            hits.append((found, self.label(found)))
            start = found + 1


CHECKEVENT = 0x31

# A map's `_MapEvents` block, as the cartridge lays it out. **Derived, not
# looked up** -- and the derivation is why it can be trusted: Violet Gym's
# fourth field distinguishes two objects (00) from two others (02), which is
# the app's own `objectTypes` {script: 0, trainer: 2}; its ninth and tenth
# bytes resolve to `VioletGymFalknerScript`, `TrainerBirdKeeperRod`,
# `TrainerBirdKeeperAbe` and `VioletGymGuideScript`, which is four for four;
# and reading fields 1 and 2 as y+4 and x+4 puts Falkner at (5,1) and Abe at
# (2,10) -- the two positions this repository had already measured out of work
# RAM, a pass and a cartridge apart.
#
# Four independent agreements is what makes this a reading rather than a guess.
# `gen2/world.js` decodes the first two sections of the same block for coord
# events; this is the rest of it.
# **These are the app's numbers, and `check-app romlayout` holds them to it.**
# They were written out here by hand and one of them was wrong: coord events
# are eight bytes and this said five, so every map with a coord event on it
# parsed into drift -- Cianwood City produced objects of "type 9" whose script
# pointers landed three bytes inside a trainer's `.AskNumber2` label. Violet
# Gym and Azalea Gym have no coord events, so the two maps this was derived
# from were the two it could not fail on.
#
# `gen2/world.js` holds the same layout because the app reads warps and coord
# events at run time. Two copies of a structure is the defect; the check is the
# repair.
FILLER = 2
WARP_BYTES, COORD_BYTES, BG_BYTES, OBJECT_BYTES = 5, 8, 5, 13
OBJ_SPRITE, OBJ_Y, OBJ_X, OBJ_SCRIPT = 0, 1, 2, 9
# **The type is the low nibble of byte seven, and byte four is not the type.**
# Worth writing down because byte four *is* the type in Violet Gym -- 00, 02,
# 02, 00 against Falkner, two Bird Keepers and the guide, which is four for
# four and completely wrong. Azalea Gym has byte four at 00 for all seven of
# its objects, five of which are trainers.
#
# Byte seven reads 90 92 92 80 in Violet and a0 b2 b2 b2 82 82 80 in Azalea:
# low nibble 0 wherever the script symbol is a leader or a guide, 2 wherever it
# is named `Trainer...`. Eleven objects across two maps, and `--verify` checks
# the same rule against all 388 maps in the game rather than these two.
OBJ_TYPE, OBJ_TYPE_MASK = 7, 0x0f
# The cartridge stores an object's coordinates four higher than the map's own.
OBJ_OFFSET = 4
OBJ_KINDS = {0: 'script', 1: 'item ball', 2: 'trainer'}


def map_objects(cart, name):
    """A map's warps and objects, from the ROM, with their scripts named.

    Which answers the question a gym declaration asks -- *where does the
    leader stand?* -- without a running game. Better than without: the object's
    script pointer resolves to a symbol, so the leader is *named* rather than
    inferred from a position. `AzaleaGymBugsyScript` is not a heuristic.
    """
    key = f'{name}_MapEvents'
    if key not in cart.by_name:
        return [f'{name}: no _MapEvents in the symbol file']
    bank, addr = cart.by_name[key]
    rd = lambda i: cart.rom[offset(bank, addr + i)]
    at = FILLER
    out = [f'{name}:']
    warps = rd(at); at += 1
    # **Warps store their coordinates as-is; objects store them four higher.**
    # Two conventions in one block, and checking rather than assuming is what
    # caught it: New Bark's first warp reads (6,3) to map 24.5, which is
    # exactly the `labDoor: [6, 3]` and `ELMS_LAB = key(24, 5)` this repository
    # measured by hand a long time ago. Subtracting four there gives y = -1.
    for i in range(warps):
        b = at + i * WARP_BYTES
        out.append(f'  warp {i + 1}: ({rd(b + 1)},{rd(b)}) '
                   f'to {rd(b + 3)}.{rd(b + 4)} (its warp {rd(b + 2)})')
    at += warps * WARP_BYTES
    for label, size in (('coord', COORD_BYTES), ('bg', BG_BYTES)):
        n = rd(at); at += 1 + n * size
        out.append(f'  {n} {label} event(s)')
    objects = rd(at); at += 1
    for i in range(objects):
        b = at + i * OBJECT_BYTES
        ptr = rd(b + OBJ_SCRIPT) | rd(b + OBJ_SCRIPT + 1) << 8
        raw = rd(b + OBJ_TYPE) & OBJ_TYPE_MASK
        kind = OBJ_KINDS.get(raw, f'type {raw}')
        out.append(f'  object {i + 1}: '
                   f'({rd(b + OBJ_X) - OBJ_OFFSET},{rd(b + OBJ_Y) - OBJ_OFFSET})'
                   f'  {kind:9}  sprite {rd(b + OBJ_SPRITE):3}  '
                   f'{cart.near(bank, ptr)}')
    return out


def gym_objects(cart, name):
    """{script symbol: (x, y, kind)} for one map, for checking a declaration."""
    found = {}
    key = f'{name}_MapEvents'
    if key not in cart.by_name:
        return found
    bank, addr = cart.by_name[key]
    rd = lambda i: cart.rom[offset(bank, addr + i)]
    at = FILLER
    warps = rd(at); at += 1 + warps * WARP_BYTES
    for size in (COORD_BYTES, BG_BYTES):
        n = rd(at); at += 1 + n * size
    objects = rd(at); at += 1
    for i in range(objects):
        b = at + i * OBJECT_BYTES
        ptr = rd(b + OBJ_SCRIPT) | rd(b + OBJ_SCRIPT + 1) << 8
        found[cart.near(bank, ptr)] = (rd(b + OBJ_X) - OBJ_OFFSET,
                                       rd(b + OBJ_Y) - OBJ_OFFSET,
                                       rd(b + OBJ_TYPE) & OBJ_TYPE_MASK)
    return found


def map_events(cart, name):
    """Every event a map's own scripts ask about, and who sets each.

    **The survey that does not need a decoder.** Deciding what a road wants
    means finding the event its blocker checks, and decoding a whole scene to
    get there is a losing game: the full command set is over a hundred
    instructions with a dozen argument shapes, and the first real scene this
    tool met used seven it did not know. Reading three bytes at a time does not
    need any of that.

    The region is exact rather than guessed. Every map in the game has both a
    `<Map>_MapScripts` and a `<Map>_MapEvents` symbol -- 388 of each -- and the
    scripts are laid out between them.

    False positives are possible, since `31 xx xx` also occurs in whatever data
    shares the region, and the cross-reference is what sorts them out: an event
    nothing sets is either a read of the game's own bookkeeping or a
    coincidence, and either way not a gate. That is the same shape of answer
    `--set` gives, and for the same reason.
    """
    first, last = f'{name}_MapScripts', f'{name}_MapEvents'
    if first not in cart.by_name or last not in cart.by_name:
        return [f'{name}: no _MapScripts/_MapEvents pair in the symbol file']
    start = offset(*cart.by_name[first])
    end = offset(*cart.by_name[last])
    if end <= start:
        return [f'{name}: its events come before its scripts, which cannot be read']
    out, seen = [f'{name}: {end - start} bytes of script'], {}
    for i in range(start, end - 2):
        if cart.rom[i] != CHECKEVENT:
            continue
        event = cart.rom[i + 1] | cart.rom[i + 2] << 8
        seen.setdefault(event, []).append(i)
    for event, wheres in sorted(seen.items()):
        setters = [n for _, n in cart.setters(event)
                   if not DATA_ISH.search(n)]
        out.append(f'  checkevent ${event:04x}  at {cart.label(wheres[0])}'
                   + (f' (+{len(wheres) - 1} more)' if len(wheres) > 1 else ''))
        for setter in setters[:4] or ['nothing sets it — bookkeeping, or a coincidence']:
            out.append(f'      set by {setter}')
    return out


MAP_EVENTS = '_MapEvents'
# One map's row in its group's list, and where the attributes pointer sits in
# it. The app's `world.js` reads the same table to find a map's size and its
# events; `check-app romlayout` holds the two to each other.
MAP_BYTES, MAP_ATTRIBUTES_BANK, MAP_ATTRIBUTES = 9, 0, 3


def map_symbol(cart):
    """A lookup from (group, number) to the map's own name in the symbol file.

    A title declares its maps as `key(group, number)`, because that is what the
    game puts in work RAM; the symbol file knows them as `AzaleaGym_...`. The
    bridge is the attributes pointer: every map's row in `MapGroupPointers`
    holds one, and there is a `<Map>_MapAttributes` symbol at that address.

    Without this the checking has to be told which symbol goes with which
    number, which is one more hand-written table to drift.
    """
    if 'MapGroupPointers' not in cart.by_name:
        return lambda key: None
    gbank, gaddr = cart.by_name['MapGroupPointers']
    attrs = {}
    for name, (bank, addr) in cart.by_name.items():
        if name.endswith('_MapAttributes'):
            attrs[(bank, addr)] = name[:-len('_MapAttributes')]

    def find(key):
        group, number = key
        base = offset(gbank, gaddr) + (group - 1) * 2
        listed = cart.rom[base] | cart.rom[base + 1] << 8
        row = offset(gbank, listed) + (number - 1) * MAP_BYTES
        bank = cart.rom[row + MAP_ATTRIBUTES_BANK]
        addr = cart.rom[row + MAP_ATTRIBUTES] | cart.rom[row + MAP_ATTRIBUTES + 1] << 8
        return attrs.get((bank, addr))
    return find


def verify(cart):
    """Check the object layout against every map in the game.

    The rule: an object whose script symbol is named `Trainer...` is a trainer,
    and one that is not, is not. The cartridge says which in the low nibble of
    byte seven, and the names come from a different part of the file entirely
    -- so agreement across every map is two independent sources saying the same
    thing several thousand times.

    This is here because the first reading of that field was **wrong and looked
    right**: byte four is the type in Violet Gym, four objects for four, and is
    00 for all seven of Azalea Gym's, five of which are trainers. Two maps is
    not a sample.
    """
    maps = sorted(n[:-len(MAP_EVENTS)] for n in cart.by_name
                  if n.endswith(MAP_EVENTS))
    objects = disagree = 0
    for name in maps:
        for script, (_, _, kind) in gym_objects(cart, name).items():
            objects += 1
            named = script.startswith('Trainer')
            if named != (kind == 2):
                disagree += 1
                if disagree <= 10:
                    print(f'  {name}: {script} is type {kind}')
    print(f'{len(maps)} maps, {objects} objects, {disagree} disagreement(s) '
          f'between the type field and the script name')
    # Reported, not failed. The name rule is a validator with real exceptions:
    # some trainers are *talked to* rather than seen, so `TrainerOfficerDirk`
    # is legitimately a script object, and the Trainer House's receptionist is
    # named `Trainer...` while being nobody to fight. Twelve of 1396 at the
    # time of writing, every one of them explicable. What the layout is held to
    # instead is `check-app romlayout`, which is binary and cannot drift.
    return 0


GYM = re.compile(r'\{\s*map:\s*(\w+),\s*inside:\s*(\w+),\s*door:\s*\[(\d+),\s*(\d+)\],'
                 r'\s*\n?\s*leader:\s*[\'"](\w+)[\'"],\s*leaderAt:\s*\[(\d+),\s*(\d+)\],'
                 r'\s*badge:\s*(\d+)', re.S)
KEY = re.compile(r'const (\w+) = key\((\d+),\s*(\d+)\);')
BADGE_FLAG_BYTES = 3


def badge_bits(cart):
    """{bit: engine flag} for the badge byte, out of the cartridge's own table.

    `EngineFlags` is three bytes an entry -- a two-byte address and a bitmask
    -- so the badges are the run of entries pointing at `wJohtoBadges`. The
    Zephyr Badge is bit 0 there, which is what this app measured on a real
    cartridge after beating Falkner, so the table and the measurement agree
    about the one case that could be checked both ways.
    """
    if 'EngineFlags' not in cart.by_name or 'wJohtoBadges' not in cart.by_name:
        return {}
    bank, addr = cart.by_name['EngineFlags']
    byte_at = cart.by_name['wJohtoBadges'][1]
    out = {}
    for i in range(0x100):
        e = offset(bank, addr) + i * BADGE_FLAG_BYTES
        if e + 2 >= len(cart.rom):
            break
        where = cart.rom[e] | cart.rom[e + 1] << 8
        mask = cart.rom[e + 2]
        if where == byte_at and mask and not (mask & (mask - 1)):
            out.setdefault(mask.bit_length() - 1, i)
    return out


# A menu header in pokecrystal: a flags byte, the box as `y1, x1, y2, x2`,
# a pointer to the menu data, and a default. The data begins with its own
# flags byte and then the item count, and the strings follow it.
#
# **The layout is derived, and it is derived against a measurement.** Read
# this way, `BattleMenuHeader` comes out as 34 items with its border at row
# 12 -- which is exactly what `gen2/engine.js` says after somebody measured it
# on a real cartridge, before any of this existed. A derivation that
# reproduces a measurement is worth more than either on its own, and it is the
# reason the *other* headers here can be trusted without a screen to look at.
MENU_HEADER_BYTES = 7
MENU_DATA_ITEMS = 1

# The boxes the app tells apart by shape, and what it calls each one. A box
# this app drives by a signature has to have that signature checked, because
# the failure is silent in both directions: a box mistaken for another is
# pressed with the wrong answer, and a box nothing matches is pressed on
# through.
APP_BOXES = [
    ('BattleMenuHeader', 'battleMenu', None),
    ('BattleMonMenu.MenuHeader', 'switchBox', 'SWITCH'),
]


def menu_header(cart, name):
    """`{items, top, first}` for a named menu header, or None."""
    if name not in cart.by_name:
        return None
    bank, addr = cart.by_name[name]
    off = offset(bank, addr)
    head = cart.rom[off:off + MENU_HEADER_BYTES]
    if len(head) < MENU_HEADER_BYTES:
        return None
    top, ptr = head[1], head[5] | head[6] << 8
    data = offset(bank, ptr)
    items = cart.rom[data + MENU_DATA_ITEMS]
    # The strings run one after another behind the count, each ended by "@",
    # and `Cart.text` already knows the cartridge's alphabet -- so the first
    # option's name is read with the same decoder every other string in this
    # tool goes through rather than a second one written here.
    first = cart.text(bank, ptr + MENU_DATA_ITEMS + 1, limit=12)
    return {'items': items, 'top': top, 'first': first}


def menus(cart):
    """Every box the app drives by shape, against the cartridge's own header.

    The one that could not be guessed is the switch box. The *field* party
    menu's options begin STATS, SWITCH; the *battle* one begins SWITCH,
    STATS -- so the press that switches a Pokemon in during a fight opens its
    stats out in the world, and assuming the order seen more often costs a
    turn to a stats screen while a trainer takes its own.
    """
    want = app_numbers()
    bad = 0
    for name, field, first in APP_BOXES:
        got = menu_header(cart, name)
        if not got:
            print(f'  ??  {name} is not in this symbol file')
            bad += 1
            continue
        mine = want.get(field, {})
        # The first option's name is only printed where it is also checked.
        # `BattleMenuHeader`'s data points at a separate `.Text` table rather
        # than carrying its strings inline, so reading them at the same
        # offset gives bytes that are not text -- and printing those as
        # though they were is how a tool teaches somebody something false.
        line = (f'  {field}: {got["items"]} item(s), border row {got["top"]}'
                + (f', first "{got["first"]}"' if first else ''))
        for key in ('items', 'top'):
            if key in mine and mine[key] != got[key]:
                print(f'  !!  {field}.{key} says {mine[key]}, '
                      f'{name} has {got[key]}')
                bad += 1
        if first and got['first'] != first:
            print(f'  !!  {field} expects "{first}" first, '
                  f'{name} begins "{got["first"]}"')
            bad += 1
        print(line + ('' if bad else '  — and the app agrees'))
    return bad


def collisions(cart):
    """Named menu headers that share a signature with one the app declares.

    **The hazard the app cannot see for itself.** Every box here is told apart
    by `items` and the border row, so two boxes with the same pair are two
    boxes a snapshot cannot distinguish -- and `engine.js` already documents
    three of those, found the hard way: `learnMove` and the battle pack's
    USE/QUIT are both two items at row 7, and the pack mid-throw is two at
    row 0. Which of them is on screen can only come from *when* it was asked,
    which is a claim the callers have to keep.

    So this lists them rather than failing on them. A collision is not a bug;
    an *unknown* collision is, and the list is the difference.
    """
    want = app_numbers()
    mine = {(v.get('items'), v.get('top')): k for k, v in want.items()
            if 'items' in v and 'top' in v}
    named = [n for n in cart.by_name
             if n.endswith('MenuHeader') or n.endswith('.MenuHeader')]
    out = {}
    for name in sorted(named):
        got = menu_header(cart, name)
        if not got:
            continue
        key = (got['items'], got['top'])
        if key in mine:
            out.setdefault(mine[key], []).append(name)
    return out


def unique_left(cart, want=2):
    """Which named menu headers put their box's left edge at `want`.

    The Bug Contest's battle menu shares `battleMenu`'s two numbers exactly,
    so the app tells it apart by this third one -- and acting on a third
    number is only safe while that number is *unique*. It is: one header out
    of 73 on this cartridge. If a future build adds a second, this says so
    before the pilot starts refusing battles it could have fought.
    """
    out = []
    for name in sorted(cart.by_name):
        if not (name.endswith('MenuHeader') or name.endswith('.MenuHeader')):
            continue
        bank, addr = cart.by_name[name]
        head = cart.rom[offset(bank, addr):offset(bank, addr) + MENU_HEADER_BYTES]
        if len(head) == MENU_HEADER_BYTES and head[2] == want:
            out.append(name)
    return out


def app_others():
    """The battle menus the app says are *not* its own, out of the source."""
    src = (ROOT / 'gen2' / 'engine.js').read_text()
    m = re.search(r'otherBattles:\s*\[(.*?)\]', src, re.S)
    if not m:
        return []
    return [{'left': int(left), 'what': what}
            for left, what in re.findall(r"left:\s*(\d+),\s*what:\s*'([^']+)'",
                                         m.group(1))]


def app_numbers():
    """The box signatures `gen2/engine.js` declares, read out of the source.

    Read rather than restated, for the reason three hand-copied strides
    already taught this file: a number written down twice is a number that
    will disagree with itself, and the disagreement will be silent.
    """
    src = (ROOT / 'gen2' / 'engine.js').read_text()
    out = {}
    for field in ('battleMenu', 'switchBox', 'learnMove'):
        m = re.search(field + r':\s*\{([^}]*)\}', src)
        if not m:
            continue
        out[field] = {k: int(v) for k, v in
                      re.findall(r'(\w+):\s*(\d+)', m.group(1))}
    return out


def gyms(cart, name_of=None):
    """Every declared gym, against what the cartridge says."""
    bad = 0
    bits = badge_bits(cart)
    for path in sorted((ROOT / 'titles').glob('*.js')):
        src = path.read_text()
        keys = {m.group(1): (int(m.group(2)), int(m.group(3)))
                for m in KEY.finditer(src)}
        for m in GYM.finditer(src):
            town, room, dx, dy, leader, lx, ly, badge = m.groups()
            print(f'{path.name}: {leader} in {room}')
            if room not in keys or town not in keys:
                print('  !! its maps are not `key(group, number)` constants')
                bad += 1
                continue
            # The room's own name in the symbol file, found by the map it exits
            # into and the number it sits at -- the same reasoning a person
            # would do, done by the tool.
            room_name = name_of(keys[room]) if name_of else None
            if not room_name:
                print(f'  ?? no symbol found for map {keys[room][0]}.{keys[room][1]}')
                continue
            objects = gym_objects(cart, room_name)
            at = [(sym, xy) for sym, xy in objects.items()
                  if (xy[0], xy[1]) == (int(lx), int(ly))]
            if not at:
                print(f'  !! nothing stands at ({lx},{ly}) in {room_name}')
                bad += 1
            for sym, (_, _, kind) in at:
                named = leader.title() in sym or leader.capitalize() in sym
                ok_kind = kind == 0
                flag = f', engine flag ${bits[int(badge)]:02x}' \
                    if int(badge) in bits else ''
                print(f'  at ({lx},{ly}): {sym}  {"script" if ok_kind else f"type {kind}"}'
                      f'  badge bit {badge}{flag}')
                if not named:
                    print(f'  !! that script is not named for {leader}')
                    bad += 1
                if not ok_kind:
                    print('  !! a leader is talked to, so it must be a script object')
                    bad += 1
                if int(badge) not in bits:
                    print(f'  !! badge bit {badge} is not a badge in EngineFlags')
                    bad += 1
    return bad


def load():
    rom, sym = DEV / 'pokecrystal.gbc', DEV / 'pokecrystal.sym'
    if not rom.exists() or not sym.exists():
        print(f'no cartridge in {DEV.name}/ — nothing to read')
        print('(a ROM is not in this repository and never will be)')
        return None
    return Cart(rom.read_bytes(), sym.read_text())


# The whole gate object, brace to brace. A non-greedy `.*?needs:` was the
# first draft and it stopped the match at the first field it wanted -- so
# `tile:` and `errand:`, which come after, were invisible and the tile check
# silently did nothing. These objects nest no braces, so `[^{}]*` is exact and
# cannot run past the end of one.
GATE = re.compile(r'\{[^{}]*?\bevent:\s*(0x[0-9a-f]+)[^{}]*\}', re.S)
GATE_FROM = re.compile(r'\bfrom:\s*(\w+)')
GATE_TO = re.compile(r'\bto:\s*(\w+)')
GATE_NEEDS = re.compile(r'\bneeds:\s*[\'"]([^\'"]*)[\'"]')
GATE_AT = re.compile(r'\bat:\s*(\w+)')


class _Blank:
    """Stands in for a field a gate does not carry, so unpacking stays flat."""

    def group(self, _):
        return '?'


_blank = _Blank()
GATE_TILE = re.compile(r'\btile:\s*\[(\d+),\s*(\d+)\]')
GATE_ERRAND = re.compile(r'\berrand:\s*[\'"](\w+)[\'"]')


# A hit *may* be a coincidence: a byte search over 2MB finds them, and
# `setevent $2d` also reads out of three bytes of `DunsparceFrames.frame3`.
#
# Two discriminators were tried and both failed honestly, which is why this is
# a comment rather than a filter. Requiring the containing symbol to look like
# a script (`Script`, `Scene`, `Callback`) rejects real ones --
# `RuinsOfAlphHoOhChamberPuzzle.PuzzleComplete` sets an event and matches none
# of those words. Requiring the *next* byte to decode as a command does not
# discriminate either: the Dunsparce byte is `34`, which is `checkflag`. With a
# twenty-command table roughly one byte in twelve looks like an instruction.
#
# So this labels rather than judges. Naming every hit and letting a person read
# the list is the honest tool; a filter that silently drops a real setter would
# be worse than the noise.
DATA_ISH = re.compile(r'Frames|Gfx|Palette|Tiles|Anim')


def gates(cart, name_of=None):
    """Every declared gate, against what the ROM says sets its event.

    Two claims now, and the second is the one worth having: *the thing that
    sets this event stands on this tile on this map.* A gate that says "talk to
    somebody in the Pokémon Center" and names a tile with nobody on it sends
    the pilot to press A at the floor -- and reports that whoever it is would
    not hand the thing over, which reads like the game refusing.
    """
    bad = 0
    for path in sorted((ROOT / 'titles').glob('*.js')):
        src = path.read_text()
        keys = {k.group(1): (int(k.group(2)), int(k.group(3)))
                for k in KEY.finditer(src)}
        for m in GATE.finditer(src):
            body = m.group(0)
            event = m.group(1)
            frm = (GATE_FROM.search(body) or _blank).group(1)
            to = (GATE_TO.search(body) or _blank).group(1)
            needs = (GATE_NEEDS.search(body) or _blank).group(1)
            where = GATE_AT.search(body)
            tile = GATE_TILE.search(body)
            errand = GATE_ERRAND.search(body)
            # The declaration is read out of JavaScript source, so an escaped
            # apostrophe arrives as six characters. Decoded for the eye only.
            needs = re.sub(r'\\u([0-9a-fA-F]{4})',
                           lambda e: chr(int(e.group(1), 16)), needs)
            print(f'{path.name}: {frm} → {to}  event {event}')
            print(f'  needs: {needs}')
            hits = cart.setters(int(event, 16))
            if not hits:
                print('  !! nothing in the ROM sets it')
                bad += 1
            setters = []
            for off, name in hits:
                kind = 'probably data' if DATA_ISH.search(name) else 'set by'
                if kind == 'set by':
                    setters.append(name)
                print(f'  {kind}: {name}   (${off:06x})')
            if errand:
                print(f'  errand: {errand.group(1)}')
            # The remedy's own tile, where one is declared: somebody has to be
            # standing on it, and their script has to be the thing that sets
            # the event.
            if not (tile and where and name_of):
                continue
            room = keys.get(where.group(1))
            room_name = name_of(room) if room else None
            if not room_name:
                print(f'  ?? no symbol for the map named by `at`')
                bad += 1
                continue
            want = (int(tile.group(1)), int(tile.group(2)))
            standing = [sym for sym, xy in gym_objects(cart, room_name).items()
                        if (xy[0], xy[1]) == want]
            if not standing:
                print(f'  !! nothing stands at {want} in {room_name}')
                bad += 1
                continue
            for sym in standing:
                # The setter's symbol is a label *inside* the object's script,
                # so the object's own name is a prefix of it. That is the whole
                # check: the person on that tile is the person who sets the bit.
                theirs = any(setter.startswith(sym) for setter in setters)
                print(f'  at {want} in {room_name}: {sym}'
                      + ('  — and it is the setter' if theirs else ''))
                if not theirs:
                    print(f'  !! whoever stands there does not set ${int(event, 16):04x}')
                    bad += 1
    return bad


def main(argv):
    cart = load()
    if not cart:
        return 0
    if '--set' in argv:
        event = int(argv[argv.index('--set') + 1], 0)
        hits = cart.setters(event)
        print(f'setevent ${event:04x}: {len(hits)} match(es) in the ROM')
        for off, name in hits:
            print(f'  {name}   (${off:06x})')
        return 0
    if '--script' in argv:
        for line in cart.script(argv[argv.index('--script') + 1]):
            print(line)
        return 0
    if '--gyms' in argv:
        return 1 if gyms(cart, map_symbol(cart)) else 0
    if '--verify' in argv:
        return 1 if verify(cart) else 0
    if '--menus' in argv:
        bad = menus(cart)
        # The third number, and whether it is still worth trusting.
        for other in app_others():
            names = unique_left(cart, other['left'])
            if len(names) == 1:
                print(f'  left column {other["left"]} is unique to '
                      f'{names[0]} — so "{other["what"]}" is safe to act on')
            else:
                print(f'  !!  left column {other["left"]} is claimed by '
                      f'{len(names)} header(s), so it does not identify '
                      f'"{other["what"]}"')
                for n in names:
                    print(f'      {n}')
                bad += 1
        shared = collisions(cart)
        for field, names in sorted(shared.items()):
            if len(names) > 1:
                print(f'  shared: {field} ({len(names)} boxes with its '
                      f'signature) — only the moment tells them apart')
                for n in names:
                    print(f'      {n}')
        return 1 if bad else 0
    if '--objects' in argv:
        for line in map_objects(cart, argv[argv.index('--objects') + 1]):
            print(line)
        return 0
    if '--map' in argv:
        for line in map_events(cart, argv[argv.index('--map') + 1]):
            print(line)
        return 0
    if '--text' in argv:
        name = argv[argv.index('--text') + 1]
        if name not in cart.by_name:
            print(f'{name}: not in the symbol file')
            return 1
        print(cart.text(*cart.by_name[name]))
        return 0
    if '--gates' in argv or not argv:
        return 1 if gates(cart, map_symbol(cart)) else 0
    print(__doc__)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
