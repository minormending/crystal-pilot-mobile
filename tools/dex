#!/usr/bin/env node
// What the cartridge knows about a species, asked of the app's own reader.
//
//     tools/dex cyndaquil             one species: stats, types, evolutions,
//                                     and every move it learns by levelling
//     tools/dex 155                   the same, by Pokedex number
//     tools/dex --at 14 cyndaquil     what changes at that level, and what is
//                                     next after it
//     tools/dex --evolves 20          every species that evolves at Lv20
//     tools/dex --verify              the whole table against things that were
//                                     true about Pokemon before this app was
//     tools/dex --party               the party out of a .sav in dev/, as the
//                                     app's own card would say it
//     tools/dex --party --check       and hold the DV nibble order to the
//                                     stats the cartridge already worked out
//
// **This runs `gen2/romdata.js`.** Same rule as `tools/types` and `tools/route`
// before it: a second reader written in the tool agrees with the app's reader
// until it does not, and then the tool is a confident wrong answer that hides
// the bug it was written to find. So the entry printed here is byte for byte
// the entry the dex card draws, and `--verify` is a check *on* the app rather
// than beside it.
//
// What `--verify` is actually for. `EvosAttacks` is a pointer table into a run
// of variable-width records followed by a run of pairs, with a zero between
// them and no other structure -- and every way of misreading it produces
// *something*. Reading EVOLVE_STAT at three bytes instead of four shifts
// everything behind it and still decodes: TYROGUE comes back evolving into
// move ids at impossible levels, which is only obviously wrong if somebody
// looks at TYROGUE. So the checks below ask the decoded table whether it
// agrees with facts that predate this repository.
//
// **`--party` is the one that closes a gap rather than reporting one.** Two
// things about a party entry are written down here as the disassembly's word
// rather than as measurements -- which nibble of the DV word is which stat, and
// how the caught-data byte is packed -- because settling either needs a party
// whose numbers are already known. This is that, without a browser: a `.sav`
// holds the same struct the live game does, at `sGameData + (wAddr -
// wPlayerData)`, so `GameState` can read it unchanged.
//
// And `--check` settles the first of the two outright. The cartridge has
// already worked the six stats out and stored them beside the DVs that made
// them, so the DVs can be checked against their own consequences: recompute the
// stats from base, level, DV and stat experience, and see whether they come
// back. If they do not, try the other twenty-three orderings of the four
// nibbles and say which one does -- an answer rather than a failure.
//
// Needs a ROM and a symbol file in `dev/`, which are not in this repository and
// never will be; `--party` also needs a `.sav` there. Without them it says so
// and exits 0.
import { readFileSync, readdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';

import { RomData } from '../gen2/romdata.js';
import { engineOf, findSave, openCartridge } from './cartridge.mjs';
import { GameState } from '../gen2/state.js';
import { describeDex } from '../app/rows.js';
import { gen2 } from '../gen2/engine.js';

const HERE = dirname(fileURLToPath(import.meta.url));
const DEV = join(HERE, '..', 'dev');

// Whatever cartridge is in `dev/`, paired by name -- see tools/cartridge.mjs
// for why the pairing is the careful part and the globbing is not.
const cart = openCartridge(DEV);
if (!cart) process.exit(0);
const { rom, symbols, gb } = cart;
// The profile the app would pick for this cartridge, so a tool and the app
// read it the same way rather than two ways.
const { title, engine } = engineOf(cart);
const data = new RomData(symbols, gb, title ? title.encounters : [], engine);

// This cartridge's numbers, not Crystal's. The tool read every ROM as
// Crystal until the profile was picked above, and the arithmetic below is
// the other half of that: Polished Crystal's evolution records are four and
// five bytes where Crystal's are three and four, so an extent check using
// Crystal's widths called 176 correct records wrong.
const COUNT = engine.speciesCount;
// Case-folded, because a cartridge's own capitalisation is not a fact about
// Pokemon: Polished Crystal writes Quilava where Crystal writes QUILAVA, and
// a check comparing the strings said Cyndaquil does not evolve into it.
const same = (a, b) => String(a).toUpperCase() === String(b).toUpperCase();

/** A species id from a name or a number, or null. */
function speciesId(text) {
  const n = Number(text);
  if (Number.isInteger(n) && n >= 1 && n <= COUNT) return n;
  const want = String(text).toUpperCase().replace(/[^A-Z0-9]/g, '');
  for (let id = 1; id <= COUNT; id++) {
    if (data.speciesName(id).toUpperCase().replace(/[^A-Z0-9]/g, '') === want) {
      return id;
    }
  }
  return null;
}

const typed = (pair) => [...new Set(pair)].map((t) => data.typeName(t) || `type ${t}`).join('/');

/** One evolution record as a sentence. The tool's own wording, not the app's. */
function evoLine(rec) {
  const into = data.speciesName(rec.into);
  if (rec.kind === 'level') return `Lv${rec.level} → ${into}`;
  if (rec.kind === 'item') return `${data.itemName(rec.item) || `item ${rec.item}`} → ${into}`;
  if (rec.kind === 'trade') {
    const held = rec.item ? ` holding ${data.itemName(rec.item) || `item ${rec.item}`}` : '';
    return `traded${held} → ${into}`;
  }
  if (rec.kind === 'happiness') {
    const when = { anytime: '', morningDay: ' (morning or day)', night: ' (night)' };
    return `friendship${when[rec.when] ?? ` (${rec.when})`} → ${into}`;
  }
  if (rec.kind === 'stat') {
    const how = { atkOverDef: 'attack > defence', atkUnderDef: 'attack < defence',
                  atkEqualsDef: 'attack = defence' };
    return `Lv${rec.level} with ${how[rec.compare] ?? rec.compare} → ${into}`;
  }
  return `${rec.kind} → ${into}`;
}

function show(id, { at = null } = {}) {
  const base = data.baseStats(id);
  const ea = data.evosAttacks(id);
  const name = data.speciesName(id);
  if (!base) {
    console.log(`#${id} ${name} — no readable base-stats entry`);
    return;
  }
  const s = base.stats;
  console.log(`#${String(id).padStart(3)} ${name}   ${typed(base.types)}`);
  console.log(`     HP ${s.hp}  Atk ${s.atk}  Def ${s.def}  Spd ${s.spd}`
    + `  SpA ${s.satk}  SpD ${s.sdef}   (total ${Object.values(s).reduce((a, b) => a + b, 0)})`);
  console.log(`     catch rate ${base.catchRate} · base exp ${base.baseExp}`
    // The hatch cycles are null on a cartridge that packs them in a nibble
    // beside the gender ratio, which Polished Crystal does. Left out rather
    // than printed as "null cycles".
    + ` · ${base.growth}`
    + (base.hatch === null ? '' : ` · hatches in ${base.hatch} cycles`));
  if (!ea) {
    console.log('     no readable evolution/learnset entry');
    return;
  }
  console.log(`     evolves: ${ea.evolves.length ? ea.evolves.map(evoLine).join('; ') : 'never'}`);
  const moves = ea.learns.map((m) => ({ ...m, name: data.moveName(m.move) || `move ${m.move}` }));
  if (at === null) {
    console.log('     learns:');
    for (const m of moves) {
      console.log(`       Lv${String(m.level).padStart(2)}  ${m.name}`);
    }
    return;
  }
  const known = moves.filter((m) => m.level <= at);
  const next = moves.find((m) => m.level > at);
  console.log(`     at Lv${at} it would know: `
    + (known.length ? known.map((m) => m.name).join(', ') : 'nothing yet'));
  console.log(`     next: ${next ? `${next.name} at Lv${next.level} (${next.level - at} away)` : 'nothing more'}`);
  const soon = ea.evolves.filter((e) => e.level !== undefined && e.level > at);
  if (soon.length) {
    console.log(`     becomes: ${soon.map((e) => `${data.speciesName(e.into)} in ${e.level - at}`).join(', ')}`);
  }
}

/** One raw pointer out of `EvosAttacksPointers`, for the structural check. */
/**
 * How far it is to the next record after this address, or null.
 *
 * Every pointer in the table, sorted, so "the next record" is the next
 * *address* rather than the next species -- see the extent check. Null where
 * nothing follows, which is the last record in a bank and has no gap to
 * measure against.
 */
let sortedPointers = null;
function nextRecord(from) {
  if (!sortedPointers) {
    // **Every entry in the table, not every species.** The table ends where
    // its own first pointer lands -- the same self-description the reader
    // uses -- which on Crystal is 251 entries and on Polished Crystal is
    // 337: its 291 species and the 46 regional variants that also have
    // records. Counting only species left the variants' pointers out of
    // this list, and then "the next record" was the next *species*, with a
    // variant's whole entry inside the gap.
    const addr = symbols.addr('EvosAttacksPointers');
    const entries = Math.max(COUNT, (pointer(1) - addr) / 2);
    const all = new Set();
    for (let i = 1; i <= entries; i++) all.add(pointer(i));
    sortedPointers = [...all].sort((a, b) => a - b);
  }
  const next = sortedPointers.find((p) => p > from);
  return next === undefined ? null : next - from;
}

/** Whether any entry of the table points exactly here. */
function isPointer(at) {
  nextRecord(0);                               // builds the sorted list
  return sortedPointers.includes(at);
}

function pointer(id) {
  const bank = symbols.bank('EvosAttacksPointers');
  const addr = symbols.addr('EvosAttacksPointers');
  return gb.romByte(bank, addr + (id - 1) * 2)
    | (gb.romByte(bank, addr + (id - 1) * 2 + 1) << 8);
}

/**
 * Every species, against things that must be true.
 *
 * The point of each of these is that it fails on a *plausible* misreading
 * rather than on an obviously broken one. A shifted record still decodes; what
 * it stops doing is agreeing with the game.
 */
function verify() {
  const bad = [];
  const say = (msg) => bad.push(msg);
  let evolveCount = 0, learnCount = 0;
  const growths = new Set();
  const jumbled = new Set();
  // Records with nothing behind them to measure against -- the last one in a
  // bank. Counted rather than passed over silently: a check that quietly
  // stops applying is a check that stopped.
  let skipped = 0;
  // Records another entry points into the middle of -- a learnset shared
  // rather than copied. Counted and named, because it is a real property of
  // the table and not a thing to pass over.
  const shared_tails = new Set();

  for (let id = 1; id <= COUNT; id++) {
    const name = data.speciesName(id);
    const base = data.baseStats(id);
    if (!base) { say(`${name}: no base-stats entry`); continue; }
    growths.add(base.growth);
    for (const [k, v] of Object.entries(base.stats)) {
      // Every base stat in Gen 2 is between 1 and 255, and a zero is what a
      // reader landing one field early on a species with a low stat gets.
      if (!(v >= 1 && v <= 255)) say(`${name}: base ${k} is ${v}`);
    }
    const ea = data.evosAttacks(id);
    if (!ea) { say(`${name}: no evolution/learnset entry`); continue; }
    evolveCount += ea.evolves.length;
    learnCount += ea.learns.length;
    for (const e of ea.evolves) {
      if (!(e.into >= 1 && e.into <= COUNT)) {
        say(`${name}: evolves into #${e.into}, which is not a species`);
      }
      if (e.into === id) say(`${name}: evolves into itself`);
      if (e.level !== undefined && !(e.level >= 2 && e.level <= 100)) {
        say(`${name}: evolves at Lv${e.level}`);
      }
      if (e.kind === undefined) say(`${name}: an evolution with no kind`);
    }
    let last = 0;
    for (const m of ea.learns) {
      if (!(m.level >= 1 && m.level <= 100)) say(`${name}: learns at Lv${m.level}`);
      if (!(m.move >= 1 && m.move <= engine.moveCount)) {
        say(`${name}: learns move #${m.move}, which is not a move`);
      } else if (!data.moveName(m.move)) {
        say(`${name}: learns move #${m.move}, which has no name`);
      }
      // Not a failure. A learnset *usually* climbs, and out of order looks
      // exactly like a shifted read -- but MUK's entry is genuinely written
      // out of order on this cartridge (Lv45 SLUDGE sits in front of Lv23
      // MINIMIZE, verified against MukEvosAttacks byte for byte), and the game
      // does not care because it scans the whole list. So this is counted and
      // reported rather than failed, and the structural check below is what
      // actually catches a shift.
      if (m.level < last) jumbled.add(name);
      last = m.level;
    }

    // **The one check a shifted read cannot survive.** The pointers are
    // strictly ascending and the entries sit end to end behind them, so
    // species N's record must be exactly as long as the gap to species N+1's
    // pointer. Recomputed from the decoded record rather than from where the
    // reader stopped -- widths of the evolutions it found, two bytes per move
    // it found, and the two terminators -- so a record read at the wrong width
    // comes out the wrong length and says so, even when every field in it
    // looks plausible.
    if (id < COUNT) {
      const width = ea.evolves.reduce(
        (n, e) => n + engine.evo.bytes[engine.evo.kind[e.kind]], 0);
      // **The next record in address order, not the next species.** On
      // Crystal those are the same thing and this was written as
      // `pointer(id + 1)`. Polished Crystal indexes this table by species
      // *and non-cosmetic variant*, so Alolan Rattata's record sits between
      // Rattata's and Raichu's -- and the gap to the next species came out
      // at almost exactly twice the record, for all thirty-four species with
      // a regional form. The records sit end to end; they are just not in
      // the order the pointer list is.
      const want = nextRecord(pointer(id));
      // Everything but the trailing terminator, which is the part that can
      // be counted without knowing anything about what follows.
      const bare = width + 1 + ea.learns.length * 2;
      // Whether that terminator belongs to this record or the next one --
      // see `evo.sharedEnd`. Decided by where the *records* are rather than
      // by reading the byte: if another entry starts exactly where these
      // moves stop, the terminator sitting there is its "no evolutions"
      // marker doing double duty, and it is counted there. Reading the byte
      // instead said Girafarig shared one, because the byte four in is a
      // terminator and Farigiraf's entry points at it.
      const got = engine.evo.sharedEnd && isPointer(pointer(id) + bare)
        ? bare : bare + 1;
      if (want === null) {
        skipped++;
      } else if (got !== want) {
        // **A pointer inside a record is a shared tail, not a short read.**
        // Polished Crystal writes `FarigirafEvosAttacks:` four bytes into
        // Girafarig's entry, so Farigiraf has Girafarig's learnset without a
        // copy of it. Told apart from a misread by where this record *ends*:
        // a shared tail leaves the end landing exactly on another pointer,
        // and a record read at the wrong width does not.
        if (want < got && isPointer(pointer(id) + got)) shared_tails.add(name);
        else say(`${name}: decoded ${got} bytes and the next entry starts ${want} on`);
      }
    }
  }

  // Every species reading the same growth rate is exactly what byte 0x15 gives
  // instead of 0x16 -- a real rate, for everybody, which looks like an answer.
  if (growths.size < 2) {
    say(`every species has growth rate "${[...growths][0]}" — that is the`
      + ' signature of reading the wrong byte of the base-stats entry');
  }
  // And the sharper version of the same check: species whose experience curve
  // was known before this app existed. Nine rather than one, because a single
  // species agreeing with a wrong offset is exactly how the type field was
  // read out of the special defence -- one map agreeing perfectly with a false
  // rule is the shape this repository keeps getting caught by.
  //
  // PIDGEY is deliberately not in this list. It reads MEDIUM_SLOW here, which
  // contradicted the first guess at what it should be -- and the cartridge is
  // right: the Pidgey line is Medium Slow in Gen 2, and the other nine plus a
  // sane distribution (119 medium-fast, 64 medium-slow, 45 slow, 23 fast, and
  // the two "slightly" curves unused, as Gen 2 leaves them) is what settled it.
  const CURVES = [
    ['BULBASAUR', 'mediumSlow'], ['CHIKORITA', 'mediumSlow'],
    ['ABRA', 'mediumSlow'], ['CATERPIE', 'mediumFast'],
    ['PIKACHU', 'mediumFast'], ['MAGIKARP', 'slow'], ['DRATINI', 'slow'],
    ['CLEFAIRY', 'fast'], ['IGGLYBUFF', 'fast'],
  ];
  for (const [who, want] of CURVES) {
    const id = speciesId(who);
    const got = id ? data.baseStats(id) : null;
    if (!got) { say(`${who}: no base-stats entry`); continue; }
    if (got.growth !== want) {
      say(`${who} is on the ${want} curve and this reads ${got.growth}`);
    }
  }

  // Facts that predate this repository.
  const KNOWN = [
    ['CYNDAQUIL', (ea) => ea.evolves.length === 1 && ea.evolves[0].kind === 'level'
      && ea.evolves[0].level === 14 && same(data.speciesName(ea.evolves[0].into), 'QUILAVA'),
      'evolves into QUILAVA at Lv14'],
    ['TYROGUE', (ea) => ea.evolves.length === 3
      && ea.evolves.every((e) => e.kind === 'stat' && e.level === 20)
      && new Set(ea.evolves.map((e) => e.compare)).size === 3,
      'has three EVOLVE_STAT branches at Lv20'],
    // Written as "three stones and two friendships", which is Crystal's
    // Eevee rather than Pokemon's: Polished Crystal gives it eight stones, a
    // location and the friendship pair, and the check called a correct
    // decode wrong. What survives every version of the species is that it
    // has several evolutions and not one of them is by level.
    ['EEVEE', (ea) => ea.evolves.length >= 5
      && ea.evolves.every((e) => e.kind !== 'level'),
      'evolves several ways and never by level'],
    ['POLIWHIRL', (ea) => ea.evolves.some((e) => e.kind === 'trade' && e.item > 0),
      'evolves by trade holding an item'],
    ['MAGIKARP', (ea) => ea.evolves.length === 1 && ea.evolves[0].level === 20
      && same(data.speciesName(ea.evolves[0].into), 'GYARADOS'),
      'evolves into GYARADOS at Lv20'],
    ['MEGANIUM', (ea) => ea.evolves.length === 0, 'evolves into nothing'],
    ['SMOOCHUM', (ea) => ea.evolves.length === 1 && ea.evolves[0].kind === 'level',
      'evolves by level'],
  ];
  for (const [who, holds, what] of KNOWN) {
    const id = speciesId(who);
    if (!id) { say(`${who}: not in this cartridge's name table`); continue; }
    const ea = data.evosAttacks(id);
    if (!ea) { say(`${who}: no entry`); continue; }
    if (!holds(ea)) say(`${who} should be the one that ${what}, and is not`);
  }

  // The pointer table is the one thing the symbol file can settle on its own.
  for (const [who, label] of [['CYNDAQUIL', 'CyndaquilEvosAttacks'],
                              ['PIDGEY', 'PidgeyEvosAttacks']]) {
    if (!symbols.has(label)) continue;
    const id = speciesId(who);
    const { bank, addr } = { bank: symbols.bank('EvosAttacksPointers'),
                             addr: symbols.addr('EvosAttacksPointers') };
    const ptr = gb.romByte(bank, addr + (id - 1) * 2)
      | (gb.romByte(bank, addr + (id - 1) * 2 + 1) << 8);
    if (ptr !== symbols.addr(label)) {
      say(`${who}'s pointer is $${ptr.toString(16)} and ${label} is`
        + ` $${symbols.addr(label).toString(16)}`);
    }
  }

  for (const b of bad) console.log(`  ✗ ${b}`);
  if (bad.length) {
    console.log(`\n${bad.length} problem(s) over ${COUNT} species`);
    return 1;
  }
  console.log(`  ok  ${COUNT} species: ${evolveCount} evolutions and`
    + ` ${learnCount} level-up moves, all readable`);
  console.log(`  ok  ${growths.size} growth rates in use, and ${CURVES.length}`
    + ' species are on the curve they were on before this app existed');
  console.log(`  ok  ${KNOWN.length} species that were famous before this repo`
    + ' still are, and both pointers land on their own symbol');
  console.log('  ok  every entry is exactly as long as the gap to the next one,'
    + ' so nothing was read at the wrong width'
    + (skipped ? ` (${skipped} last-in-bank, nothing behind them to measure)` : ''));
  console.log(`  note ${jumbled.size} species write their learnset out of level`
    + ` order: ${[...jumbled].join(', ') || 'none'}`);
  if (shared_tails.size) {
    console.log(`  note ${shared_tails.size} species have their learnset shared`
      + ` by an entry pointing into the middle of it:`
      + ` ${[...shared_tails].join(', ')}`);
  }
  return 0;
}

// --- a party out of a battery ------------------------------------------------

const SRAM_START = 0xa000, SRAM_BANK = 0x2000, WRAM_START = 0xc000;

/** The flat offset of an SRAM symbol inside a .sav. */
function sramAt(name) {
  return symbols.bank(name) * SRAM_BANK + (symbols.addr(name) - SRAM_START);
}

/**
 * A work-RAM snapshot built out of a battery save.
 *
 * The whole point of doing it this way: `GameState` is handed the same shape it
 * reads from a running game, so what comes out is the app's reading and not a
 * second one. The mapping is the save file's own -- `sGameData` holds what
 * `wPlayerData` onwards held when the game was saved, byte for byte -- and it
 * is bounded by `sGameDataEnd` so a symbol outside the saved block reads as
 * zero rather than as whatever is next in the file.
 */
function wramFromSave(sav) {
  const from = sramAt('sGameData'), to = sramAt('sGameDataEnd');
  const base = symbols.addr('wPlayerData');
  const wram = new Uint8Array(0x2000);
  for (let at = from; at < to && at < sav.length; at++) {
    const w = base + (at - from);
    if (w >= WRAM_START && w < WRAM_START + wram.length) {
      wram[w - WRAM_START] = sav[at];
    }
  }
  return wram;
}

/** The newest `.sav` in dev/, or null. */
/**
 * Gen 2's own stat formula, for checking the DVs against their consequences.
 *
 * Not in the app, and deliberately: the game has already done this arithmetic
 * and stored the answer, so a copy in `state.js` would be a second source of a
 * number the cartridge supplies. It is here because a *check* needs an
 * independent derivation, which is the same reason `tools/types --verify`
 * asserts matchups nobody read out of the chart.
 *
 * The stat-experience term is `floor(min(255, ceil(sqrt(exp))) / 4)`.
 */
function statFrom(base, dv, statExp, level, isHp) {
  const root = Math.min(255, Math.ceil(Math.sqrt(statExp)));
  const inner = (base + dv) * 2 + (root >> 2);
  const n = Math.floor((inner * level) / 100);
  return isHp ? n + level + 10 : n + 5;
}

/** Every ordering of the four DV nibbles, as [name...] lists. */
function nibbleOrders(names) {
  if (names.length <= 1) return [names];
  const out = [];
  for (let i = 0; i < names.length; i++) {
    const rest = names.filter((_, k) => k !== i);
    for (const tail of nibbleOrders(rest)) out.push([names[i], ...tail]);
  }
  return out;
}

/** Read the DV word back out of a mon, under a given nibble order. */
function dvsUnder(word, order) {
  const out = {};
  order.forEach((key, i) => {
    out[key] = (word >> ((order.length - 1 - i) * 4)) & 0x0f;
  });
  out.hp = order.reduce((n, key) => (n << 1) | (out[key] & 1), 0);
  return out;
}

/**
 * Does this ordering reproduce every stat the cartridge stored?
 *
 * Returns the number of the six stats it gets right, summed over the party --
 * a count rather than a boolean, so a near miss can be told from nonsense.
 */
function scoreOrder(mons, order) {
  let right = 0, total = 0;
  for (const { mon, base } of mons) {
    const dvs = dvsUnder(mon.dvWord, order);
    for (const key of engine.statNames) {
      const src = engine.statSource[key];
      total++;
      const want = mon.stats[key];
      const got = statFrom(base.stats[key], dvs[src], mon.statExp[src],
                           mon.level, key === 'hp');
      if (want === got) right++;
    }
  }
  return { right, total };
}

function party({ check = false } = {}) {
  const file = findSave(DEV);
  if (!file) {
    console.log('no .sav in dev/ and no DEV_SAV — nothing to read');
    console.log('(a save is not in this repository either)');
    return 0;
  }
  const sav = readFileSync(file);
  // The picked profile, not the stock one: a hack that moved its party
  // fields or changed its save-check digit is read the way the app
  // would read it, which is the whole point of a tool like this.
  const state = new GameState(symbols, engine);
  if (!state.saveIsPresent(sav)) {
    console.log(`${file}: the cartridge would not load this — no save markers`);
    return 1;
  }
  const wram = wramFromSave(sav);
  const mons = [];
  for (let slot = 0; slot < state.partyCount(wram); slot++) {
    const mon = state.monDetail(wram, slot);
    if (!mon) break;
    // The raw word too, so `--check` can re-split it a different way without
    // going back through the reader it is checking.
    const at = symbols.addr('wPartyMon1') + slot * engine.partyStride
      + engine.mon.dvs - 0xc000;
    mon.dvWord = (wram[at] << 8) | wram[at + 1];
    mons.push({ mon, base: data.baseStats(mon.species) });
  }
  if (!mons.length) {
    console.log('the save holds no party');
    return 0;
  }

  for (const { mon } of mons) {
    // The app's own words, so this prints what the card prints.
    // The picked profile, so a cartridge with six stat counters instead
    // of Crystal's five shared ones prints all six.
    const d = describeDex(mon, { rom: data, engine });
    console.log(`\n${d.name} Lv${d.level}   ${d.types.join('/')}`
      + `   ${mon.hp}/${mon.maxHp}`);
    console.log('     stat    now   DV   trained');
    for (const st of d.stats) {
      console.log(`     ${st.label.padEnd(7)} ${String(st.value).padStart(3)}`
        + `   ${String(st.dv).padStart(2)}   ${st.effort}`);
    }
    if (d.knows.length) {
      console.log(`     knows   ${d.knows.map((m) => `${m.name} ${m.pp}`).join(', ')}`);
    }
    if (d.next) console.log(`     next    ${d.next}`);
    for (const phrase of d.becomes) console.log(`     becomes ${phrase}`);
    if (d.origin) console.log(`     ${d.origin}`);
    if (d.extra) console.log(`     ${d.extra}`);
  }

  if (!check) return 0;
  // **This arithmetic is Gen 2's**, and a cartridge that modifies stats
  // another way cannot be held to it -- see `statsAreGen2`. Saying "no
  // ordering fits" about Polished Crystal would blame the reader for a
  // nature multiplier.
  if (!engine.statsAreGen2) {
    console.log('\n--- the DVs against the stats they made ---');
    console.log('  this cartridge does not compute a stat the way Gen 2 does'
      + ' — its profile says so — so the DVs cannot be checked against it here');
    return 0;
  }

  console.log('\n--- the DVs against the stats they made ---');
  if (mons.some((m) => !m.base)) {
    console.log('  a species with no readable base stats — cannot check');
    return 1;
  }
  const orders = nibbleOrders(engine.dvNames);
  const scored = orders.map((order) => ({ order, ...scoreOrder(mons, order) }));
  const mine = scored.find((s) => s.order.join() === engine.dvNames.join());
  const best = scored.reduce((a, b) => (b.right > a.right ? b : a));
  const perfect = scored.filter((s) => s.right === s.total);

  console.log(`  the profile's order ${engine.dvNames.join(', ')}`
    + ` reproduces ${mine.right} of ${mine.total} stored stats`);
  if (mine.right === mine.total && perfect.length === 1) {
    console.log('  ok  and it is the only one of the 24 orderings that does —'
      + ' the nibble order is measured now, not assumed');
    return 0;
  }
  if (mine.right === mine.total) {
    console.log(`  note ${perfect.length} orderings fit these ${mons.length}`
      + ' Pokemon. A bigger or more varied party would tell them apart:');
    for (const s of perfect) console.log(`       ${s.order.join(', ')}`);
    return 0;
  }
  console.log(`  ✗ it does not. The best of the 24 is`
    + ` ${best.order.join(', ')} at ${best.right} of ${best.total}.`);
  if (best.right < best.total) {
    console.log('    No ordering fits, so the disagreement is not the nibble'
      + ' order — suspect the stat-experience term or the base-stats offsets.');
  }
  return 1;
}

const args = process.argv.slice(2);
if (args.includes('--verify')) {
  process.exit(verify());
}
if (args.includes('--party')) {
  process.exit(party({ check: args.includes('--check') }));
}

const evolvesAt = args.indexOf('--evolves');
if (evolvesAt >= 0) {
  const want = Number(args[evolvesAt + 1]);
  let n = 0;
  for (let id = 1; id <= COUNT; id++) {
    const ea = data.evosAttacks(id);
    for (const e of (ea ? ea.evolves : [])) {
      if (e.level === want) {
        console.log(`  ${data.speciesName(id).padEnd(11)} → ${data.speciesName(e.into)}`);
        n++;
      }
    }
  }
  console.log(`\n${n} species evolve at Lv${want}`);
  process.exit(0);
}

const atFlag = args.indexOf('--at');
const at = atFlag >= 0 ? Number(args[atFlag + 1]) : null;
const rest = args.filter((a, i) => !a.startsWith('--')
  && !(atFlag >= 0 && i === atFlag + 1));

if (!rest.length) {
  console.log('name a species: tools/dex cyndaquil   (or --verify, --evolves 20)');
  process.exit(1);
}
for (const word of rest) {
  const id = speciesId(word);
  if (!id) { console.log(`no species called "${word}"`); continue; }
  show(id, { at });
}
