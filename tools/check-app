#!/usr/bin/env python3
"""Static checks for the app, all runnable without a ROM.

Nothing here drives the emulator: that needs a ROM built from the pokecrystal
disassembly, which is not distributed. These are the checks that can run on a
clean checkout, which is exactly what CI has.

    tools/check-app            run everything
    tools/check-app syntax     just one group
"""
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
# Shared with `tools/rom-events`, for the same reason `counts.py` is shared with
# `tools/renumber`: two readers of one directory that disagreed about which
# cartridge is current would be worse than either.
import cartridge  # noqa: E402
ROOT = HERE.parent
# The app's own source, in dependency order: each directory may import from the
# ones before it and from none after. Stated here as a list rather than found by
# globbing, because the order is the design and a checker that discovers it
# cannot enforce it.
LAYERS = ["gbcore", "gen2", "titles", "app"]
APP = sorted((f for d in LAYERS for f in (ROOT / d).glob("*.js")),
             key=lambda p: (p.parent.name, p.name))
# Code copied in from another repo of ours (kidsync's canonical copy lives in
# ../kidsync, and its own tools/check is what catches edits in place). What this
# repo has to enforce is narrower and its own business: that the copies are in
# the offline shell.
VENDORED = sorted(f for d in ("sync", "baton") for f in (ROOT / d).glob("*.js"))
# The vendored stylesheet, which is somebody else's and is read rather than
# edited: what this repo has to know about it is what it already draws, so that
# nothing here draws the same thing twice.
VENDORED_CSS = sorted((ROOT / "vendor").glob("*.css"))
INDEX = ROOT / "index.html"
SW = ROOT / "sw.js"

def module(name):
    """One module by file name, wherever it lives now.

    The checks that read a specific module by hand said `app/romdata.js`, which
    was true while there was one source directory and is a silent skip once
    there are four -- a missing file read as empty text finds nothing wrong.
    """
    for path in APP:
        if path.name == name:
            return path
    raise SystemExit(f"check-app: {name} is not in any of {', '.join(LAYERS)}")


def rel(path):
    """A module's path as the page asks for it: `gen2/state.js`."""
    return f"{path.parent.name}/{path.name}"


GAME_FILES = re.compile(r"\.(gbc|gb|sav|sym|state|bk2)$", re.I)


def fail(msg):
    print(f"  FAIL  {msg}")
    return 1


def ok(msg):
    print(f"  ok    {msg}")
    return 0


def check_syntax():
    """Parse every module.

    Copied to .mjs first, and that is not fussiness. Measured on node v24:
    `node --check` on a *.js* file containing a syntax error exits 0 -- it does
    not report the error at all, presumably because module detection makes the
    parse ambiguous. The same content as .mjs exits 1. Checking the .js files
    directly would be a green light that means nothing.
    """
    if not shutil.which("node"):
        return fail("node not found, cannot check syntax")
    bad = []
    with tempfile.TemporaryDirectory() as tmp:
        for src in APP + [SW]:
            dst = pathlib.Path(tmp) / (src.stem + ".mjs")
            dst.write_text(src.read_text())
            r = subprocess.run(["node", "--check", str(dst)],
                               capture_output=True, text=True)
            if r.returncode != 0:
                # The useful line, not the last one -- node ends its output with
                # its own version banner, so [-1] reports "Node.js v24.8.0" as
                # though that were the syntax error.
                lines = [l.strip() for l in r.stderr.splitlines() if l.strip()]
                why = next((l for l in lines if "Error" in l), None) \
                    or (lines[0] if lines else "parse failed")
                bad.append(f"{src.relative_to(ROOT)}: {why}")
    for b in bad:
        print(f"        {b}")
    return fail(f"{len(bad)} module(s) do not parse") if bad \
        else ok(f"{len(APP) + 1} modules parse")


def check_shell():
    """The service worker's cached shell must match what is on disk.

    Both directions. A file listed but absent makes the install reject, which
    takes the whole offline story with it; a module present but unlisted is
    served from the network and silently breaks offline use -- which is how
    app/world.js was nearly shipped when it was added.
    """
    text = SW.read_text()
    m = re.search(r"const SHELL = \[(.*?)\];", text, re.S)
    if not m:
        return fail("could not find SHELL in sw.js")
    listed = set(re.findall(r"'\./([^']*)'", m.group(1)))
    problems = []
    for path in sorted(listed):
        if path and not (ROOT / path).exists():
            problems.append(f"listed in SHELL but missing on disk: {path}")
    for src in APP:
        if rel(src) not in listed:
            problems.append(f"on disk but not in SHELL: {rel(src)}")
    # Vendored modules too. They are ordinary same-origin files the app imports,
    # so an unlisted one is served from the network and breaks offline use in
    # exactly the way app/world.js nearly did -- and being someone else's code
    # makes it *more* likely to be forgotten, not less.
    for src in VENDORED:
        if rel(src) not in listed:
            problems.append(f"vendored but not in SHELL: {rel(src)}")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} shell mismatch(es)") if problems \
        else ok(f"service worker shell lists all {len(listed)} files, and all exist")


def check_markup():
    s = INDEX.read_text()
    # **Comments are not markup, and prose about markup reads like markup.**
    # This counted a `<use>` written inside an HTML comment that *described*
    # the sprite sheet, and reported the document unbalanced by one. That is
    # the fourth time in one session that prose mentioning a construct has been
    # parsed as the construct -- the mutation tool needed a masker for the same
    # reason, the documentation-link check needed one for code spans, and the
    # contrast check split on a selector name that appeared in a comment. The
    # pattern is worth naming: **a checker that reads source has to know which
    # parts of it are addressed to people.**
    #
    # Stripped for the tag count only. The CSS brace count below reads the
    # style block, where a `{` inside a comment would be a different bug and
    # one this has never seen.
    s = re.sub(r"<!--.*?-->", "", s, flags=re.S)
    void = {"br", "img", "link", "meta", "input", "hr", "source", "area",
            "base", "col", "embed", "param", "track", "wbr", "use", "path",
            "circle", "rect", "line", "polyline", "polygon", "ellipse",
            "stop"}
    opened = re.findall(r"<([a-zA-Z][a-zA-Z0-9]*)[^>]*?(?<!/)>", s)
    closed = re.findall(r"</([a-zA-Z][a-zA-Z0-9]*)\s*>", s)
    counts = {}
    for t in opened:
        if t.lower() not in void:
            counts[t.lower()] = counts.get(t.lower(), 0) + 1
    for t in closed:
        counts[t.lower()] = counts.get(t.lower(), 0) - 1
    bad = {k: v for k, v in counts.items() if v}
    if bad:
        return fail(f"unbalanced tags in index.html: {bad}")
    css = s.split("<style>")[1].split("</style>")[0]
    if css.count("{") != css.count("}"):
        return fail(f"unbalanced CSS braces: {css.count('{')} open, "
                    f"{css.count('}')} close")
    return ok("index.html tags and CSS braces balance")


# --- contrast ---------------------------------------------------------------
# Encoded rather than re-measured by hand. Every one of these was checked once
# against the running app; without them written down, the next palette edit
# quietly undoes the work. The thresholds are WCAG: 4.5 for text, 3.0 for a
# boundary that carries meaning on its own, and a small ratio for a surface
# step that only has to be perceptible.
PAIRS = [
    ("ink on the page",        "ink",   "bg",     4.5),
    ("ink on a card",          "ink",   "panel",  4.5),
    ("ink on a raised button", "ink",   "raise",  4.5),
    ("dim text on a card",     "dim",   "panel",  4.5),
    ("dim text on the page",   "dim",   "bg",     4.5),
    # The pad's labels sit on a *key*, not on the card behind it -- and this
    # watched `raise` for thirty-seven passes, which is the surface the key is
    # *on*. Measured when the pad was restyled: in the dark theme `--key` and
    # `--raise` were the same colour, so the check was passing on a comparison
    # of a token with itself while the pad had no edge at all.
    ("key ink on a key",       "key-ink",   "key",   4.5),
    # **The key's *edge*, not its fill.** The first draft of these watched
    # `key` against `raise` at 3:1, and that bar cannot be met in the dark
    # theme without a pad that glows: two dark greys a card apart do not reach
    # 3:1, and a real handheld at night does not either. What has to be seen is
    # where a key ends, and that is carried by a drawn edge -- so the edge is
    # what is guarded, and it is cheap to satisfy in both themes.
    ("a key's edge on its well", "key-edge", "raise", 3.0),
    ("Stop label on a card",   "bad",   "panel",  4.5),
    ("link on a card",         "accent", "panel", 4.5),
    ("running dot on a card",  "accent", "panel", 3.0),
    ("filled control vs card", "action", "panel", 3.0),
]
WHITE_ON = [("white label on a filled control", "action", 4.5)]


def _lum(hex_):
    h = hex_.lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))

    def f(c):
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b)


def _ratio(a, b):
    la, lb = _lum(a), _lum(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def _tokens(block):
    """`--name: #hex` pairs in a block, and `--name: var(--other)` too.

    The second half is not a nicety. The light palette used to be written out
    twice -- once for `[data-theme="light"]`, once for the `prefers-color-scheme`
    media query -- and the two drifted the moment anything touched them. It is
    written once now and both switches *map* it, which means the light block
    holds no hex at all: this function found nothing there, the caller fell back
    to the dark values, and the check went on reporting "both themes" while
    reading one of them twice. A check that quietly stops checking is worse than
    no check.
    """
    out = dict(re.findall(r"--([\w-]+)\s*:\s*(#[0-9a-fA-F]{3,6})", block))
    out.update(dict(re.findall(r"--([\w-]+)\s*:\s*var\(--([\w-]+)\)", block)))
    return out


def _resolve(tokens, base):
    """Follow `--a: var(--b)` until it lands on a colour, or give up saying so."""
    out = {}
    for name in tokens:
        seen, value = set(), name
        while value in tokens and not str(tokens[value]).startswith("#"):
            if value in seen:
                break
            seen.add(value)
            value = tokens[value]
        if str(tokens.get(value, "")).startswith("#"):
            out[name] = tokens[value]
        elif str(base.get(value, "")).startswith("#"):
            out[name] = base[value]
    return out


def check_contrast():
    s = INDEX.read_text()
    css = s.split("<style>")[1].split("</style>")[0]
    root = _tokens(css.split(":root {")[1].split("}")[0])
    dark = _resolve(root, root)
    # The *selector*, brace and all. Splitting on `[data-theme="light"]` alone
    # matched a comment in the stylesheet that mentions it -- so `light_block`
    # became the tail of `:root` and the comparison below reported fifteen
    # phantom mismatches. Prose about code reads like code, which is the third
    # time that has cost this repository something.
    light_block = css.split(':root[data-theme="light"] {')[1].split("}")[0]
    merged = dict(root)
    merged.update(_tokens(light_block))
    light = _resolve(merged, root)

    # **The two light switches have to say the same thing.** There are two --
    # the explicit `[data-theme="light"]` and the `prefers-color-scheme` media
    # query -- because CSS cannot put a media query in a selector list. Only
    # one of them can be read above, so the other is held to it by comparison:
    # the theme most people get is the media query, and it is the one that was
    # silently wrong when these were written out separately.
    media = css.split(':root:not([data-theme="dark"]) {')[1].split("}")[0]
    if _tokens(media) != _tokens(light_block):
        only_a = sorted(set(_tokens(light_block)) - set(_tokens(media)))
        only_b = sorted(set(_tokens(media)) - set(_tokens(light_block)))
        print("        the two light theme blocks do not match"
              + (f"; only in [data-theme]: {', '.join(only_a)}" if only_a else "")
              + (f"; only in the media query: {', '.join(only_b)}" if only_b else ""))
        return fail("the light palette is written two different ways")

    problems = []
    for label, themes in (("dark", dark), ("light", light)):
        for name, fg, bg, need in PAIRS:
            if fg not in themes or bg not in themes:
                problems.append(f"{label}: no token for {fg} or {bg} ({name})")
                continue
            r = _ratio(themes[fg], themes[bg])
            if r < need:
                problems.append(f"{label}: {name} is {r:.2f}:1, needs {need}")
        for name, fg, need in WHITE_ON:
            r = _ratio("#ffffff", themes[fg])
            if r < need:
                problems.append(f"{label}: {name} is {r:.2f}:1, needs {need}")
    for p in problems:
        print(f"        {p}")
    n = (len(PAIRS) + len(WHITE_ON)) * 2
    return fail(f"{len(problems)} contrast failure(s)") if problems \
        else ok(f"{n} colour pairs meet contrast, both themes")


def check_no_game_files():
    r = subprocess.run(["git", "ls-files"], cwd=ROOT,
                       capture_output=True, text=True)
    bad = [f for f in r.stdout.split() if GAME_FILES.search(f)]
    for b in bad:
        print(f"        {b}")
    return fail(f"{len(bad)} game-derived file(s) are tracked") if bad \
        else ok("no ROM, save or symbol file is tracked")


# The eleven moves whose power byte says 0 or 1 while the move takes half the
# bar, your level in HP, or all of it. Ranking by power to find something gentle
# puts every one of them ahead of TACKLE, so weakening would open with
# GUILLOTINE. Effect ids read out of the ROM's own move table, not counted from
# the disassembly's const_def order.
UNGENTLE = {
    "GUILLOTINE", "HORN_DRILL", "FISSURE", "SUPER_FANG",
    "SEISMIC_TOSS", "NIGHT_SHADE", "PSYWAVE", "COUNTER", "MIRROR_COAT",
}
# Real fixed damage, which does encode itself as power and so ranks correctly.
GENTLE_ENOUGH = {"TACKLE", "SCRATCH", "EMBER", "DRAGON_RAGE", "SONICBOOM"}


def check_moves():
    """Drive the app's own lethal-effect list against a real cartridge.

    Skipped without a ROM, which is the case on CI and on a clean checkout --
    the point of the skip is that this check can exist at all without anything
    game-derived entering the repo. It matters because the alternative is
    trusting a hand-written table of effect ids, and getting one wrong picks a
    one-hit KO as the gentlest move available.

    **Asked of the cartridge, not of a source tree.** This used to read move
    *order* out of `~/projects/pokecrystal/data/moves/moves.asm` and index a
    hack's ROM with it, which is Crystal's ordering against another
    cartridge's table -- and it read every entry at seven bytes, where
    Polished Crystal's move struct is eight, having added a category byte. It
    reported nineteen problems about a table it was misreading twice over.
    The ROM names its own moves; `MoveNames` is right there.

    **And it no longer asserts the effect *number*.** "GUILLOTINE is effect
    38" is a fact about Crystal. What the app actually needs is that every
    move whose damage ignores the power byte is in `lethalEffects`, whatever
    that cartridge numbers it -- and that a move the cartridge does not have
    is not a failure. Polished Crystal has no one-hit-KO moves at all.
    """
    rom_path, sym_path = cartridge.cartridge_paths(ROOT)
    if not rom_path or not sym_path:
        print("  skip  move ranking (no cartridge in dev/)")
        return 0

    script = (
        "import('%s/tools/cartridge.mjs').then(async (c) => {"
        "  const { RomData } = await import('%s/gen2/romdata.js');"
        "  const cart = c.openCartridge('%s/dev');"
        "  const { engine } = c.engineOf(cart);"
        "  const rom = new RomData(cart.symbols, cart.gb, [], engine);"
        "  const out = {};"
        "  for (let i = 1; i <= engine.moveCount; i++) {"
        "    const n = rom.moveName(i), m = rom.move(i);"
        "    if (n && m) out[n.toUpperCase().replace(/[^A-Z0-9]/g, '')] ="
        "      [m.effect, m.power];"
        "  }"
        "  process.stdout.write('\\n@@' + JSON.stringify("
        "    { moves: out, lethal: engine.lethalEffects }));"
        "});" % (ROOT, ROOT, ROOT)
    )
    try:
        got = subprocess.run(["node", "-e", script], capture_output=True,
                             text=True, timeout=120)
        line = [l for l in got.stdout.splitlines() if l.startswith("@@")]
        found = json.loads(line[-1][2:]) if line else None
    except Exception as e:
        return fail(f"could not read the move table: {e}")
    if not found:
        return fail("could not read the move table from this cartridge")
    moves, declared = found["moves"], set(found["lethal"])

    # The names here are written the disassembly's way, with underscores;
    # the ROM says "HORN DRILL". Both sides are stripped to letters and
    # digits, which is also what makes a cartridge that writes "Horn Drill"
    # answer -- five of these read as absent from Crystal itself until this.
    flat = lambda n: re.sub(r"[^A-Z0-9]", "", n.upper())
    problems, seen, absent = [], 0, 0
    for raw in UNGENTLE:
        name = flat(raw)
        if name not in moves:
            # A move this cartridge does not have. Not a failure: Polished
            # Crystal removed the one-hit-KO moves outright.
            absent += 1
            continue
        effect, power = moves[name]
        seen += 1
        if effect not in declared:
            problems.append(f"{name} (effect {effect}, power {power}) would be "
                            f"picked as a gentle move")
    for raw in GENTLE_ENOUGH:
        name = flat(raw)
        if name not in moves:
            continue
        effect, power = moves[name]
        if power <= 0 or effect in declared:
            problems.append(f"{name} (effect {effect}, power {power}) is "
                            f"excluded, leaving nothing to weaken with")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} move-ranking problem(s)") if problems \
        else ok(f"{seen} lethal moves excluded from weakening, "
                f"{len(GENTLE_ENOUGH)} kept"
                + (f", {absent} not in this cartridge" if absent else ""))


# The only names the core's setJoypadState understands. A name it does not know
# is not an error: the key is set on an object the core ignores, so the press
# runs, takes its frames, and does nothing at all.
BUTTONS = {"UP", "DOWN", "LEFT", "RIGHT", "A", "B", "START", "SELECT"}
PRESS_CALL = re.compile(r"\.(?:press|hold|release)\(\s*'([A-Za-z]+)'")


def check_buttons():
    """Every button name handed to press/hold/release is one the core knows.

    Worth a check of its own because getting it wrong is silent. `press('Start')`
    parses, runs, waits its frames and has no effect -- the core is handed
    {Start: true}, sees no key it recognises, and leaves the joypad alone. The
    save driver was written with 'Start' and 'Down' and failed with "could not
    get the game to save", which points at the menu rather than at the presses.
    """
    problems = []
    for path in APP + [INDEX]:
        for n, line in enumerate(path.read_text().splitlines(), 1):
            for name in PRESS_CALL.findall(line):
                if name not in BUTTONS:
                    problems.append(f"{path.name}:{n}  {name!r} is not a button")
    # The on-screen pad is where the canonical spelling comes from, so make
    # sure that agrees too rather than trusting the set above.
    markup = set(re.findall(r'data-btn="([A-Za-z]+)"', INDEX.read_text()))
    unknown = markup - BUTTONS
    for u in sorted(unknown):
        problems.append(f"index.html  data-btn={u!r} is not a button")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} bad button name(s)") if problems \
        else ok(f"all button names are among {len(BUTTONS)} the core knows")


SELECTOR = re.compile(r"\$\('#([\w-]+)'\)")
# `from './state.js'` and `from '../gen2/state.js'` both, because the second
# shape appears the moment there is more than one source directory -- and a
# pattern that only matches the first does not fail, it stops checking. The
# resolved file name is what the export table is keyed on.
IMPORT_NAMED = re.compile(
    r"import\s*\{([^}]*)\}\s*from\s*'((?:\.\./[\w-]+/|\./)[\w.]+)'")
EXPORT_DECL = re.compile(r"^export\s+(?:async\s+)?(?:class|function|const|let)\s+([A-Za-z_$][\w$]*)", re.M)
EXPORT_LIST = re.compile(r"^export\s*\{([^}]*)\}", re.M)


def check_wiring():
    """Every $('#id') exists in the markup, and every import is really exported.

    Both are the same kind of mistake: a name that parses fine and is wrong at
    run time. `node --check` cannot see either, and neither can a reading of one
    file -- they only show up when the app runs, which for a phone app means
    when someone presses the button. A constant that lived in two modules once
    reached a user as a plain ReferenceError the first time a catch ran.
    """
    ids = set(re.findall(r'id="([\w-]+)"', INDEX.read_text()))
    problems = []
    for path in APP:
        text = path.read_text()
        for n, line in enumerate(text.splitlines(), 1):
            for sel in SELECTOR.findall(line):
                if sel not in ids:
                    problems.append(f"{rel(path)}:{n}  $('#{sel}') is not in index.html")

    # Keyed on the resolved path, not the file name: two source directories may
    # one day hold the same name, and vendored modules belong in here too --
    # `room.js` imports createBaton from ../baton/baton.js, and that is exactly
    # the kind of name this check exists to confirm.
    exports = {}
    for path in APP + VENDORED:
        text = path.read_text()
        names = set(EXPORT_DECL.findall(text))
        for block in EXPORT_LIST.findall(text):
            for part in block.split(","):
                name = part.strip().split(" as ")[-1].strip()
                if name:
                    names.add(name)
        exports[path.resolve()] = names
    for path in APP:
        for block, spec in IMPORT_NAMED.findall(path.read_text()):
            target = (path.parent / spec).resolve()
            for part in block.split(","):
                want = part.strip().split(" as ")[0].strip()
                if not want:
                    continue
                if not target.exists():
                    problems.append(f"{rel(path)}  imports {spec}, which is not a file")
                elif target not in exports:
                    problems.append(f"{rel(path)}  imports from {spec}, which is not a module here")
                elif want not in exports[target]:
                    problems.append(f"{rel(path)}  imports {want!r} from {spec}, "
                                    f"which does not export it")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} wiring problem(s)") if problems \
        else ok(f"{len(ids)} markup ids and every import resolve")


# Two shapes, because the app has two. Most modules call symbols.addr('X')
# directly; romdata.js wraps the pair in `this.at = (name) => ...` and calls
# `this.at('ItemNames')`, which the first pattern cannot see -- and did not,
# until a device with no .sym file booted to "symbol not in this .sym file:
# ItemNames" while every check here passed.
SYMBOL_USE = re.compile(
    r"\b(?:symbols|sym)\.(?:addr|bank|has)\('([A-Za-z_]\w*)'\)"
    r"|\bat\('([A-Za-z_]\w*)'\)")
# `pick` and `hasAny` take several names -- one thing a cartridge might call
# more than one word -- so every argument is a lookup and the pattern above,
# which stops at the first, would share one name of each pair.
SYMBOL_PICK = re.compile(
    r"\b(?:symbols|sym)\.(?:pick|hasAny)\(([^)]*)\)", re.S)
SYMBOL_LIST = re.compile(
    r"const NEEDED_SYMBOLS = \[(.*?)\];|require\(\[(.*?)\]\)"
    # The party layout is asked for through a table of names rather than at
    # a call site, and every one of them has to travel: a layout derived from
    # the .sym and defaulted from the profile gives a phone with the file one
    # dex card and a phone with a digest another.
    r"|const MON_FIELDS = \{(.*?)\};", re.S)


def check_symbols():
    """Every symbol the app looks up is one it can hand to another device.

    app/symbols.js carries the list of names a digest is built from, because a
    device with a ROM and no .sym is given those addresses instead of the file.
    Nothing at run time can know which names the code will ask for, so the list
    is written by hand -- and a hand-written list of 45 things is exactly what
    rots the first time someone adds a lookup.

    What rot costs here is worth spelling out: the app keeps working perfectly
    on every device that has the .sym file, and throws "symbol not in this .sym
    file" only on the one that was handed a digest. That is a failure that
    reaches a person on their second phone, hours later, having passed every
    check on the machine it was written on.
    """
    src = module("symbols.js").read_text()
    m = re.search(r"SHARED_SYMBOLS = \[(.*?)\];", src, re.S)
    if not m:
        return fail("app/symbols.js has no SHARED_SYMBOLS list")
    shared = set(re.findall(r"'([A-Za-z_]\w*)'", m.group(1)))

    used = set()
    for path in APP:
        text = path.read_text()
        for a, b in SYMBOL_USE.findall(text):
            used.add(a or b)
        for group in SYMBOL_PICK.findall(text):
            used |= set(re.findall(r"'([A-Za-z_]\w*)'", group))
        for parts in SYMBOL_LIST.findall(text):
            used |= set(re.findall(r"'([A-Za-z_]\w*)'", "".join(parts)))

    # One direction only. A name in the list that nothing looks up costs about
    # twenty-five bytes in a digest; a name looked up that is not in the list
    # costs a device with no .sym file the whole app. Those are not the same
    # size of mistake, and requiring exact equality would mean an exemption for
    # every symbol reached through a filter or a variable.
    problems = [f"{n} is looked up but not in SHARED_SYMBOLS" for n in sorted(used - shared)]
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} symbol list problem(s)") if problems \
        else ok(f"all {len(shared)} shared symbols are the ones the app reads")


def check_version():
    """app/version.js and the service worker's cache name say the same thing.

    The version row exists so a person can tell whether they are running the
    build they think they are. That only works if the number is true, and it is
    written in two files: the module the page reports, and the cache name a
    deploy bumps. Nothing but this stops them drifting -- and a version display
    that lies is worse than none, because it turns "am I out of date?" from an
    open question into a wrong answer.
    """
    mod = module("version.js").read_text()
    m = re.search(r"VERSION\s*=\s*'(v\d+)'", mod)
    if not m:
        return fail("app/version.js has no VERSION = 'vNN'")
    sw = re.search(r"crystal-pilot-(v\d+)", SW.read_text())
    if not sw:
        return fail("sw.js has no crystal-pilot-vNN cache name")
    if m.group(1) != sw.group(1):
        print(f"        app/version.js says {m.group(1)}, "
              f"sw.js says {sw.group(1)}")
        return fail("the version and the cache name disagree")

    # And it is on screen without a ROM. The display spent three versions
    # inside the settings card, which does not exist until a game is loaded --
    # so "which build am I running?" could only be answered by picking a 2MB
    # ROM and a symbol file first, to read a number the page knew on its first
    # frame. That is not a wording problem or a layout preference: a version
    # display you cannot reach when you want it is the same as not having one,
    # and nothing else here would have noticed. The header is the one part of
    # the app that is always there.
    head = re.search(r"<header>(.*?)</header>", INDEX.read_text(), re.S)
    if not head:
        return fail("index.html has no <header> to show the version in")
    missing = [i for i in ("version", "update") if f'id="{i}"' not in head.group(1)]
    if missing:
        return fail(f"{', '.join(missing)} is not in the header")

    # And the settings card is reachable before a ROM is, for the same reason
    # one level down. It holds the theme, this device's name, the room and the
    # kept files -- none of which need a game, and the device that most needs
    # the room is the one that has no game yet. It spent a while hidden behind
    # a loaded cartridge, which made joining a room from a fresh phone
    # impossible: the button existed and nothing could press it.
    card = re.search(r'<div class="card([^"]*)" id="speedcard">', INDEX.read_text())
    if not card:
        return fail("index.html has no settings card")
    if "hide" in card.group(1):
        return fail("the settings card is hidden until a ROM is loaded")
    return ok(f"version {m.group(1)} matches the cache, and shows with no ROM")


def check_docs_shape():
    """The architecture diagram names every module, and counts them correctly.

    docs-check notices when described code changes; it cannot notice a module
    that was never described. So a new file is invisible to it -- version.js was
    added, drawn nowhere, and the prose went on saying "Sixteen modules" while
    there were seventeen. A diagram reads as the map of the code, which makes a
    missing module worse than a stale paragraph.
    """
    doc = ROOT / "docs" / "CODE.md"
    if not doc.exists():
        print("  skip  documentation shape (no docs/CODE.md)")
        return 0
    text = doc.read_text()
    problems = []

    modules = {p.name for p in APP}
    # Anchored on the section, not on "flowchart TD". It used to take the first
    # top-down flowchart in the file, which stopped being the architecture one
    # the moment that diagram was drawn left to right -- and the check then
    # measured some other diagram and reported every module missing. The section
    # heading is the thing that actually identifies it.
    shape = re.search(r"\n## 2\..*?(?=\n## )", text, re.S)
    block = re.search(r"```mermaid\n(flowchart (?:TD|LR)\n(?:.|\n)*?)```",
                      shape.group(0)) if shape else None
    if block is None:
        problems.append("no architecture flowchart found in section 2")
    else:
        drawn = set(re.findall(r'\["?([\w-]+\.js)', block.group(1)))
        for missing in sorted(modules - drawn):
            problems.append(f"{missing} is not in the architecture diagram")
        for ghost in sorted(drawn - modules):
            problems.append(f"the diagram names {ghost}, which does not exist")

    # The prose count, spelled out in words as the document does.
    #
    # The table used to stop at twenty and the mismatch was reported only
    # `if want` -- so the twenty-first module turned this check off instead of
    # failing it, which is the one moment it was needed. A count this cannot
    # name is now a problem in its own right, and the hyphen in "Twenty-one" is
    # why the pattern is [\w-] rather than \w.
    WORDS = {10: "Ten", 11: "Eleven", 12: "Twelve", 13: "Thirteen",
             14: "Fourteen", 15: "Fifteen", 16: "Sixteen", 17: "Seventeen",
             18: "Eighteen", 19: "Nineteen", 20: "Twenty",
             21: "Twenty-one", 22: "Twenty-two", 23: "Twenty-three",
             24: "Twenty-four", 25: "Twenty-five", 26: "Twenty-six",
             27: "Twenty-seven", 28: "Twenty-eight", 29: "Twenty-nine",
             30: "Thirty"}
    want = WORDS.get(len(modules))
    # Anchored on the count, not on the sentence that used to follow it. The
    # pattern wanted "... modules. Arrows point from" and the prose grew a
    # comma, which is a checker failing over its own phrasing rather than over
    # anything true.
    said = re.search(r"^([\w-]+) modules\b", text, re.M)
    if said is None:
        problems.append("the module count sentence is gone")
    elif want is None:
        problems.append(f"there are {len(modules)} modules and this check has no "
                        f"word for that -- add it to WORDS in tools/check-app")
    elif said.group(1) != want:
        problems.append(f"the prose says {said.group(1)} modules, "
                        f"there are {len(modules)} ({want})")

    # Every module should also appear in the "what does it answer" table.
    for name in sorted(modules):
        if f"| `{name}` |" not in text:
            problems.append(f"{name} is not in the module table")

    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} documentation-shape problem(s)") if problems \
        else ok(f"all {len(modules)} modules are drawn, counted and tabled")


# Names the platform provides, so a reference to one is not a mistake.
BROWSER_GLOBALS = {
    "Object", "Array", "String", "Number", "Boolean", "Math", "JSON", "Date",
    "Promise", "Error", "TypeError", "RangeError", "Set", "Map", "WeakMap",
    "Symbol", "Proxy", "Reflect", "RegExp", "Function", "BigInt",
    "Uint8Array", "Uint16Array", "Int8Array", "Uint8ClampedArray",
    # Names the platform provides that this app reaches for by name.
    "RTCPeerConnection", "CompressionStream", "DecompressionStream",
    "MediaStream", "DataTransfer",
    "Uint32Array", "Int32Array", "Float32Array", "Float64Array",
    "ArrayBuffer", "DataView", "TextEncoder", "TextDecoder",
    "URL", "URLSearchParams", "Blob", "File", "FileReader", "FormData",
    "Headers", "Request", "Response", "AbortController",
    "MessageChannel", "MessagePort", "Worker", "BroadcastChannel",
    "MutationObserver", "IntersectionObserver", "ResizeObserver",
    "Image", "ImageData", "Audio", "AudioContext", "OffscreenCanvas",
    "CustomEvent", "Event", "EventTarget", "DOMParser", "Node", "Element",
    "HTMLElement", "DocumentFragment", "IDBKeyRange", "Intl", "WebAssembly",
    "Notification", "Storage", "CSS", "Option",
}
def _code_only(text: str) -> str:
    """The source with comments and string contents blanked out.

    Needed because the first version of check_names read prose as code: "Mr.
    Pokemon", "Pokemon Center" and a sentence ending "...Chikorita." all look
    exactly like a capitalised name followed by a dot. Eleven false positives
    and no real ones, which is the fastest way to make a check ignored.

    Line structure is preserved so the numbers it reports still point at the
    right line.
    """
    out = []
    i, n = 0, len(text)
    while i < n:
        two = text[i:i + 2]
        if two == "/*":                      # block comment
            end = text.find("*/", i + 2)
            end = n if end < 0 else end + 2
            out.append("".join(c if c == "\n" else " " for c in text[i:end]))
            i = end
        elif two == "//":                    # line comment
            end = text.find("\n", i)
            end = n if end < 0 else end
            out.append(" " * (end - i))
            i = end
        elif text[i] in "'\"`":             # string or template literal
            quote = text[i]
            j = i + 1
            while j < n and text[j] != quote:
                if text[j] == "\\":
                    j += 1
                j += 1
            j = min(j + 1, n)
            out.append("".join(c if c == "\n" else " " for c in text[i:j]))
            i = j
        else:
            out.append(text[i])
            i += 1
    return "".join(out)


CAPITALISED_USE = re.compile(r"\b([A-Z][A-Za-z0-9_]*)\s*(?:\.|\()")


def check_doc_links():
    """Every `](#anchor)` in the docs lands on a heading that exists.

    A rot nothing here could see. `docs-check` notices when described *code*
    changes; it cannot notice a heading being renamed underneath the six links
    that point at it. Measured the day this was written: four dead anchors, three
    of them from section renames nobody could have caught -- "Twenty-six audits"
    became "Thirty-four audits" and took two links with it, "7a. Four that act on
    where you already are" gained a fifth -- and one written an hour earlier that
    pointed at a heading in the *other* file.

    A dead anchor in a document this size is not cosmetic: these files are how
    the next reader finds the argument for a decision, and a link that silently
    lands at the top of the page is worse than no link, because it reads as
    having been checked.

    Slugs the way GitHub makes them: lower case, punctuation dropped, and each
    remaining space turned into a hyphen *without collapsing runs* -- which is
    why "`screen.js` -- the words on screen" anchors as `screenjs--the-words-on-
    screen`. Getting that wrong is what made the first draft of this report six
    links that were perfectly fine.
    """
    def prose(text):
        """The document with code taken out of it.

        A fenced block or a backticked span is not a link, and this check found
        that out by failing on the line in DEVELOPING.md that *documents* it --
        which contains a literal `](#anchor)` as an example. The same masking
        idea `tools/mutate` needs, for the same reason: prose about code reads
        like code.
        """
        text = re.sub(r"```.*?```", "", text, flags=re.S)
        return re.sub(r"`[^`\n]*`", "", text)

    # Headings come from the *raw* text and links from the masked text, which
    # is not a nicety: masking a heading strips its backticked half, so
    # "`romdata.js` -- what the cartridge knows" would anchor as
    # "-what-the-cartridge-knows" and four perfectly good links would be
    # reported dead. The first draft did exactly that.
    docs = {}
    for path in sorted((ROOT / "docs").glob("*.md")):
        raw = path.read_text()
        text = prose(raw)
        heads = set()
        for m in re.finditer(r"^#{1,6}\s+(.*)$", raw, re.M):
            title = m.group(1).strip().lower()
            title = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", title)
            title = re.sub(r"[`*]", "", title)
            title = re.sub(r"[^\w\s-]", "", title, flags=re.U)
            heads.add(re.sub(r"\s", "-", title))
        docs[path.name] = (text, heads)
    if not docs:
        print("  skip  documentation links (no docs/)")
        return 0

    problems = []
    for name, (text, _) in docs.items():
        for m in re.finditer(r"\]\((([A-Za-z0-9_.-]+\.md)?)#([A-Za-z0-9._-]+)\)", text):
            target, anchor = m.group(2) or name, m.group(3)
            where = f"{name} -> {target}#{anchor}"
            if target not in docs:
                problems.append(f"{where} (no such file in docs/)")
            elif anchor not in docs[target][1]:
                problems.append(where)
    if problems:
        for p in problems[:8]:
            print(f"        {p}")
        return fail(f"{len(problems)} documentation link(s) point at nothing")
    total = sum(len(re.findall(r"\]\(([A-Za-z0-9_.-]+\.md)?#", t))
                for t, _ in docs.values())
    return ok(f"{total} documentation anchors across {len(docs)} files resolve")


def check_names():
    """Every capitalised name a module uses is one it can actually see.

    This is the class of bug nothing else here can catch. `node --check` parses
    a file without resolving a single name, and the wiring check only confirms
    that what *is* imported exists -- neither notices a name that was never
    imported at all. It is a ReferenceError the moment that line runs, and only
    that line.

    It has now happened twice. A constant defined in two modules reached a user
    as a bare ReferenceError the first time a catch ran. And splitting tasks.js
    into mixins left six `Tasks.menuIsLive(...)` calls in battle.js, where the
    name `Tasks` no longer exists -- which shipped, and broke grinding in the
    deployed app, while every check here passed and thirty-seven tests stayed
    green because they exercised the static directly rather than its callers.

    What it covers is `Name.something` and `Name(...)` for a capitalised name.
    It does not cover bare identifiers, which would need real scope analysis --
    parameters, destructuring, loop variables. A narrower rule that is always
    right is worth more than a broad one that cries wolf: a first attempt at
    also checking ALL_CAPS constants produced twelve findings, every one of them
    an object key or a property name.
    """
    problems = []
    for path in APP:
        text = path.read_text()
        declared = set(BROWSER_GLOBALS)
        # Imported names.
        for block in re.findall(r"import\s*\{([^}]*)\}\s*from", text):
            for part in block.split(","):
                name = part.strip().split(" as ")[-1].strip()
                if name:
                    declared.add(name)
        for name in re.findall(r"import\s+(\w+)\s+from", text):
            declared.add(name)
        # Declared here: classes, functions, consts, and mixin parameters.
        declared |= set(re.findall(r"\b(?:class|function)\s+([A-Z]\w*)", text))
        declared |= set(re.findall(r"\b(?:const|let|var)\s+([A-Z]\w*)", text))
        declared |= set(re.findall(r"function\s+with\w+\((\w+)\)", text))
        declared |= set(re.findall(r"\bclass\s+(\w+)\s+extends", text))

        for n, line in enumerate(_code_only(text).splitlines(), 1):
            for name in CAPITALISED_USE.findall(line):
                if name in declared or name.isupper():
                    continue
                problems.append(f"{path.name}:{n}  {name} is used but never "
                                f"imported or declared here")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} unbound name(s)") if problems \
        else ok(f"every capitalised name in {len(APP)} modules resolves")


# Imports that leave the module's own directory, in both shapes ES modules
# allow. Bare specifiers are not a thing here: this app has no build step, so
# every import is a path.
CROSSING = re.compile(r"(?:from|import)\s*\(?\s*'(\.\./([\w-]+)/[\w.]+)'")


def check_layers():
    """An import may point down LAYERS and never up.

    The layering was already true when the directories were made -- checked by
    measuring every import before moving a file -- and that is exactly why this
    exists. A structure that is correct today and unenforced is correct until
    the next hurry: one `../titles/crystal.js` inside gen2/ and the engine knows
    about a cartridge again, which is the whole thing the split was for. Nothing
    else in here would notice, because such an import resolves, parses, and
    works.

    Vendored directories are the exception and are named rather than inferred.
    `sync/` and `baton/` are somebody else's code that gbcore/ is allowed to
    reach, and they sit outside this list because they have no place in it.
    """
    allowed = {name: set(LAYERS[:i]) | {name} for i, name in enumerate(LAYERS)}
    outside = {"sync", "baton", "vendor"}
    problems = []
    for path in APP:
        layer = path.parent.name
        for spec, target in CROSSING.findall(path.read_text()):
            if target in outside:
                if layer != "gbcore" and target != "vendor":
                    problems.append(f"{rel(path)}  reaches vendored {target}/ -- "
                                    f"only gbcore/ should")
                continue
            if target not in allowed:
                problems.append(f"{rel(path)}  imports {spec}, and {target}/ is "
                                f"not one of {', '.join(LAYERS)}")
            elif target not in allowed[layer]:
                problems.append(f"{rel(path)}  imports {spec} -- {layer}/ may only "
                                f"reach {', '.join(sorted(allowed[layer]))}")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} import(s) pointing the wrong way") if problems \
        else ok(f"every import points down {' → '.join(LAYERS)}")


# `class Crystal extends Journey`, and the members of a class body.
SUBCLASS = re.compile(r"^export class (\w+) extends (\w+)", re.M)
MEMBER = re.compile(r"^  (?:async |get |set |static )*([a-zA-Z_]\w*)\s*[(=]", re.M)


def check_title_adds():
    """A title may not replace engine behaviour. Anything else it may do.

    Every title reaches `Journey` eventually, which is what lets a scripted
    errand call `this.travelTo(...)` without holding a reference. The cost of
    that convenience is that a subclass can also *replace* an engine method,
    silently: the override resolves, parses and runs, and the next title copies
    it because the first one did.

    Two such hooks existed on purpose for one commit -- `where` and
    `nearestHeal` -- and both turned out to be better as fields on the title
    object: a question the engine has for a cartridge should be data the
    cartridge declares, not a method it is trusted to write.

    A title extending *another title* is fine, and this check used to forbid it.
    That was found by writing one: a hack of the same base game keeps the
    engine and most of the procedures -- the nurse still stands behind a
    counter -- and changes where things are, which is data. So the chain is
    walked to whatever engine class it reaches, and only the engine's own
    members are protected. A title overriding the title it extends is that
    title's business; a hack that moved Elm's lab needs a different healAtElm.

    `constructor` is the exception everywhere, because supplying a profile to
    `super` has nowhere else to happen.
    """
    engine, titles = {}, {}
    for path in APP:
        if path.parent.name == "gen2":
            engine[path.stem] = set(MEMBER.findall(path.read_text()))
    for path in APP:
        if path.parent.name == "titles":
            text = path.read_text()
            for cls, base in SUBCLASS.findall(text):
                titles[cls] = (path, base, set(MEMBER.findall(text)))

    def engine_base(cls, seen=()):
        """The engine class a title's chain reaches, or None."""
        if cls not in titles or cls in seen:
            return cls.lower() if cls.lower() in engine else None
        return engine_base(titles[cls][1], (*seen, cls))

    problems = []
    for cls, (path, base, members) in sorted(titles.items()):
        root = engine_base(cls)
        if root is None:
            problems.append(f"{rel(path)}  {cls} extends {base}, and that chain "
                            f"never reaches a gen2/ class")
            continue
        for name in sorted(members & engine[root] - {"constructor"}):
            problems.append(f"{rel(path)}  {cls}.{name}() overrides the engine's "
                            f"{name}() -- a title adds, and declares; it does "
                            f"not replace engine behaviour")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} override(s) in titles/") if problems \
        else ok(f"no title replaces engine behaviour")


# `this.gb.core._getCartridgeInfo()`, `gb.core.loadROM(...)`, `window.WasmBoy`.
# Not the bare word: saves.js and remember.js both discuss the library's own
# IndexedDB store by name, which is a different thing from holding its core.
CORE_REACH = re.compile(r"\.core\b|window\.WasmBoy\b")


# Methods that became async, whose result is a *decision*. An un-awaited
# call to one of these returns a Promise, and a Promise is always truthy.
AWAITED = ("calibrate",)
# The receiver may be a chain -- `this.collision.calibrate(...)` -- so the
# whole of it is consumed before the lookbehind checks for `await`.
# The receiver may be a chain -- `this.collision.calibrate(...)` -- so the
# whole of it is consumed, and the start of that chain is anchored: without
# `(?<![\w.])` the engine simply backtracks to `.collision` and reports an
# awaited call as un-awaited, which is a checker crying wolf at the one line
# that is already right.
AWAIT_CALL = re.compile(
    r"(?<!await )(?<![\w.])[\w.]+\.(" + "|".join(AWAITED) + r")\s*\(")


def check_awaited():
    """Every async method whose answer is a condition is awaited.

    **A Promise is truthy.** `calibrate` reads the collision table, and it had
    to become async the day a cartridge turned up that keeps that table in a
    work-RAM bank nobody has mapped -- Polished Crystal decompresses it into
    bank 5. The three callers all say `if (collision.calibrate(wram))`, and
    without `await` every one of them would have read "yes, calibrated" from a
    pending Promise and then pathed through walls with a stale decode.

    That is a failure with no symptom at the call site: it parses, it runs, and
    it is confidently wrong. The tests would not have caught it either, because
    their fakes return a plain boolean and `await true` is `true`.

    Matched on the method name rather than on a list of files, so a fourth
    caller written next year is held to the same rule.
    """
    problems = []
    for path in APP:
        src = _code_only(path.read_text())
        for m in AWAIT_CALL.finditer(src):
            line = src[:m.start()].count("\n") + 1
            problems.append(f"{path.relative_to(ROOT)}:{line}  "
                            f"{m.group(1)}() is async and this call does not "
                            f"await it — a Promise is always truthy")
    for p_ in problems:
        print(f"        {p_}")
    return fail(f"{len(problems)} un-awaited decision(s)") if problems \
        else ok(f"every call to {len(AWAITED)} async decision(s) is awaited")


def check_emulator_seam():
    """Only gb.js touches the emulator core.

    The first line of gb.js is "the emulator, wrapped so the rest of the app
    never touches WasmBoy directly", and that had stopped being true: saves.js
    called `gb.core._getCartridgeInfo()` and `gb.core.loadROM(...)`. Reaching
    past a wrapper for a *private* core method is the ordinary cost, and there
    was a second one here -- `loadRom` re-reads WORK_RAM_LOCATION after the ROM
    is in, because the constant reads back undefined before that and silently
    makes every later read empty, so a re-load that skipped it kept the previous
    cartridge's offset.

    Prose cannot hold a seam shut. Nothing else in this file would have noticed:
    the reach resolves, parses, and works, which is what every defect these
    checks exist for has in common.

    Matched on `.core` and on grabbing the global, rather than on the library's
    name: saves.js and remember.js both discuss its IndexedDB store by name, and
    talking about somebody else's database is not the same as holding their
    emulator. Comments are searched along with code, because a line that says
    `.core` is describing a reach whether or not it performs one.
    """
    problems = []
    for path in APP:
        if path.name == "gb.js":
            continue
        for i, line in enumerate(path.read_text().split("\n"), 1):
            if CORE_REACH.search(line):
                problems.append(f"{rel(path)}:{i}  {line.strip()[:70]}")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} reach(es) past gb.js to the core") if problems \
        else ok(f"only gb.js touches the emulator core")


# `document.addEventListener('x', handler)` and its window/bare equivalents.
# Element listeners are deliberately not matched: an element listener's life is
# the element's, and elements get replaced. `document` and `window` do not.
LONG_LIVED = re.compile(
    r"^(\s*)(?:document|window)?\.?addEventListener\(\s*['\"]([^'\"]+)['\"]\s*,\s*([^,)]*)")
UNSUBSCRIBE = re.compile(r"removeEventListener\(")


def check_listeners():
    """A listener on document or window is added once, or taken off again.

    `document` and `window` outlive every function in the app, so a listener
    added from inside a function is added again every time that function runs.
    Nothing fails; the handler simply runs N times per event, for ever.

    Measured, which is why this exists: `startLoop` subscribed
    `visibilitychange` from its own body, and `reallyStart` calls `startLoop`
    every time somebody picks a ROM or a symbol file -- a supported thing to do
    in an app built to hold more than one cartridge. Counting simultaneous
    animation-frame callbacks, re-picking the same .sym three times took the
    live emulator-stepping chains from 7 to 8 to 9, one added each time and none
    retired. On a visible page that is nine chains stepping one Game Boy every
    frame. The duplicate listener came with it and had the same shape.

    Two ways to be right, and both are allowed. Subscribe at the top level,
    where running twice is not a thing that can happen -- that is what the fix
    did. Or subscribe inside a function and take it off again, which is what
    `whenVisible` does: it adds `visibilitychange`, resolves once, and removes
    its own handler on the way out.

    So the rule is: indented means inside something, and inside something means
    there must be a `removeEventListener` for the same handler in the same file.
    Named handlers only -- an inline arrow cannot be removed, which is precisely
    why one must not be subscribed from inside a function.
    """
    problems = []
    for path in APP:
        text = path.read_text()
        removed = set(re.findall(r"removeEventListener\(\s*['\"][^'\"]+['\"]\s*,\s*(\w+)",
                                 text))
        for i, line in enumerate(text.split("\n"), 1):
            m = LONG_LIVED.match(line)
            if not m or not m.group(1):        # column 0 is top level, and fine
                continue
            handler = m.group(3).strip()
            if handler and re.fullmatch(r"\w+", handler) and handler in removed:
                continue
            problems.append(f"{rel(path)}:{i}  {m.group(2)} <- {handler or 'an inline handler'}")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} long-lived listener(s) added from inside a function") \
        if problems else ok("every document/window listener is added once or removed")


NAMED_EXPORT = re.compile(
    r"^export\s+(?:async\s+)?(?:function|class|const|let)\s+(\w+)", re.M)
EXPORT_LIST = re.compile(r"^export\s*\{([^}]*)\}", re.M)


def check_exports():
    """Nothing is exported that nothing outside the module reads.

    An export is a promise to somebody else. When there is no somebody else it
    is not a small untidiness -- it is a second way to do a thing, sitting where
    the next person will find it by name, and drifting away from the way that is
    actually used because nothing exercises it.

    Which is exactly what it was. `Saves.restore(slot)` read a slot and installed
    its bytes, and nothing had called it since `loadSlot` in main.js took the
    job over. The difference between the two is the refusal the fourth audit
    pass added: loadSlot will not install a save whose ROM fingerprint is not
    this cartridge's, and `restore` had no such check. So the dead one was the
    pre-audit version of a live operation, waiting under an inviting name. Found
    by coverage -- it is in the module the tests run least of -- and this is what
    stops the next one sitting there as long.

    Test code counts as somebody else, and so do the tools and the markup: an
    export that exists to be tested is doing a job. What does not count is the
    module's own body, which is what un-exporting is for.
    """
    others = {p: p.read_text() for p in APP}
    outside = "\n".join(
        (ROOT / f).read_text() for f in ("index.html", "sw.js"))
    outside += "\n".join(p.read_text() for p in (ROOT / "tests").rglob("*.mjs"))
    # `check-app` is excluded because it is the thing asking, and `check-checks`
    # because it holds fragments of deliberately broken source -- including, the
    # first time this ran, the very export it mutates in to prove this group
    # bites. A corpus that counts a checker's own straw man as a reader cannot
    # find anything.
    outside += "\n".join(p.read_text() for p in (ROOT / "tools").iterdir()
                          if p.is_file() and p.name not in ("check-app", "check-checks"))
    problems = []
    for path in APP:
        text = others[path]
        names = set(NAMED_EXPORT.findall(text))
        for block in EXPORT_LIST.findall(text):
            for part in block.split(","):
                bit = part.strip().split(" as ")[-1].strip()
                if bit:
                    names.add(bit)
        for name in sorted(names):
            word = re.compile(rf"\b{re.escape(name)}\b")
            if any(word.search(t) for q, t in others.items() if q != path):
                continue
            if word.search(outside):
                continue
            problems.append(f"{rel(path)}  exports {name}, and nothing outside it "
                            f"ever says that word")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} export(s) with no reader") if problems \
        else ok("every export is read by something outside its module")


# --- the stylesheet against itself, and against the vendor's ----------------
#
# Two failures that have the same shape: a declaration that is written, is
# correct, and never applies. Neither shows up as an error anywhere -- the CSS
# parses, the page renders, and what you get is simply not what the rule says.
# `node --check` cannot see it, no test opens a browser, and a screenshot only
# catches it if somebody happens to look at that row and know what it should
# have looked like. Both of these were found by looking; both are now looked
# for.

STYLE = re.compile(r"<style>(.*?)</style>", re.S)
IMPORTANT = re.compile(r"!\s*important")
DECL = re.compile(r"(?:^|;)\s*([a-z-]+)\s*:([^;]*)")


def _css_rules(css):
    """(selector, body, order) for every rule at the top level of a sheet.

    At-rule bodies are skipped rather than descended into: a declaration inside
    `@media` that repeats one outside it is the whole point of a media query,
    and reporting that as shadowing would be reporting the feature.
    """
    css = re.sub(r"/\*.*?\*/", "", css, flags=re.S)
    rules, i, n, order = [], 0, len(css), 0
    while i < n:
        brace = css.find("{", i)
        if brace < 0:
            break
        selector = css[i:brace].strip()
        depth, j = 1, brace + 1
        while j < n and depth:
            if css[j] == "{":
                depth += 1
            elif css[j] == "}":
                depth -= 1
            j += 1
        if not selector.startswith("@"):
            rules.append((selector, css[brace + 1:j - 1], order))
            order += 1
        i = j
    return rules


def _decls(body):
    """{property: important} for one rule body."""
    return {m.group(1): bool(IMPORTANT.search(m.group(2)))
            for m in DECL.finditer(body)}


def _values(body):
    """{property: value} for one rule body, `!important` and spaces removed."""
    return {m.group(1): IMPORTANT.sub("", m.group(2)).strip()
            for m in DECL.finditer(body)}


ONE_CLASS = re.compile(r"^\.([\w-]+)$")


def check_dead_css():
    """No single-class rule is overridden everywhere it could apply.

    Two classes, one element, same property: CSS breaks the tie on source order,
    so the rule written *first* loses -- and a modifier written near the thing it
    modifies, above the layout rule it means to override, is dead on every
    element that carries it.

    `.slots{display:block}` was exactly that. It sat with the other save-card
    rules; `.param{display:flex}` sat two hundred lines further down with the
    other parameter rows; the only element in the app carrying `slots` carries
    `param` too. So the save card's three slots laid out as a flex row with the
    label centred beside them, and "SLOTS" spent its whole life next to the
    *middle* row of three, reading as that row's name.

    Only reported where it is certainly dead: the class is in the markup, every
    element carrying it also carries the overriding one, the loser is not
    `!important` where the winner is not, and neither rule is inside an at-rule.
    Classes the app names in JavaScript are left out on both sides, and the
    second half of that is the one that matters -- a winner the app takes off
    again is not a winner. `.runlog{display}` is beaten by `.hide` on the one
    element that carries both, and is exactly what that element is for the rest
    of the time.
    """
    css = STYLE.search(INDEX.read_text()).group(1)
    rules = _css_rules(css)
    # Every class set the markup actually builds.
    sets = [set(m.split()) for m in re.findall(r'class="([^"]*)"', INDEX.read_text())]
    # Classes the app *uses as classes* at run time: either side of a
    # comparison, these are outside what this file can reason about. Read from
    # the class operations rather than from every quoted word in the app, which
    # was the first draft and quietly excluded `slots` -- an IndexedDB store
    # three layers down happens to be called that, so the one defect this group
    # was written for was the one thing it skipped.
    js = " ".join(p.read_text() for p in APP)
    live = set()
    for m in re.finditer(r"classList\.(?:add|remove|toggle|contains|replace)"
                         r"\(([^)]*)\)", js):
        live.update(re.findall(r"['\"]([\w-]+)['\"]", m.group(1)))
    for m in re.finditer(r"className\s*=\s*['\"]([^'\"]*)['\"]", js):
        live.update(m.group(1).split())
    # And the ones built into markup strings, which the row builders do.
    for m in re.finditer(r"class=\\?[\"']([\w -]*)", js):
        live.update(m.group(1).split())
    props = {}          # class -> {property: (order, important)}
    for selector, body, order in rules:
        m = ONE_CLASS.match(selector)
        if not m:
            continue
        for prop, bang in _decls(body).items():
            props.setdefault(m.group(1), {})[prop] = (order, bang)
    problems = []
    for cls, mine in sorted(props.items()):
        carriers = [s for s in sets if cls in s]
        if not carriers or cls in live:
            continue
        for prop, (order, bang) in sorted(mine.items()):
            winners = set()
            for carried in carriers:
                beat = [o for o in carried - {cls}
                        if prop in props.get(o, {})
                        and props[o][prop][0] > order
                        and (props[o][prop][1] or not bang)
                        and o not in live]
                if not beat:
                    break
                winners.update(beat)
            else:
                problems.append(
                    f"index.html  .{cls}{{{prop}}} never applies — "
                    f".{sorted(winners)[0]} sets it later")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} dead declaration(s)") if problems \
        else ok(f"{len(props)} class rules, none written where it cannot apply")


PSEUDO = re.compile(r"^(.*?)(::?(?:before|after))$")


def _drawing_pseudos(css):
    """{subject: pseudo} for vendor rules that draw a mark with a pseudo-element.

    "Draws" means a `content` that is not `none`, plus something to see: a
    background image, a border or a size. The chevron Pico puts on every
    `summary` is the one that matters here, but the set is read from the sheet
    rather than listed, so a vendor upgrade that adds another is covered.
    """
    out = {}
    for selector, body, _ in _css_rules(css):
        for part in selector.split(","):
            m = PSEUDO.match(part.strip())
            if not m:
                continue
            d = _decls(body)
            if "content" not in d:
                continue
            if not ({"background-image", "border", "border-width", "width"} & set(d)):
                continue
            subject = m.group(1).strip().split()[-1] if m.group(1).strip() else ""
            # Bare elements and attribute selectors only. A vendor class is the
            # vendor's own business; a `summary` is ours the moment we write one.
            if re.fullmatch(r"[a-z]+|\[[^\]]+\]", subject):
                out[subject] = m.group(2)
    return out


def check_markers():
    """We do not hand-draw an affordance the vendor sheet already draws.

    Pico puts a chevron on every `summary` as a floated `::after`. This sheet
    drew a `›` on the same summaries as a `::before`, so both `details.how`
    blocks in the app carried *two* disclosure markers: one beside the words and
    one at the far right of the row, and only the far one moved when the block
    opened. It shipped in v161 and survived four passes of looking at those
    cards, because two markers is not obviously wrong -- it reads as a design
    somebody chose.

    Replacing the vendor's is still allowed; duplicating it is not. So a rule
    that draws on either pseudo of an element the vendor already draws on has to
    be accompanied by one that switches the vendor's off.
    """
    vendor_css = "\n".join(p.read_text() for p in VENDORED_CSS)
    ours = STYLE.search(INDEX.read_text()).group(1)
    drawn = _drawing_pseudos(vendor_css)
    if not drawn:
        return fail("read no drawing pseudo-elements out of the vendor sheet")
    # Which vendor pseudos this sheet turns off, per subject. Read off the
    # *values*, because the first draft asked whether the body mentioned
    # `none` at all -- and the rule that stops Pico's chevron floating says
    # `float:none`, so the check read our fix as our having removed the marker
    # and then had nothing left to complain about. A group that is switched
    # off by the very edit it is meant to police is worse than no group.
    silenced = set()
    for selector, body, _ in _css_rules(ours):
        v = _values(body)
        if v.get("display") != "none" and v.get("content") != "none":
            continue
        for part in selector.split(","):
            m = PSEUDO.match(part.strip())
            if not m:
                continue
            subject = m.group(1).strip().split()[-1] if m.group(1).strip() else ""
            subject = re.sub(r"[.#\[].*$", "", subject) or subject
            silenced.add((subject, m.group(2)))
    problems = []
    for selector, body, _ in _css_rules(ours):
        d = _decls(body)
        if "content" not in d:
            continue
        for part in selector.split(","):
            m = PSEUDO.match(part.strip())
            if not m:
                continue
            subject = m.group(1).strip().split()[-1] if m.group(1).strip() else ""
            subject = re.sub(r"[.#\[].*$", "", subject) or subject
            if subject not in drawn:
                continue
            theirs = drawn[subject]
            if (subject, theirs) in silenced:
                continue
            problems.append(
                f"index.html  {part.strip()} draws a mark, and the vendor sheet "
                f"already draws {subject}{theirs} — two markers on one element")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} duplicated marker(s)") if problems \
        else ok(f"no mark is drawn twice on any of "
                f"{len(drawn)} vendor-drawn element(s)")


JOB_TABLE = re.compile(r"const JOB_ROWS = \{(.*?)\n\};", re.S)
JOB_KEY = re.compile(r"^\s*(\w+):\s*\['#[\w-]+',\s*'#([\w-]+)',\s*'#([\w-]+)'\]", re.M)
JNAME = re.compile(r'id="job-([\w-]+)"(.*?)<span class="jname">([^<]*)</span>', re.S)


def check_labels():
    """Every job row is named after its own key, capitalised.

    Which is an invariant the app *reads* rather than a tidiness: the runner
    that presses these rows in sequence prints which one it starts with, and it
    builds that word from the key -- `heal` becomes "starts with Heal". There is
    no table mapping one to the other, deliberately, because a table is a second
    copy of nine words that can drift from the markup silently.

    So the check is the other half of that decision. Rename a row's `.jname` and
    the runner goes on announcing the old word, which is a sentence about a row
    that is not on the screen -- and nothing else in this repository can see it:
    the id is unchanged, the handler is unchanged, and every test passes.
    """
    text = INDEX.read_text()
    table = JOB_TABLE.search(module("main.js").read_text())
    if not table:
        return fail("app/main.js has no JOB_ROWS table")
    keys = [m.group(1) for m in JOB_KEY.finditer(table.group(1))]
    if not keys:
        return fail("read no job keys out of JOB_ROWS")
    names = {m.group(1): m.group(3).strip() for m in JNAME.finditer(text)}
    problems = []
    for key in keys:
        want = key[0].upper() + key[1:]
        got = names.get(key)
        if got is None:
            problems.append(f"index.html  no #job-{key} row with a name in it")
        elif got != want:
            problems.append(f"index.html  #job-{key} is called {got!r}, "
                            f"and the runner will say {want!r}")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} row name(s) the runner would get wrong") \
        if problems else ok(f"all {len(keys)} job rows are named after their key")


def check_counts():
    """Every number in the prose that the repository can compute is right.

    They go stale for the same reason every time: the number lives in a
    sentence that nothing recomputes, one directory away from the thing it
    counts. Two have shipped wrong. `DEVELOPING.md` claimed **143 tests in
    seventeen files** while 576 ran in twenty-three, with two diagrams in it
    disagreeing with the prose and with each other; and the symbol digest was
    drawn as **47 entries** while it carried 53.

    `docs-check` cannot see any of this. That tool watches sections whose
    marker names the *source* files they describe, and hashes them -- so it
    catches prose that was not re-read when code moved, and cannot catch a
    number that was re-read and left alone. This is the other half.

    The table of claims is in `tools/counts.py`, shared with `tools/renumber`,
    which writes the current numbers in. One table rather than two, because a
    writer and a checker that disagree about what a number means is worse than
    having neither.

    A claim whose pattern matches *nothing* fails too: a sentence reworded out
    from under its own check is exactly how one of these went stale.
    """
    sys.path.insert(0, str(HERE))
    import counts as counts_mod
    problems = counts_mod.drift()
    for rel, want, got, ctx in problems:
        if got is None:
            print(f"        {rel}  nothing matches {ctx!r} — should say {want}")
        else:
            print(f"        {rel}  says {got}, and it is {want}  ({ctx})")
    if problems:
        print("        tools/renumber writes them in")
        return fail(f"{len(problems)} number(s) adrift in the documentation")
    return ok(f"{len(counts_mod.CLAIMS)} counted claims and "
              f"{len(counts_mod.test_counts())} test files all say the true number")


def check_gates():
    """Every declared gate names an event some *script* in the ROM sets.

    Skipped without a cartridge, like `moves`, and for the same reason: the
    point is that the check can exist at all with nothing game-derived in the
    repository.

    A gate is a title saying *this road is shut until event N*, and the number
    is the entire content of the claim. Get it wrong and the app confidently
    tells somebody to go and do a thing that has no bearing on the road -- a
    worse failure than the silence it replaced, and one nothing else here could
    notice, because a wrong bit reads exactly like a bit that is not set yet.

    So the number is checked against the cartridge: search the ROM for
    `setevent N` and require that *something* sets it. That is the weaker of
    the two claims worth making and the only one this can prove -- it catches a
    gate that can never open, which is the failure that matters.

    **It cannot tell a number that means nothing from one that means something
    else**, and pretending otherwise was tried twice. Requiring the containing
    symbol to look like a script rejects real setters:
    `RuinsOfAlphHoOhChamberPuzzle.PuzzleComplete` matches no such word.
    Requiring the following byte to decode as a command does not discriminate
    either -- the one known data coincidence, inside `DunsparceFrames.frame3`,
    is followed by `34`, which is `checkflag`. With a twenty-command table
    roughly one byte in twelve reads as an instruction.

    So `tools/rom-events --gates` names every hit and a person reads the list,
    which is also how this gate was found in the first place. A check that
    silently dropped a real setter would be worse than the noise.

    **The stronger claim is about the remedy**, and that one is exact: the
    object standing on the gate's declared tile has to be the thing that sets
    the event. A gate saying "talk to somebody in the Pokémon Center" with a
    tile nobody stands on sends the pilot to press A at the floor and report
    that whoever it is would not hand the thing over -- which reads like the
    game refusing. The setter's symbol is a label inside the object's script,
    so the object's own name is a prefix of it, and comparing them is the whole
    test.
    """
    # The half that needs no cartridge, and therefore runs on CI: an errand a
    # title names has to be a method the driver has. `gatesFrom` guards this at
    # run time by only offering the name where the function exists -- which is
    # right, and means a typo produces a *missing offer* rather than an error.
    # A missing offer is exactly the kind of nothing nobody notices.
    # A driver is a title's class *extending* the engine's Journey, so an
    # errand may legitimately be defined in either -- and the good answer is
    # usually the engine: this check first failed for real, not under mutation,
    # the moment `takeTheEgg` was read back, found to mention no cartridge, and
    # moved into `journey.js` as `talkToOpen`.
    engine = module("journey.js").read_text()
    problems = []
    for path in sorted((ROOT / "titles").glob("*.js")):
        src = path.read_text()
        for errand in set(re.findall(r"\berrand:\s*'(\w+)'", src)):
            here = re.search(rf"^\s*async {errand}\s*\(", src, re.M)
            there = re.search(rf"^\s*async {errand}\s*\(", engine, re.M)
            if not here and not there:
                problems.append(f"{path.name}  declares errand {errand!r}, and "
                                f"neither it nor the engine defines one")
    for p in problems:
        print(f"        {p}")
    if problems:
        return fail(f"{len(problems)} errand(s) that name nothing")

    if not cartridge.has_cartridge(ROOT):
        return ok("every declared errand exists; no cartridge here, so the "
                  "events and tiles are not checked")
    out = subprocess.run([sys.executable, str(HERE / "rom-events"), "--gates"],
                         capture_output=True, text=True)
    lines = [l for l in out.stdout.splitlines() if "!!" in l]
    for l in lines:
        print(f"        {l.strip()}")
    if out.returncode or lines:
        return fail(f"{len(lines) or 1} gate(s) the ROM does not agree with")
    named = [l for l in out.stdout.splitlines() if l.startswith("  set by:")]
    tiles = [l for l in out.stdout.splitlines() if "and it is the setter" in l]
    return ok(f"every declared gate names an event the ROM sets, in "
              f"{len(named)} place(s), and {len(tiles)} remedy tile(s) hold "
              f"whoever sets it")


def check_rom_layout():
    """The event block is read at *this* cartridge's strides.

    Skipped without a cartridge, like `moves` and `gates`.

    **This check used to compare two hand-written copies of a structure, and
    that is why it is worth reading.** `gen2/world.js` walked a map's event
    block for warps and trigger tiles; `tools/rom-events` walked the same
    block for the objects on a map. Both had the strides written out as their
    own constants, so the strides existed twice, and one of them was mistyped:
    coord events are eight bytes and the tool said five, so every map carrying
    one parsed into drift -- Cianwood City produced objects of "type 9" whose
    script pointers landed three bytes inside a trainer's `.AskNumber2` label.
    Comparing the two files caught it in four lines.

    Then Polished Crystal arrived, whose coord event really is five bytes.
    Both files still said eight; the check compared them and saw them agree;
    and every Gym in the hack reported no leader standing in it. **Two copies
    of a structure was half the defect. The other half was that neither copy
    knew which cartridge it was looking at.**

    So the strides moved into the engine profile, `tools/rom-events` stopped
    reading the ROM and started asking `tools/route`, and this asks the
    cartridge whether the answer is right -- see `rom-events --layout` for how
    it is self-calibrating, which is the part that matters: it needs no
    threshold that knows which game it is.
    """
    if not cartridge.has_cartridge(ROOT):
        return ok("no cartridge here, so the map-events strides are not checked")
    out = subprocess.run([sys.executable, str(HERE / "rom-events"), "--layout"],
                         capture_output=True, text=True)
    for line in out.stdout.splitlines():
        print(f"        {line}")
    if out.returncode:
        return fail("the event block is not being read at this cartridge's "
                    "strides")
    return ok("the object list behind a trigger tile reads like the object "
              "list in front of one")


def check_gyms():
    """Every gym a title declares is where the cartridge says it is.

    Skipped without a cartridge, like `moves` and `gates`.

    A gym declaration is five hand-written facts -- the town, the room, the
    door, where the leader stands, and which badge bit says it is won -- and
    every one of them used to be obtainable only by walking into the room and
    reading work RAM. Getting `leaderAt` wrong means the pilot walks to an
    empty tile, presses A at nothing, and reports that the leader would not
    fight; getting `badge` wrong means a gym that is beaten goes on being
    offered for ever.

    All five are in the ROM, so all five are checked:

    * the leader's tile has an object on it;
    * that object's *script pointer* resolves to a symbol containing the
      leader's name, which is a name rather than an inference --
      `AzaleaGymBugsyScript`;
    * it is a **script** object rather than a trainer, because a leader is
      talked to and not walked into. This is the fact that cost a pass: Falkner
      is type 0 and `clearHere`, which fights what the map calls a trainer,
      could never have beaten him;
    * and the badge bit points at `wJohtoBadges` in the cartridge's own
      `EngineFlags` table -- bit 0 is engine flag `$1b`, which is the flag
      Route 32's blocker checks under the name `.DontHaveZephyrBadge`.

    The bridge from `key(group, number)` to a symbol name is the attributes
    pointer in `MapGroupPointers`, so there is no hand-written table of map
    names to drift. The reading lives in `tools/rom-events --gyms`.
    """
    if not cartridge.has_cartridge(ROOT):
        return ok("no cartridge here, so the declared gyms are not checked")
    out = subprocess.run([sys.executable, str(HERE / "rom-events"), "--gyms"],
                         capture_output=True, text=True)
    bad = [l for l in out.stdout.splitlines() if "!!" in l or "??" in l]
    for l in bad:
        print(f"        {l.strip()}")
    if out.returncode or bad:
        return fail(f"{len(bad) or 1} gym(s) the cartridge does not agree with")
    found = [l for l in out.stdout.splitlines() if l.startswith("  at (")]
    return ok(f"all {len(found)} declared gym(s) match the cartridge, "
              f"leader and badge bit")


