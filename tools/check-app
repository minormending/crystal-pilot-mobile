def check_types():
    """The decoded type chart agrees with things about Pokemon nobody looked up.

    Two halves, and the static one is the point of having it here rather than
    only in the tool.

    **Static:** every type the pilot can reason about has to be reachable. The
    chart is read through `TypeMatchups` and both sides' types through
    `wEnemyMonType1/2` and `wBattleMonType1/2` -- and a symbol the app looks up
    but does not *share* is a device that works with a `.sym` file and breaks
    without one, which is the second-phone failure the shared list exists to
    prevent. `symbols` catches that one-directionally for anything reached
    through `symbols.addr(...)`; the chart is reached through `symbols.has`
    and `at()`, which that scan does not see.

    **With a cartridge:** `tools/types --verify` runs twenty-two matchups that
    were true before this app existed, plus the row count and the set of
    multipliers. That is not decoration: the table is 110 rows of three bytes
    with a *one-byte* separator in the middle, so every wrong reading of it
    produces a chart -- just not this cartridge's -- and the only thing that
    catches a shift is asking the decoded table about Pokemon.
    """
    shared = (ROOT / "gen2" / "symbols.js").read_text()
    romdata = (ROOT / "gen2" / "romdata.js").read_text()
    state = (ROOT / "gen2" / "state.js").read_text()
    problems = []
    # Names reached with symbols.has(...) rather than symbols.addr(...), which
    # is the form the one-directional `symbols` scan cannot see.
    optional = set(re.findall(r"symbols\.has\('(\w+)'\)", romdata + state))
    for name in sorted(optional):
        if f"'{name}'" not in shared:
            problems.append(f"gen2/symbols.js  does not share {name}, which "
                            f"the app reads when a cartridge has it")
    for name in ("wEnemyMonType1", "wEnemyMonType2",
                 "wBattleMonType1", "wBattleMonType2"):
        if f"'{name}'" not in state:
            problems.append(f"gen2/state.js  never reads {name}, so half a "
                            f"matchup is missing")
    for p in problems:
        print(f"        {p}")
    if problems:
        return fail(f"{len(problems)} type-chart symbol(s) not shared or not read")

    if not cartridge.has_cartridge(ROOT):
        return ok(f"all {len(optional)} optional symbol(s) shared; no cartridge "
                  f"here, so the chart itself is not checked")
    out = subprocess.run(["node", str(HERE / "types"), "--verify"],
                         capture_output=True, text=True)
    bad = [l for l in out.stdout.splitlines() if "WRONG" in l]
    for l in bad:
        print(f"        {l.strip()}")
    if out.returncode or bad:
        return fail(f"{len(bad) or 1} row(s) the cartridge does not agree with")
    return ok(out.stdout.strip().splitlines()[-1])


def check_trainers():
    """What every gym leader carries, against the cartridge's own table.

    **Static:** the app has to declare the one part of the layout that cannot
    be guessed from the bytes -- the type byte's stride table -- and the class
    count must *not* be written down, because the pointer table ends where its
    own first pointer lands and a hack with more classes should need nothing
    changed.

    **With a cartridge:** `tools/types --verify` reads the eight Johto gym
    leaders and their parties. Those are facts about the game rather than
    about this code, which is what makes them able to fail usefully -- and one
    of them did, in the right direction: CLAIR was written down as two DRATINI
    and a DRAGONAIR and she has three DRAGONAIR, so the decode corrected the
    rule rather than the other way round.

    The class *name* is a second reading of the same rows through a different
    table: all eight have to come out LEADER.
    """
    engine = (ROOT / "gen2" / "engine.js").read_text()
    romdata = (ROOT / "gen2" / "romdata.js").read_text()
    problems = []
    m = re.search(r"trainerMonBytes:\s*\{([^}]*)\}", engine)
    if not m:
        problems.append("gen2/engine.js  declares no trainerMonBytes, and the "
                        "type byte's stride is the one thing the bytes cannot "
                        "say")
    else:
        strides = dict(re.findall(r"(\d+):\s*(\d+)", m.group(1)))
        if len(strides) != 4:
            problems.append(f"gen2/engine.js  trainerMonBytes has "
                            f"{len(strides)} stride(s); Gen 2 dispatches four "
                            f"trainer types")
    # And the count stays derived. A literal beside the pointer table is the
    # thing that rots when a hack adds a class.
    # Written as "the gap over the entry width" rather than as one exact
    # expression, because the expression changed the day a hack turned up with
    # three-byte entries and the *claim* did not: the count is still the
    # distance to the first pointer divided by how wide one is, and a literal
    # beside the pointer table would still be the bug this guards.
    if not re.search(r"entry\(0\)\.addr - addr\) / wide", romdata):
        problems.append("gen2/romdata.js  no longer derives the class count "
                        "from where the first pointer lands")
    # And the width itself is derived, which is the same claim one level down.
    if not re.search(r"_pointerWidth\(bank, addr\)", romdata):
        problems.append("gen2/romdata.js  no longer derives the pointer width "
                        "from the table itself")
    for p in problems:
        print(f"        {p}")
    if problems:
        return fail(f"{len(problems)} thing(s) the trainer reader needs")

    if not cartridge.has_cartridge(ROOT):
        return ok("the trainer layout is declared and its count derived; no "
                  "cartridge here, so the parties are not checked")
    out = subprocess.run(["node", str(HERE / "types"), "--verify"],
                         capture_output=True, text=True)
    bad = [l for l in out.stdout.splitlines() if "WRONG" in l]
    for l in bad:
        print(f"        {l.strip()}")
    if out.returncode or bad:
        return fail(f"{len(bad) or 1} leader(s) the cartridge does not agree with")
    said = [l for l in out.stdout.splitlines() if "leader(s) over" in l]
    return ok(said[-1] if said else "the trainer table agrees")


def check_menus():
    """The boxes the app drives by shape are the shapes the cartridge draws.

    Every menu in this app is told apart by two numbers -- how many items its
    data declares and which row its border sits on -- so a wrong pair is a box
    driven with the wrong answer, and a pair nothing matches is a box pressed
    on through. Both fail quietly.

    **Static:** the profile has to declare the pair, and the code has to read
    it off the instance rather than off a module constant -- a title that
    moved a box is the whole reason these are profile fields.

    **With a cartridge:** `tools/rom-events --menus` reads the cartridge's own
    menu headers. That derivation is checkable rather than trusted, because
    read the same way `BattleMenuHeader` comes out as 34 items at row 12,
    which is what `battleMenu` has said since somebody measured it on a real
    cartridge. It also lists the boxes that *share* a declared signature,
    which is the hazard the app cannot see for itself.
    """
    engine = (ROOT / "gen2" / "engine.js").read_text()
    battle = (ROOT / "gen2" / "battle.js").read_text()
    problems = []
    for field in ("battleMenu", "learnMove", "switchBox"):
        m = re.search(field + r":\s*\{([^}]*)\}", engine)
        if not m:
            problems.append(f"gen2/engine.js  declares no {field}")
            continue
        have = dict(re.findall(r"(\w+):\s*(\d+)", m.group(1)))
        for key in ("items", "top"):
            if key not in have:
                problems.append(f"gen2/engine.js  {field} has no {key}, "
                                f"which is half of what tells a box apart")
    # And the predicate has to ask the instance. `learnMoveBox` takes an
    # engine argument for exactly this reason, and the two beside it should
    # not quietly go back to a constant.
    for fn in ("learnMoveBox", "switchBoxUp"):
        m = re.search(r"export function " + fn + r"\(s, engine\)", battle)
        if not m:
            problems.append(f"gen2/battle.js  {fn} does not take an engine, so "
                            f"a title that moved the box is matched where it "
                            f"was")
    for p in problems:
        print(f"        {p}")
    if problems:
        return fail(f"{len(problems)} box signature(s) not declared or not asked")

    if not cartridge.has_cartridge(ROOT):
        return ok("every box the app drives declares its shape; no cartridge "
                  "here, so the shapes are not checked")
    out = subprocess.run([sys.executable, str(HERE / "rom-events"), "--menus"],
                         capture_output=True, text=True)
    bad = [l for l in out.stdout.splitlines() if "!!" in l or "??" in l]
    # A `note` is a box this cartridge does not name, so its shape could not
    # be checked. Shown and not counted -- see `check_phrases`.
    notes = [l for l in out.stdout.splitlines() if l.strip().startswith("note")]
    for l in bad + notes:
        print(f"        {l.strip()}")
    if out.returncode or bad:
        return fail(f"{len(bad) or 1} box(es) the cartridge does not agree with")
    agreed = [l for l in out.stdout.splitlines() if "the app agrees" in l]
    shared = [l for l in out.stdout.splitlines() if l.strip().startswith("shared:")]
    return ok(f"{len(agreed)} box(es) match the cartridge's own menu header, "
              f"and {len(shared)} signature(s) are shared by more than one box")


def check_phrases():
    """The words the app looks for on screen are words the cartridge says.

    **A phrase that is not in the ROM never matches, and nothing says so.**
    The screen is read as tiles and compared as folded text, so a typo does
    not fail -- it never fires, and the feature resting on it quietly stops
    working. For the title's `boxed` phrase that means a *successful* catch
    reported as a getaway, which is the one outcome that branch exists to
    prevent.

    **Static:** a phrase is *content*, so no engine module may compare a
    literal one. `sc.says(boxed)` takes the title's word; `sc.says('sent to
    BILL')` would put a fact about one cartridge's English inside the engine,
    where a hack cannot change it and `check_layers` cannot see it.

    **With a cartridge:** `tools/rom-events --phrases` looks each one up. All
    three currently land on the symbol that names them --
    `_WasSentToBillsPCText`, `StartMenu.PackString`, `StartMenu.SaveString`.
    """
    problems = []
    for name in sorted((ROOT / "gen2").glob("*.js")):
        src = name.read_text()
        # Matched against the masked source and read out of the real one.
        # `_code_only` blanks a string's *contents* while keeping its length,
        # so the quote after the bracket is still there to find and the
        # offsets still line up -- which is the only way to spot a literal
        # argument without also matching the prose that describes it. Three
        # comments in this repository contain `sc.says('...')` as an example.
        masked = _code_only(src)
        for m in re.finditer(r"\.(?:says|selectedSays)\(\s*['\"]", masked):
            end = src.find(src[m.end() - 1], m.end())
            said = src[m.end():end] if end > 0 else "?"
            problems.append(f"gen2/{name.name}  compares the literal "
                            f'"{said}" against the screen, and a phrase is '
                            f"the title's to say")
    for p in problems:
        print(f"        {p}")
    if problems:
        return fail(f"{len(problems)} screen phrase(s) written into the engine")

    if not cartridge.has_cartridge(ROOT):
        return ok("no screen phrase is written into the engine; no cartridge "
                  "here, so the phrases are not looked up")
    out = subprocess.run([sys.executable, str(HERE / "rom-events"), "--phrases"],
                         capture_output=True, text=True)
    bad = [l for l in out.stdout.splitlines() if "!!" in l or "??" in l]
    # A `note` is a thing this cartridge cannot be *asked* -- one that
    # compresses its text has no plain bytes to look a phrase up in, and the
    # app matches the screen rather than the ROM. Shown, because somebody
    # should know the check did not apply, and not counted, because a check
    # that cannot run has not failed.
    notes = [l for l in out.stdout.splitlines() if l.strip().startswith("note")]
    for l in bad + notes:
        print(f"        {l.strip()}")
    if out.returncode or bad:
        return fail(f"{len(bad) or 1} phrase(s) this cartridge never says")
    found = [l for l in out.stdout.splitlines() if l.strip().startswith('"')]
    return ok(f"all {len(found)} phrase(s) the app looks for are ones this "
              f"cartridge says")



# --- markup that is built in JavaScript --------------------------------------
# Tags with no closing form, so an opening one is not an imbalance.
VOID_TAGS = {"br", "hr", "img", "input", "meta", "link", "source", "track",
             "area", "base", "col", "embed", "param", "wbr", "use", "path",
             "circle", "rect", "line", "polygon", "polyline", "ellipse", "stop"}
TAG = re.compile(r"<(/?)([a-zA-Z][\w-]*)(?:\s[^<>]*?)?(/?)>")


def _string_contents(src):
    """Every string and template-literal body in a JS source, with its line.

    A character scanner rather than a regex, because the thing being looked for
    lives *inside* strings and a regex over the whole file cannot tell a `<div>`
    in a template from one in a comment. `${...}` inside a template drops back
    to code, so an interpolated expression's own quotes are not markup and a
    nested template inside one still is.
    """
    out, i, n, line = [], 0, len(src), 1
    # A stack of what we are inside: "tpl" for a template literal, "code" for a
    # ${...} inside one. Anything else is handled without a stack.
    stack = []
    while i < n:
        c = src[i]
        if c == "\n":
            line += 1
            i += 1
            continue
        if not stack and src.startswith("//", i):
            i = src.find("\n", i)
            if i < 0:
                break
            continue
        if not stack and src.startswith("/*", i):
            end = src.find("*/", i + 2)
            line += src.count("\n", i, end if end > 0 else n)
            i = n if end < 0 else end + 2
            continue
        if c in "'\"":
            j, buf = i + 1, []
            while j < n and src[j] != c:
                if src[j] == "\\":
                    j += 2
                    continue
                if src[j] == "\n":
                    break
                buf.append(src[j])
                j += 1
            out.append((line, "".join(buf)))
            line += src.count("\n", i, j)
            i = j + 1
            continue
        if c == "`":
            if stack and stack[-1] == "tpl":
                stack.pop()
                i += 1
                continue
            stack.append("tpl")
            i += 1
            continue
        if stack and stack[-1] == "tpl":
            if src.startswith("${", i):
                stack.append("code")
                i += 2
                continue
            j = i
            buf = []
            while j < n and src[j] not in "`$" and src[j] != "\n":
                if src[j] == "\\":
                    j += 2
                    continue
                buf.append(src[j])
                j += 1
            if buf:
                out.append((line, "".join(buf)))
            if j == i:
                j += 1
            i = j
            continue
        if stack and stack[-1] == "code":
            if c == "}":
                stack.pop()
            elif c == "{":
                stack.append("code")
            i += 1
            continue
        i += 1
    return out


def _regions(src):
    """The source split at top-level function and method boundaries.

    Markup is built across several statements inside one function -- a header
    string, a loop pushing rows, a join at the end -- so balance is only a
    question that can be asked of a whole function. Split any finer and every
    loop body looks unbalanced; split any coarser and two functions cancel each
    other's mistakes out.
    """
    starts = [(m.start(), m.group(1)) for m in
              re.finditer(r"^(?:async )?function (\w+)", src, re.M)]
    starts += [(m.start(), m.group(1)) for m in
               re.finditer(r"^  (?:async )?(\w+)\s*\(", src, re.M)]
    starts.sort()
    if not starts:
        return [("(top level)", src)]
    out = [("(top level)", src[: starts[0][0]])]
    for k, (at, name) in enumerate(starts):
        end = starts[k + 1][0] if k + 1 < len(starts) else len(src)
        out.append((name, src[at:end]))
    return out


def check_built_markup():
    """Markup built in JavaScript closes every tag it opens.

    `check_markup` reads `index.html`, which is most of the interface and not
    all of it: the party list, the offers and the dex card are template
    literals in `app/*.js`, and nothing looked at those at all.

    What that cost, on the pass this check was written in. `dexCard` built six
    stat rows as `<div class="statrow">…` with no `</div>` on any of them, so
    the browser nested them six deep. Every one of them still *rendered* -- a
    grid row inside a grid row inside a grid row -- which is why it survived
    being looked at on a phone-sized window and being screenshotted. It was
    found by re-reading the function, which is not a method that scales.

    Asked per function rather than per string, because markup is built across
    several statements: a header, a loop pushing rows, a join at the end.
    """
    problems = []
    for path in sorted(APP) + [ROOT / "sw.js"]:
        if not path.exists():
            continue
        src = path.read_text()
        for name, region in _regions(src):
            # Joined, not scanned one fragment at a time, because `${...}`
            # splits a template in the middle of a tag:
            # `<summary data-slot="${slot}">` arrives as two pieces and matches
            # nothing. The joiner is a character an attribute may hold and a
            # tag name may not, so two fragments cannot be glued into a tag
            # that was not written.
            text = "\x01".join(t for _, t in _string_contents(region))
            opened = []
            for m in TAG.finditer(text):
                closing, tag, selfclose = m.group(1), m.group(2).lower(), m.group(3)
                if tag in VOID_TAGS or selfclose:
                    continue
                if closing:
                    if opened and opened[-1] == tag:
                        opened.pop()
                    else:
                        was = f"<{opened[-1]}> open" if opened else "nothing open"
                        problems.append(
                            f"{rel(path)}  {name}() closes <{tag}> with {was}")
                else:
                    opened.append(tag)
            for tag in opened:
                problems.append(
                    f"{rel(path)}  {name}() opens <{tag}> and never closes it")
    for p in problems:
        print(f"        {p}")
    return fail(f"{len(problems)} unbalanced tag(s) built in JavaScript") if problems \
        else ok("every tag built in JavaScript is closed by the function that opens it")



def check_cartridge():
    """Both cartridge finders pick the same pair out of `dev/`.

    The rule for pairing a ROM with a symbol file is written twice -- once in
    `tools/cartridge.mjs` for the node tools and once in `tools/cartridge.py`
    for these checks and `rom-events` -- because the two halves of this
    repository are two languages and neither can call the other cheaply.

    **Two readers of one directory that disagreed about which cartridge is
    current would be worse than either**, and this project has been caught by
    exactly that five separate times: a second reader of the map tables that
    found 1536 maps out of 388, a second charmap in `tools/types`, a second
    decoder for the type names. The rule is small and the failure is silent --
    `check-app` would verify one build while `tools/dex` verified another and
    both would say ok -- so it is held here rather than trusted.

    Skipped with no cartridge, like every other group that needs one: there is
    nothing to disagree about.
    """
    rom, sym, _ = cartridge.find_cartridge(ROOT / "dev")
    if not rom or not sym:
        print("  skip  cartridge pairing (nothing in dev/ to pair)")
        return 0
    if not shutil.which("node"):
        return fail("node not found, cannot compare the two finders")
    script = ("import('./tools/cartridge.mjs').then((m) => {"
              "const c = m.findCartridge('dev');"
              "console.log(JSON.stringify(c && [c.rom, c.sym])); });")
    r = subprocess.run(["node", "--input-type=module", "-e", script],
                       capture_output=True, text=True, cwd=ROOT)
    if r.returncode != 0:
        return fail(f"the node finder would not run: {r.stderr.strip()[:120]}")
    said = json.loads(r.stdout.strip() or "null") or []
    # Resolved, not compared as written. The node side answers a path relative
    # to the repository and `DEV_ROM` answers wherever the cartridge actually
    # is -- which is the whole point of that override and is routinely outside
    # the tree, so anything that assumed otherwise was wrong about the one case
    # somebody sets it for. `ROOT / p` leaves an absolute `p` alone.
    theirs = sorted(str((ROOT / q).resolve()) for q in said)
    mine = sorted(str(pathlib.Path(q).resolve()) for q in (rom, sym))
    if theirs != mine:
        print(f"        python picks {mine}")
        print(f"        node picks   {theirs}")
        return fail("the two cartridge finders disagree")
    return ok(f"both cartridge finders pick {rom.name} with {sym.name}")


