    "phrases": check_phrases,
    "trainers": check_trainers,
}


def main(argv):
    # `--no-cartridge` runs the checks the way CI runs them, on a machine that
    # has one. Every group that reads a cartridge has a second path for when
    # there is none, and that path is invisible to whoever has a `dev/` --
    # which is how a `None` reached `.exists()` and only failed after a push.
    if "--no-cartridge" in argv:
        os.environ["DEV_NO_CARTRIDGE"] = "1"
    wanted = [a for a in argv if not a.startswith("-")] or list(CHECKS)
    unknown = [w for w in wanted if w not in CHECKS]
    if unknown:
        print(f"unknown check(s): {', '.join(unknown)}")
        print(f"available: {', '.join(CHECKS)}")
        return 2
    print("check-app:")
    bad = sum(CHECKS[w]() for w in wanted)
    print(f"\n{'FAILED' if bad else 'all good'} — "
          f"{len(wanted) - bad}/{len(wanted)} check groups passed")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
