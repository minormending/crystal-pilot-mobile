#!/usr/bin/env node
// The cartridge's type chart, and what the pilot will do with it.
//
//     tools/types                     the whole chart, as a grid
//     tools/types --verify            every row against the game's own rules
//     tools/types fire grass          one matchup
//     tools/types --rank cyndaquil caterpie
//                                     which move a pilot would swing, and why
//     tools/types --move 75           one move's numbers and name
//     tools/types --trainer BUGSY     what a trainer is carrying
//     tools/types --outlook BUGSY cyndaquil:9 chikorita:8
//                                     whether that party should walk in
//
// **This runs `gen2/romdata.js`.** The lesson is the one `tools/route` was
// written for and learned the hard way four times: a second reader in another
// language agrees with the first until it does not, and then it is a confident
// wrong answer. So the chart printed here is the chart the pilot ranks with,
// byte for byte, and `--verify` is a check on the app rather than beside it.
//
// What `--verify` is actually for: the chart is 110 rows of three bytes with a
// one-byte separator in the middle of it, and every way of getting that wrong
// produces a chart -- just not this cartridge's. Reading the separator as a
// row eats the row behind it and shifts the rest by two, which is silent, and
// the only thing that catches it is asking the decoded table whether it agrees
// with things about Pokemon that were true before this app existed.
//
// Needs a ROM and a symbol file in `dev/`, which are not in this repository and
// never will be. Without them it says so and exits 0.
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';

import { RomData } from '../gen2/romdata.js';
import { openCartridge } from './cartridge.mjs';
import { gen2 } from '../gen2/engine.js';

const HERE = dirname(fileURLToPath(import.meta.url));
const DEV = join(HERE, '..', 'dev');

// Whatever cartridge is in `dev/`, paired by name -- see tools/cartridge.mjs
// for why the pairing is the careful part and the globbing is not.
const cart = openCartridge(DEV);
if (!cart) process.exit(0);
const { rom, symbols, gb } = cart;
const data = new RomData(symbols, gb, ['JohtoGrassWildMons', 'KantoGrassWildMons']);

// The type numbers, read off the cartridge's own name table rather than
// written down: `TypeNames` is a pointer table in the same order as the type
// constants, so the id *is* the index, and a hack that renumbered its types
// renames them here instead of mislabelling this output.
//
// Two gaps are real: Gen 2 leaves 0x0a-0x13 unused between the physical types
// and the special ones, and 0x06 is the unused BIRD type. Both come back as
// names nothing uses, so they are skipped by asking the chart and the moves
// which numbers actually turn up.
//
// **The decoding is `RomData.typeName`'s, not this file's.** It used to be a
// loop right here with a charmap of its own -- upper case, lower case, and
// everything else dropped -- which is the second-reader problem this tool's
// own header warns about, sitting inside the tool that warns about it. A type
// name with a hyphen or a full stop in it would have come out short here and
// right in the app, and nothing would have said so.
const TYPE_NAMES = (() => {
  const out = new Map();
  if (!symbols.has('TypeNames')) return out;
  for (let id = 0; id <= 0x1b; id++) {
    const name = data.typeName(id);
    if (name) out.set(id, name.toUpperCase());
  }
  return out;
})();
const typeName = (id) => TYPE_NAMES.get(id) || `type ${id}`;
/**
 * A type id from whatever somebody typed, or null.
 *
 * The cartridge's own names first, so `tools/types vuur gras` works on a Dutch
 * build -- and then the engine's constant names, so `tools/types fire grass`
 * works on one too. Before that second line a translated cartridge answered
 * nothing to every English word, which is the state that made `--verify`
 * report thirty correct matchups as wrong.
 */
const typeId = (text) => {
  const want = text.toUpperCase();
  for (const [id, name] of TYPE_NAMES) if (name === want) return id;
  if (gen2.typeIds[want] !== undefined) return gen2.typeIds[want];
  const n = Number(text);
  return Number.isInteger(n) ? n : null;
};

const chart = data.matchups();
if (chart === null) {
  console.log('this cartridge has no readable type chart');
  console.log('(no TypeMatchups in the symbol file, or no $ff where a table ends)');
  process.exit(1);
}

/** Every type that appears anywhere in the chart, in cartridge order. */
const used = () => {
  const seen = new Set();
  for (const key of chart.keys()) { seen.add(key >> 8); seen.add(key & 0xff); }
  return [...seen].sort((a, b) => a - b);
};

const SHOW = { 0: '0', 0.5: '½', 1: '·', 2: '2', 4: '4' };
const cell = (m) => SHOW[m] || String(m);

function grid() {
  const types = used();
  const wide = Math.max(...types.map((t) => typeName(t).length));
  const head = types.map((t) => typeName(t)[0]).join(' ');
  console.log(`${'attacking'.padEnd(wide)}  ${head}   (columns: defending, in the same order)`);
  for (const a of types) {
    const row = types.map((d) => cell(data.matchup(a, d))).join(' ');
    console.log(`${typeName(a).padEnd(wide)}  ${row}`);
  }
  console.log('');
  console.log(`· neutral   ½ half   0 immune   ${chart.size} rows written down, `
              + `the rest of the grid is neutral by omission`);
}

// --- what the chart has to agree with ---------------------------------------
//
// Facts about Pokemon, not about this code: every one of them was true before
// this app existed, and a decode that shifted by a row or ate the separator
// gets them wrong. Deliberately a mix -- immunities, the special-type block,
// the physical block, and the two rows behind the separator, which is the one
// place a shift shows up first.
const RULES = [
  ['ELECTRIC', 'GROUND', 0, 'the one immunity everybody knows'],
  ['NORMAL', 'GHOST', 0, 'behind the separator: a shift eats this row'],
  ['FIGHTING', 'GHOST', 0, 'and this one'],
  ['GHOST', 'NORMAL', 0, 'and it is mutual'],
  ['POISON', 'STEEL', 0, 'steel does not corrode'],
  ['GROUND', 'FLYING', 0, 'nothing on the ground reaches it'],
  ['WATER', 'FIRE', 2, 'the first thing anyone learns'],
  ['FIRE', 'GRASS', 2, 'the second'],
  ['GRASS', 'WATER', 2, 'the third'],
  ['FIRE', 'WATER', 0.5, 'and the way back is halved, not neutral'],
  ['WATER', 'GRASS', 0.5, 'likewise'],
  ['GRASS', 'FIRE', 0.5, 'likewise'],
  ['FIRE', 'STEEL', 2, 'steel melts'],
  ['NORMAL', 'ROCK', 0.5, 'the first row in the table'],
  ['NORMAL', 'STEEL', 0.5, 'the second'],
  ['DARK', 'PSYCHIC', 2, 'the generation this cartridge added'],
  ['PSYCHIC', 'DARK', 0, 'and the immunity that came with it'],
  ['BUG', 'DARK', 2, 'which bugs got to exploit'],
  ['DRAGON', 'DRAGON', 2, 'a type that is only strong against itself'],
  ['ICE', 'DRAGON', 2, 'and the one that answers it'],
  ['NORMAL', 'NORMAL', 1, 'neutral by omission, not by a row'],
  ['WATER', 'ELECTRIC', 1, 'the chart is not symmetric and this proves it'],
];

// What the trainer table has to agree with: eight gym leaders and what they
// carry. Facts about the game that were true before this app existed, and a
// decode that lost a class boundary or picked the wrong stride gets them
// wrong -- the first draft read Falkner's class as containing every leader in
// Johto, which is exactly the shape of error that produces a plausible table.
const LEADERS = [
  ['FALKNER', 1, [[7, 'PIDGEY'], [9, 'PIDGEOTTO']]],
  ['BUGSY', 3, [[14, 'METAPOD'], [14, 'KAKUNA'], [16, 'SCYTHER']]],
  ['WHITNEY', 2, [[18, 'CLEFAIRY'], [20, 'MILTANK']]],
  ['MORTY', 4, [[21, 'GASTLY'], [21, 'HAUNTER'], [25, 'GENGAR'], [23, 'HAUNTER']]],
  ['PRYCE', 5, [[27, 'SEEL'], [29, 'DEWGONG'], [31, 'PILOSWINE']]],
  ['JASMINE', 6, [[30, 'MAGNEMITE'], [30, 'MAGNEMITE'], [35, 'STEELIX']]],
  ['CHUCK', 7, [[27, 'PRIMEAPE'], [30, 'POLIWRATH']]],
  // Three DRAGONAIR, not two DRATINI and one. Written down wrongly the first
  // time and corrected by the decode, which is the direction this check is
  // supposed to be able to fail in: the rules are independent facts, so one
  // of them being misremembered is a thing the run tells you.
  ['CLAIR', 8, [[37, 'DRAGONAIR'], [37, 'DRAGONAIR'], [37, 'DRAGONAIR'],
                [40, 'KINGDRA']]],
];

function verifyTrainers() {
  let bad = 0;
  const index = data.trainerIndex();
  if (!index) {
    console.log('  WRONG  no readable trainer table');
    return 1;
  }
  for (const [name, group, party] of LEADERS) {
    const got = data.trainer(name);
    if (!got) {
      bad++;
      console.log(`  WRONG  ${name} is not in the trainer table`);
      continue;
    }
    if (got.group !== group) {
      bad++;
      console.log(`  WRONG  ${name} reads as class ${got.group}, not ${group}`
                  + ' — a class boundary is being lost');
    }
    const mine = got.party.map((m) => [m.level, data.speciesName(m.species)]);
    if (JSON.stringify(mine) !== JSON.stringify(party)) {
      bad++;
      console.log(`  WRONG  ${name} reads ${JSON.stringify(mine)}, `
                  + `should be ${JSON.stringify(party)}`);
    }
  }
  // Every leader shares one class name, which is a second reading of the same
  // rows through a different table.
  //
  // **They agree with each other rather than with the word LEADER**, and that
  // is the same repair the rules above needed: a class name is text the
  // cartridge owns, so a Dutch build reads LEIDER and asserting the English
  // word reported all eight as wrong about a table that was entirely right.
  // What the check is actually for survives the change -- a decode that has
  // lost the class boundaries gives eight *different* answers, which is what
  // pokecrystal16's three-byte pointer table did before it could be read:
  // "null", "ser? ATTACK.", "RIVAL".
  //
  // It still has to be *a* name. Eight empty strings agree with each other and
  // are what a cartridge with no class-name table gives.
  const classes = LEADERS.map(([name]) => {
    const got = data.trainer(name);
    return got ? data.trainerClass(got.group) : null;
  });
  const same = classes.every((c) => c && c === classes[0]);
  if (!same) {
    bad++;
    LEADERS.forEach(([name], i) => {
      console.log(`  WRONG  ${name}'s class reads ${JSON.stringify(classes[i])}`);
    });
    console.log('         eight leaders should share one class name, whatever '
                + 'this cartridge calls it');
  }
  console.log(`${LEADERS.length} leader(s) over ${index.size} trainer(s): `
              + (bad ? `${bad} disagreement(s)`
                     : 'the table agrees about every one'));
  return bad;
}

function verify() {
  let bad = 0;
  for (const [a, d, want, why] of RULES) {
    // **By id, not by name.** These rules are claims about Pokemon -- Electric
    // cannot touch Ground -- and Pokemon does not change language. The names
    // in the table do: a Dutch build calls them ELEKTRO and GROND, so looking
    // them up through the cartridge resolved all twenty-two to nothing and
    // printed a page of WRONG about a chart that was entirely correct. A
    // checker that fails on a cartridge it does not understand is worse than
    // no checker, because somebody has to read the output.
    const from = gen2.typeIds[a], to = gen2.typeIds[d];
    const got = from === undefined || to === undefined
      ? null : data.matchup(from, to);
    if (got !== want) {
      bad++;
      console.log(`  WRONG  ${a} on ${d}: reads ${got}, should be ${want} — ${why}`);
    }
  }
  // The shape as well as the contents: a table read wrongly is usually the
  // right size divided or multiplied by something.
  const rows = chart.size;
  if (rows !== 110) {
    bad++;
    console.log(`  WRONG  ${rows} rows, and this cartridge's table has 110`);
  }
  // Three values and no more: nothing, a half and a double. Which *bytes*
  // those are is the cartridge's business -- Crystal writes tenths, 05 and
  // 20, and Polished Crystal writes Q4 fixed point, $08 and $20 -- so the
  // scale comes from the reader, which measures it, rather than from a set
  // written here. Asserted as tenths, that cartridge's correct chart drew
  // two WRONG lines about multipliers of "8" and "32".
  //
  // It still catches the failure this is for: a decode shifted by a byte
  // reads type ids as multipliers, and there are nineteen of those.
  const unit = data.chartUnit();
  const expected = new Set([0, unit / 2, unit * 2]);
  for (const m of new Set(chart.values())) {
    if (!expected.has(m)) {
      bad++;
      console.log(`  WRONG  a multiplier of ${m}, and this chart's own scale`
                  + ` has only 0, ${unit / 2} and ${unit * 2}`);
    }
  }
  console.log(`${RULES.length} rules over ${rows} rows: `
              + (bad ? `${bad} disagreement(s)` : 'the chart agrees with all of them'));
  return bad;
}

// --- what a pilot would swing -----------------------------------------------
//
// The interesting output, and the one that shows the feature earning its keep:
// it prints what ranking by raw power would have picked beside what the chart
// picks, so a matchup where they differ is visible rather than argued about.
const species = (text) => {
  const want = text.toUpperCase();
  for (let id = 1; id <= gen2.speciesCount; id++) {
    if (data.speciesName(id).toUpperCase() === want) return id;
  }
  const n = Number(text);
  return Number.isInteger(n) ? n : null;
};

/**
 * A species' own types, asked of the app's reader.
 *
 * This was a second BaseData reader living here, with the stride and the
 * field offset written out again -- and it went in miscounting the stats,
 * reading CHIKORITA as "type 65/GRASS", which is its special defence
 * followed by half its real answer. A plausible type number, so it printed
 * rather than failed.
 *
 * That is the fifth time copying this app's ROM reading into a second place
 * produced a confident wrong answer, so the reader moved *into* the app --
 * where the pilot needs it anyway, because a decision about which Pokemon to
 * send out cannot come from a party entry: Gen 2 does not keep a Pokemon's
 * types there.
 */
function base(id) {
  const types = data.speciesTypes(id);
  return types ? { types } : null;
}

function rank(mineText, themText, moveIds) {
  const mine = species(mineText), them = species(themText);
  const a = mine === null ? null : base(mine), b = them === null ? null : base(them);
  if (!a || !b) {
    console.log('need two species this cartridge knows, and a BaseData symbol');
    return 1;
  }
  console.log(`${data.speciesName(mine)} (${a.types.map(typeName).join('/')})`
              + ` against ${data.speciesName(them)} (${b.types.map(typeName).join('/')})`);
  const rows = moveIds.map((id) => {
    const m = data.move(id);
    return {
      id, name: data.moveName(id) || `move ${id}`,
      power: m ? m.power : 0,
      type: m ? typeName(m.type) : '?',
      eff: data.effectiveness(id, b.types),
      hit: data.hitPower(id, b.types, a.types),
    };
  });
  const wide = Math.max(...rows.map((r) => r.name.length));
  for (const r of rows) {
    console.log(`  ${r.name.padEnd(wide)}  ${String(r.power).padStart(3)} `
                + `${r.type.padEnd(8)} x${r.eff === null ? '?' : r.eff}`
                + `${r.hit !== r.power * (r.eff ?? 1) ? ' +bonus' : ''}`
                + `  -> ${r.hit}`);
  }
  const byPower = rows.reduce((x, y) => (y.power > x.power ? y : x));
  const byHit = rows.reduce((x, y) => (y.hit > x.hit ? y : x));
  console.log(`  power alone would swing ${byPower.name}; the chart swings ${byHit.name}`
              + (byPower.name === byHit.name ? ' — the same' : ' — and they differ'));
  return 0;
}

/** One trainer's party, named and levelled. */
function trainer(name) {
  const found = data.trainer(name);
  if (!found) {
    const index = data.trainerIndex();
    console.log(index
      ? `no trainer called "${name}" — ${index.size} names in this cartridge`
      : 'this cartridge has no readable trainer table');
    return 1;
  }
  const cls = data.trainerClass(found.group);
  console.log(`${found.name}${cls ? ` (${cls}, class ${found.group})` : ''}`);
  for (const mon of found.party) {
    const types = data.speciesTypes(mon.species);
    console.log(`  Lv${String(mon.level).padStart(2)}  `
                + `${data.speciesName(mon.species).padEnd(12)}`
                + (types ? types.map(typeName).join('/') : ''));
  }
  return 0;
}

/**
 * Whether a described party should walk into that trainer.
 *
 * The party is given as `species:level` pairs, and every Pokemon is assumed
 * to be carrying one neutral 40-power move -- which is deliberately generous:
 * the point of this output is the *level* gap and the Pokemon nothing can
 * touch, and inventing a moveset would make the second half a fiction.
 */
function outlook(name, described) {
  const found = data.trainer(name);
  if (!found) { console.log(`no trainer called "${name}"`); return 1; }
  const mine = [];
  for (const text of described) {
    const [who, lv] = text.split(':');
    const id = species(who);
    if (id === null) { console.log(`no species called "${who}"`); return 1; }
    // 33 is TACKLE on this cartridge: normal, 35 power, and something every
    // starter has. Stated rather than hidden, because it is an assumption.
    mine.push({ species: id, level: Number(lv) || 5, hp: 1,
                moves: [33, 0, 0, 0], pp: [35, 0, 0, 0] });
  }
  const view = data.outlook(mine, found.party);
  if (!view) { console.log('cannot price this matchup'); return 1; }
  console.log(`${found.name}: ${found.party.length} Pokémon, `
              + `topping out at Lv${view.top}`);
  console.log(`your party tops out at Lv${view.best}`
              + (view.best < view.top
                 ? ` — ${view.top - view.best} short` : ' — ahead'));
  if (view.helpless.length) {
    for (const m of view.helpless) {
      console.log(`  nothing you carry can touch `
                  + `${data.speciesName(m.species)} Lv${m.level}`);
    }
  } else {
    console.log('  and everything in there can be hurt by something you have');
  }
  return 0;
}

const args = process.argv.slice(2);
if (args[0] === '--verify') {
  process.exit(verify() + verifyTrainers() ? 1 : 0);
} else if (args[0] === '--move') {
  const id = Number(args[1]);
  const m = data.move(id);
  if (!m) { console.log(`no move ${args[1]}`); process.exit(1); }
  console.log(`${data.moveName(id) || `move ${id}`}: power ${m.power}, `
              + `${typeName(m.type)}, ${m.pp} PP, effect ${m.effect}`);
} else if (args[0] === '--trainer') {
  process.exit(trainer(args.slice(1).join(' ')));
} else if (args[0] === '--outlook') {
  process.exit(outlook(args[1], args.slice(2)));
} else if (args[0] === '--rank') {
  process.exit(rank(args[1], args[2],
                    args.slice(3).map(Number).filter(Number.isInteger)));
} else if (args.length === 2) {
  const from = typeId(args[0]), to = typeId(args[1]);
  const m = from === null || to === null ? null : data.matchup(from, to);
  if (m === null) { console.log('no such pair'); process.exit(1); }
  console.log(`${typeName(from)} on ${typeName(to)}: x${m}`);
} else {
  grid();
}
