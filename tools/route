#!/usr/bin/env node
// Where the pilot can get to, asked of the app's own map graph.
//
//     tools/route 10.5 8.7          the way from Violet City to Azalea Town
//     tools/route --exits 10.1      every way out of Route 32
//     tools/route --reach           every map a title declares, from the start
//     tools/route --maps            every map the cartridge has, by name
//     tools/route --objects         what stands on every one of them
//     tools/route --warps           every door, and where it leads
//     tools/route --triggers        every tile that runs a script
//     tools/route --json 10.5 8.7   the same, for a script to read
//
// **This runs `gen2/world.js`, and that is the whole point of it.** The first
// version of this was a second reader written in Python beside
// `tools/rom-events`, and it diverged the moment it met a group whose size the
// obvious arithmetic cannot derive: Cherrygrove City came back as "not a map
// this cartridge has". That is the fourth time copying this app's ROM reading
// into another language produced a confident wrong answer -- three constants
// and now a whole traversal -- so this asks the app instead.
//
// Which makes the check underneath it worth much more. `--reach` is not asking
// whether *a* graph reaches a declared place; it is asking whether **the graph
// the pilot will actually plan over** does. A gym in a town no route reaches is
// a row that can never be pressed, and until now the only way to find one out
// was to press it and watch a walk fail.
//
// Needs a ROM and a symbol file in `dev/`, which are not in this repository and
// never will be. Without them it says so and exits 0.
import { readFileSync, writeSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';

import { World, mapKey } from '../gen2/world.js';
import { engineOf, openCartridge } from './cartridge.mjs';

const HERE = dirname(fileURLToPath(import.meta.url));

/**
 * Say something, and be sure it was said.
 *
 * **`console.log` into a pipe is asynchronous, and `process.exit` does not
 * wait for it.** Every mode here ends in `process.exit(0)`, which was
 * harmless while the biggest answer was a few hundred lines -- and then
 * `--objects` produced a megabyte of JSON for Polished Crystal's 488 maps
 * and the reader on the other end got exactly 65536 bytes of it. Not an
 * error, not a truncation anybody announced: valid JSON's opening brace and
 * then a cut, which `json.loads` refuses and `tools/rom-events` was written
 * to treat as "no maps". Every gym in the game came back unfound, twice, for
 * two different reasons, and this was the second.
 *
 * `writeSync` on the file descriptor blocks until the bytes are gone.
 */
function say(text) {
  writeSync(1, `${text}\n`);
}
const DEV = join(HERE, '..', 'dev');

// Whatever cartridge is in `dev/`, paired by name -- see tools/cartridge.mjs
// for why the pairing is the careful part and the globbing is not.
const cart = openCartridge(DEV);
if (!cart) process.exit(0);
const { rom, symbols, gb } = cart;
// The profile the app would pick for this cartridge, so a tool and the app
// read its map headers the same way rather than two ways.
const { title, engine } = engineOf(cart);
const world = new World(symbols, gb, engine);

/** Every map's own symbol name, via the attributes pointer it is filed under. */
function names() {
  const attrs = new Map();
  for (const [name, at] of symbols.map) {
    if (name.endsWith('_MapAttributes')) {
      attrs.set(`${at.bank}:${at.addr}`, name.slice(0, -'_MapAttributes'.length));
    }
  }
  const out = new Map();
  for (let group = 1; group <= 26; group++) {
    for (let number = 1; number <= 64; number++) {
      if (!world.hasMap(group, number)) continue;
      try {
        const a = world._attributes(group, number);
        const found = attrs.get(`${a.bank}:${a.addr}`);
        if (found) out.set(mapKey(group, number), found);
      } catch (e) { /* not a map: the honest answer is nothing */ }
    }
  }
  return out;
}

const NAME = names();
const label = (key) => NAME.get(key) || `${key >> 8}.${key & 0xff}`;

const parse = (text) => {
  if (/^\d+\.\d+$/.test(text)) {
    const [g, n] = text.split('.').map(Number);
    return mapKey(g, n);
  }
  for (const [key, name] of NAME) if (name === text) return key;
  return null;
};

/** The shortest way between two maps, as the app's own graph has it. */
function way(from, to) {
  const legs = world.route(from, to);
  if (legs === null) return null;
  const out = [];
  let at = from;
  for (const leg of legs) {
    out.push({ how: leg.kind === 'edge' ? leg.dir.toLowerCase()
                                        : `warp at (${leg.tile.join(',')})`,
               to: leg.key });
    at = leg.key;
  }
  void at;
  return out;
}

const argv = process.argv.slice(2);
const json = argv.includes('--json');
const plain = argv.filter((a) => !a.startsWith('--'));

// Every map this cartridge has, with the name its symbol file gives it.
//
// Here rather than in the Python tool that wanted it, and that is the rule
// this file exists for: which (group, number) pairs are maps is `World`'s
// answer, deliberately permissive where a group's size cannot be derived, and
// a second reader of it produced 1536 "maps" out of 388 by asking about rows
// that are not there and getting names back.
if (argv.includes('--maps')) {
  const out = {};
  for (const [key, name] of NAME) out[`${key >> 8}.${key & 0xff}`] = name;
  if (json) say(JSON.stringify(out));
  else for (const [k, v] of Object.entries(out)) say(`${k}  ${v}`);
  process.exit(0);
}

if (argv.includes('--triggers')) {
  // The tiles that run a script when stepped on, per named map. The third of
  // the event block's four lists, and the one whose *width* is the thing
  // cartridges disagree about -- so this is what `check-app romlayout` uses
  // to tell a right stride from a wrong one: a map with triggers on it is a
  // map the object reader has to step over something to reach.
  const out = {};
  for (const [key, name] of NAME) {
    out[name] = world.coordEventsOn(key >> 8, key & 0xff);
  }
  if (json) say(JSON.stringify(out));
  else for (const [name, list] of Object.entries(out)) {
    if (!list.length) continue;
    say(`${name}:`);
    for (const c of list) say(`  (${c.x},${c.y})  scene ${c.scene}`);
  }
  process.exit(0);
}

if (argv.includes('--warps')) {
  // Every named map's doors, out of the app's own reader, for the same
  // reason `--objects` is here: `tools/rom-events` used to walk the event
  // block itself, keyed off a `<Map>_MapEvents` symbol. Polished Crystal has
  // none -- its warps live inside the map script header -- so every door in
  // the game came back missing and every gym came back without one.
  const out = {};
  for (const [key, name] of NAME) {
    out[name] = world.warps(key >> 8, key & 0xff)
      .map((w) => ({ x: w.x, y: w.y, to: w.key }));
  }
  if (json) say(JSON.stringify(out));
  else for (const [name, warps] of Object.entries(out)) {
    if (!warps.length) continue;
    say(`${name}:`);
    for (const w of warps) say(`  (${w.x},${w.y})  → ${label(w.to)}`);
  }
  process.exit(0);
}

if (argv.includes('--objects')) {
  // Every named map's object list, out of the app's own reader.
  //
  // **Here so that `tools/rom-events` can stop having a second one.** Finding
  // where a gym leader stands means walking a map's event block, and the tool
  // walked it in Python with Crystal's strides written out by hand. That is
  // the fifth time a second reader of this cartridge's tables gave a
  // confident wrong answer: on Polished Crystal, whose coord event is five
  // bytes where Crystal's is eight, it found no leader on any of the eight
  // Gym maps and said so as "no script object named for them", which reads
  // like a fact about the hack.
  //
  // The script pointer is here because a symbol file turns it into a name,
  // and a name is what a gym declaration is checked against. `bank:addr` in
  // hex, which is how a `.sym` file writes it.
  const out = {};
  for (const [key, name] of NAME) {
    out[name] = world.objectsOn(key >> 8, key & 0xff).map((o) => ({
      map: `${key >> 8}.${key & 0xff}`,
      sprite: o.sprite, x: o.x, y: o.y, type: o.type,
      script: `${o.script.bank.toString(16)}:${o.script.addr.toString(16)}`,
    }));
  }
  if (json) say(JSON.stringify(out));
  else for (const [name, objects] of Object.entries(out)) {
    if (!objects.length) continue;
    say(`${name}:`);
    for (const o of objects) {
      say(`  (${o.x},${o.y})  type ${o.type}  sprite ${o.sprite}  `
                  + `${o.script}`);
    }
  }
  process.exit(0);
}

if (argv.includes('--exits')) {
  const key = parse(plain[0] || '');
  if (key === null) { say('give a map as group.number'); process.exit(2); }
  say(`${label(key)} exits:`);
  for (const e of world.exits(key)) {
    const how = e.kind === 'edge' ? e.dir.toLowerCase()
                                  : `warp at (${e.tile.join(',')})`;
    say(`  ${how.padEnd(24)} → ${label(e.key)}`);
  }
  process.exit(0);
}

if (argv.includes('--reach')) {
  // Every `key(group, number)` a title declares, and whether the graph the
  // pilot plans over has any route to it from where a game begins.
  const titles = join(HERE, '..', 'titles');
  const { readdirSync } = await import('node:fs');
  let problems = 0;
  // **The profile this cartridge would be driven by, not every profile.**
  // Asking one cartridge whether another hack's maps are reachable resolves
  // Crystal's VIOLET_POKECENTER to Polished Crystal's Route 32 gate and then
  // reports on the walk to it, which is a sentence about nothing.
  const mine = title ? `${title.id}.js` : null;
  const files = readdirSync(titles).filter((f) => f.endsWith('.js')).sort()
    .filter((f) => !mine || f === mine);
  for (const file of files) {
    const src = readFileSync(join(titles, file), 'utf8');
    const declared = [...src.matchAll(/^const (\w+) = key\((\d+),\s*(\d+)\);/gm)]
      .map((m) => [m[1], mapKey(Number(m[2]), Number(m[3]))]);
    // And the places written straight into a table rather than named. A
    // profile whose healers are generated from the cartridge has no
    // `const` for any of them, so the whole check quietly applied to
    // nothing -- twenty-one Centers and not one of them asked about.
    for (const m of src.matchAll(/(map|inside):\s*key\((\d+),\s*(\d+)\)/g)) {
      declared.push([`${m[1]} ${m[2]}.${m[3]}`,
                     mapKey(Number(m[2]), Number(m[3]))]);
    }
    if (!declared.length) continue;
    const start = declared.find(([n]) => n === 'PLAYERS_HOUSE_2F')
      || declared.find(([n]) => n === 'NEW_BARK_TOWN');
    // Where a game begins, for a profile that names it; otherwise the
    // lowest-numbered map declared, which is somewhere in the same world
    // and is what "can the pilot get there from here" wants.
    const from_ = start || [...declared].sort((a, b) => a[1] - b[1])[0];
    if (!from_) { say(`${file}: no starting map to measure from`); continue; }
    say(`${file}: ${declared.length} declared map(s), from ${label(from_[1])}`);
    for (const [name, key] of declared) {
      if (key === from_[1]) continue;
      const legs = way(from_[1], key);
      if (legs === null) {
        say(`  !! ${name} (${label(key)}) is in no route from the start`);
        problems += 1;
      } else if (!json) {
        say(`  ${String(legs.length).padStart(2)} leg(s)  ${name} — ${label(key)}`);
      }
    }
  }
  process.exit(problems ? 1 : 0);
}

const [a, b] = plain;
if (!a || !b) {
  say(readFileSync(fileURLToPath(import.meta.url), 'utf8')
    .split('\n').filter((l) => l.startsWith('//')).map((l) => l.slice(3)).join('\n'));
  process.exit(2);
}
const from = parse(a), to = parse(b);
if (from === null || to === null) {
  say('give maps as group.number, e.g. tools/route 10.5 8.7');
  process.exit(2);
}
const legs = way(from, to);
if (json) {
  say(JSON.stringify(
    { from: label(from), to: label(to),
      legs: legs && legs.map((l) => ({ ...l, to: label(l.to) })) }, null, 1));
} else if (legs === null) {
  say(`${label(from)} → ${label(to)}: no route in the app's own graph`);
  process.exit(1);
} else {
  say(`${label(from)} → ${label(to)}: ${legs.length} leg(s)`);
  for (const leg of legs) say(`  ${leg.how.padEnd(24)} → ${label(leg.to)}`);
}
