#!/bin/sh
# Behaviour tests. No ROM and no browser: see tests/harness.mjs for why.
#   ./run-tests            run everything
#   ./run-tests -k catch   only tests whose name matches
#   ./run-tests -v         show notes and stack lines
#
# The suite runs under a watchdog in a second process, and that is not belt and
# braces. harness.mjs times out a single test that never settles, but it does
# that with setTimeout -- and a loop that only ever awaits already-resolved
# promises starves the timer queue outright. Measured: a 1s microtask loop kept
# a 50ms timer from firing until the loop ended. That is the exact shape of a
# runaway `while (...) await this.snap()`, which is how this suite hung for
# real, so an in-process timer cannot be the only net. A separate process
# cannot be starved by the one it is watching.
here=$(cd "$(dirname "$0")" && pwd)
limit=${TEST_LIMIT_SECONDS:-120}
inflight=$(mktemp "${TMPDIR:-/tmp}/crystal-pilot-tests.XXXXXX") || exit 1
trap 'rm -f "$inflight" "$inflight.done"' EXIT

done="$inflight.done"

TEST_INFLIGHT="$inflight" node "$here/tests/index.mjs" "$@" &
node_pid=$!

# Three details here, each of them a bug that was actually hit.
#
# The subshell's output goes to /dev/null because killing it does not reliably
# kill the `sleep` inside it -- measured on one shell: the sleep was orphaned to
# init and kept the write end of the pipe open, so `./run-tests | tail` sat
# there for the full limit with the suite long since finished.
#
# The marker file is why the orphan is harmless. A stray `kill -9` firing two
# minutes late against a recorded pid can hit whatever process has since been
# given that number; a sleep that checks whether the run already finished
# cannot.
#
# And the kill is best effort in both directions: the subshell if it is still
# there, and anything it spawned, so repeated runs do not leave sleeps behind.
( sleep "$limit"
  [ -f "$done" ] || kill -9 "$node_pid" 2>/dev/null
) >/dev/null 2>&1 &
dog_pid=$!

wait "$node_pid"
rc=$?
: > "$done"
{ pkill -P "$dog_pid"; kill "$dog_pid"; wait "$dog_pid"; } 2>/dev/null

# Killed rather than returned: over 128 is a signal, and the watchdog is the
# only thing here that sends one.
if [ "$rc" -gt 128 ]; then
  echo
  echo "the suite hung and was killed after ${limit}s."
  if [ -s "$inflight" ]; then
    echo "in flight when it stopped: $(cat "$inflight")"
  fi
  echo "a test that cannot finish cannot fail -- it reports nothing at all."
  rc=1
fi
exit "$rc"
